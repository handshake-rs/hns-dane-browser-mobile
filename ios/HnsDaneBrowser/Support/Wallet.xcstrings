          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hébergement d'échange P2P n'est pas disponible jusqu'à ce que ce contrôleur HNS direct appartenant au portefeuille soit installé et déverrouillé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אירוח ההחלפה של P2P אינו זמין עד אשר בקר ישיר HNS זה בבעלות הארנק יותקן ויפתח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P स्वैप होस्टिंग तब तक उपलब्ध नहीं है जब तक कि यह वॉलेट-स्वामित्व वाला प्रत्यक्ष HNS नियंत्रक स्थापित और अनलॉक न हो जाए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosting swap P2P tidak tersedia hingga pengontrol HNS langsung milik dompet ini diinstal dan dibuka kuncinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hosting di scambio P2P non è disponibile finché questo controller HNS diretto di proprietà del portafoglio non viene installato e sbloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このウォレット所有の直接 HNS コントローラーがインストールされ、ロックが解除されるまで、P2P スワップ ホスティングは利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑 소유의 직접 HNS 컨트롤러가 설치되고 잠금 해제될 때까지 P2P 스왑 호스팅을 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P swap-hosting is niet beschikbaar totdat deze directe HNS-controller, eigendom van de portemonnee, is geïnstalleerd en ontgrendeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosting wymiany P2P jest niedostępny do czasu zainstalowania i odblokowania należącego do portfela bezpośredniego kontrolera HNS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A hospedagem swap P2P não estará disponível até que este controlador HNS direto de propriedade da carteira seja instalado e desbloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хостинг подкачки P2P недоступен до тех пор, пока этот прямой контроллер HNS, принадлежащий кошельку, не будет установлен и разблокирован."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P takas barındırma, cüzdanın sahip olduğu bu doğrudan HNS denetleyici kurulup kilidi açılana kadar kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap-хостинг P2P недоступний, доки не буде встановлено та розблоковано цей прямий контролер HNS, що належить гаманцю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu trữ trao đổi P2P không khả dụng cho đến khi bộ điều khiển HNS trực tiếp thuộc sở hữu của ví này được cài đặt và mở khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在安装并解锁此钱包拥有的直接 HNS 控制器之前，P2P 交换托管不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在安裝並解鎖此錢包擁有的直接 HNS 控制器之前，P2P 交換託管不可用。"
          }
        }
      }
    },
