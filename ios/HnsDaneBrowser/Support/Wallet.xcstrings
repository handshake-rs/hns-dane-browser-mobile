    "wallet_name_actions_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم باستيراد الأسماء المتعقبة أو قم بإعداد معاملة اسم أصلية دقيقة من حالة المحفظة المتزامنة الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie verfolgte Namen oder bereiten Sie eine genaue native Namenstransaktion aus dem aktuellen synchronisierten Wallet-Status vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import tracked names or prepare an exact native name transaction from current synchronized wallet state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe nombres rastreados o prepare una transacción de nombre nativo exacto desde el estado actual de billetera sincronizada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام‌های ردیابی‌شده را وارد کنید یا یک تراکنش نام اصلی دقیق از وضعیت کیف پول همگام‌سازی شده فعلی تهیه کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez des noms suivis ou préparez une transaction de nom natif exacte à partir de l'état actuel du portefeuille synchronisé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייבא שמות במעקב או הכן עסקת שם מקורי מדויק ממצב הארנק המסונכרן הנוכחי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैक किए गए नामों को आयात करें या वर्तमान सिंक्रनाइज़ वॉलेट स्थिति से सटीक मूल नाम लेनदेन तैयार करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor nama yang dilacak atau siapkan nama transaksi asli yang tepat dari status dompet tersinkronisasi saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa nomi tracciati o prepara una transazione con nome nativo esatto dallo stato corrente del portafoglio sincronizzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡された名前をインポートするか、現在の同期されたウォレットの状態から正確なネイティブ名のトランザクションを準備します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추적된 이름을 가져오거나 현재 동기화된 지갑 상태에서 정확한 기본 이름 트랜잭션을 준비하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeer bijgehouden namen of bereid een exacte native naamtransactie voor vanuit de huidige gesynchroniseerde portemonneestatus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuj śledzone nazwy lub przygotuj dokładną transakcję nazw natywnych na podstawie bieżącego zsynchronizowanego stanu portfela."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe nomes rastreados ou prepare uma transação de nome nativo exato do estado atual da carteira sincronizada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте отслеживаемые имена или подготовьте точную транзакцию с собственным именем из текущего синхронизированного состояния кошелька."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzlenen adları içe aktarın veya geçerli senkronize cüzdan durumundan tam bir yerel ad işlemi hazırlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортуйте відстежувані імена або підготуйте транзакцію з власними іменами з поточного синхронізованого стану гаманця."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập tên được theo dõi hoặc chuẩn bị giao dịch tên gốc chính xác từ trạng thái ví được đồng bộ hóa hiện tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入跟踪名称或从当前同步钱包状态准备准确的本机名称交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入追蹤名稱或從目前同步錢包狀態準備準確的本機名稱交易。"
          }
        }
      }
    },
