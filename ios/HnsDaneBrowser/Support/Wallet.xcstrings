    "wallet_swap_cancel_direct_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد سحب %1$@؟ \n\n معرف العرض: %2$@. يؤدي الإلغاء إلى تحرير الحجز المحلي ولكن لا يمكن إلغاء جلسة تم قبولها بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abheben %1$@?\n\nAngebots-ID: %2$@. Durch die Stornierung wird die lokale Reservierung freigegeben, eine bereits akzeptierte Sitzung kann jedoch nicht storniert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdraw %1$@?\n\nOffer ID: %2$@. Cancellation releases the local reservation but cannot cancel an already accepted session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirar %1$@?\n\nOID de oferta: %2$@. La cancelación libera la reserva local pero no puede cancelar una sesión ya aceptada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برداشت %1$@?\n\n شناسه پیشنهاد: %2$@. لغو رزرو محلی را آزاد می کند اما نمی تواند یک جلسه از قبل پذیرفته شده را لغو کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer %1$@?\n\nID de l'offre : %2$@. L'annulation libère la réservation locale mais ne peut pas annuler une séance déjà acceptée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למשוך את %1$@?\n\n מזהה הצעה: %2$@. ביטול משחרר את ההזמנה המקומית אך לא יכול לבטל הפעלה שכבר התקבלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ वापस लें?\n\nऑफर आईडी: %2$@। रद्द करने से स्थानीय आरक्षण जारी हो जाता है लेकिन पहले से स्वीकृत सत्र रद्द नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penarikan %1$@?\n\nID Penawaran: %2$@. Pembatalan melepaskan reservasi lokal tetapi tidak dapat membatalkan sesi yang sudah diterima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritirare %1$@?\n\nOID offerta: %2$@. La cancellazione rilascia la prenotazione locale ma non può cancellare una sessione già accettata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を引き出しますか?\n\nオファー ID: %2$@ 。キャンセルするとローカル予約は解除されますが、すでに受け付けたセッションをキャンセルすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 출금?\n\n제안 ID: %2$@. 취소하면 로컬 예약이 해제되지만 이미 수락된 세션은 취소할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ intrekken?\n\nBiedings-ID: %2$@. Bij annulering wordt de lokale reservering vrijgegeven, maar een reeds geaccepteerde sessie kan niet worden geannuleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycofaj %1$@?\n\nIdentyfikator oferty: %2$@. Anulowanie zwalnia lokalną rezerwację, ale nie może anulować już zaakceptowanej sesji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirar %1$@?\n\nID da oferta: %2$@. O cancelamento libera a reserva local, mas não pode cancelar uma sessão já aceita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вывести %1$@?\n\nИдентификатор предложения: %2$@. Отмена освобождает локальное резервирование, но не может отменить уже принятый сеанс."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'yi geri çekin?\n\nTeklif Kimliği: %2$@. İptal yerel rezervasyonu iptal eder ancak önceden kabul edilmiş bir oturumu iptal edemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зняти %1$@?\n\nІдентифікатор пропозиції: %2$@. Скасування скасовує локальне бронювання, але не може скасувати вже прийнятий сеанс."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rút %1$@?\n\nID ưu đãi: %2$@. Việc hủy sẽ giải phóng phần đặt chỗ cục bộ nhưng không thể hủy phiên đã được chấp nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提现%1$@？\n\n优惠ID：%2$@。取消会释放本地预订，但无法取消已接受的会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提現%1$@？ \n\n優惠ID：%2$@。取消會釋放本地預訂，但無法取消已接受的會話。"
          }
        }
      }
    },
    "wallet_swap_cancel_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ولم يتم إلغاء العرض. ربما تكون قد انتهت صلاحيتها أو دخلت في جلسة مبادلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Angebot wurde nicht storniert. Möglicherweise ist es abgelaufen oder es befindet sich in einer Swap-Sitzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The offer was not cancelled. It may have expired or entered a swap session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La oferta no fue cancelada. Es posible que haya expirado o haya entrado en una sesión de intercambio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشنهاد لغو نشد. ممکن است منقضی شده باشد یا وارد جلسه مبادله شده باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'offre n'a pas été annulée. Il a peut-être expiré ou est entré dans une session d'échange."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההצעה לא בוטלה. ייתכן שהוא פג או נכנס לסשן החלפה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रस्ताव रद्द नहीं किया गया. हो सकता है कि यह समाप्त हो गया हो या स्वैप सत्र में प्रवेश कर गया हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tawaran itu tidak dibatalkan. Ini mungkin telah kedaluwarsa atau memasuki sesi swap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'offerta non è stata annullata. Potrebbe essere scaduto o essere entrato in una sessione di scambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オファーはキャンセルされませんでした。有効期限が切れたか、スワップ セッションに入った可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안이 취소되지 않았습니다. 만료되었거나 교환 세션에 들어갔을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het aanbod is niet geannuleerd. Het is mogelijk verlopen of is in een swapsessie beland."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferta nie została anulowana. Być może wygasł lub wszedł w sesję wymiany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A oferta não foi cancelada. Pode ter expirado ou entrado em uma sessão de troca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложение не было отменено. Возможно, срок его действия истек или он вступил в сеанс обмена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teklif iptal edilmedi. Süresi dolmuş veya takas oturumuna girmiş olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропозиція не була відмінена. Можливо, він закінчився або ввійшов у сеанс обміну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời đề nghị đã không bị hủy bỏ. Nó có thể đã hết hạn hoặc đã tham gia phiên trao đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该优惠并未取消。它可能已过期或进入交换会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該優惠並未取消。它可能已过期或进入交换会话。"
          }
        }
      }
    },
    "wallet_swap_cancel_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد سحب العرض الموقع من %1$d sats لـ %2$@ HNS؟ معرف العرض: %3$@. يؤدي الإلغاء إلى تحرير حجز الرصيد المحلي الخاص به ويتم الإعلان عنه لنظير المبادلة المتصل. ولا يؤدي ذلك إلى إلغاء جلسة المبادلة التي قبلت هذه الشروط وجمدتها بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das unterschriebene Angebot von %1$d sats für %2$@ HNS zurückziehen? Angebots-ID: %3$@. Durch die Stornierung wird die lokale Guthabenreservierung freigegeben und dem angeschlossenen Swap-Peer bekannt gegeben. Eine Tauschsitzung, die diese Bedingungen bereits akzeptiert und eingefroren hat, wird dadurch nicht abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Withdraw the signed offer of %1$d sats for %2$@ HNS? Offer ID: %3$@. Cancellation releases its local balance reservation and is announced to the connected swap peer. It does not cancel a swap session that has already accepted and frozen these terms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Retirar la oferta firmada de %1$d sats por %2$@ HNS? ID de oferta: %3$@. La cancelación libera su reserva de saldo local y se anuncia al par de swap conectado. No cancela una sesión de swap que ya haya aceptado y congelado estos términos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشنهاد امضا شده %1$d sats برای %2$@ HNS را پس بگیرید؟ شناسه پیشنهاد: %3$@. لغو رزرو موجودی محلی خود را آزاد می کند و به همتای مبادله متصل اعلام می شود. جلسه مبادله ای را که قبلاً این شرایط را پذیرفته و ثابت کرده است، لغو نمی کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer l'offre signée de %1$d sats pour %2$@ HNS ? Numéro d’offre : %3$@. L'annulation libère sa réservation de solde local et est annoncée au homologue de swap connecté. Cela n'annule pas une session d'échange qui a déjà accepté et gelé ces conditions."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לבטל את ההצעה החתומה של %1$d sats עבור %2$@ HNS? מזהה הצעה: %3$@. ביטול משחרר את הזמנת היתרה המקומית שלו ומוכרז לעמית ההחלפה המחוברת. זה לא מבטל הפעלת החלפה שכבר הסכימה והקפיאה את התנאים האלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ HNS के लिए %1$d sats के हस्ताक्षरित प्रस्ताव को वापस लें? ऑफ़र आईडी: %3$@. रद्दीकरण अपना स्थानीय शेष आरक्षण जारी करता है और कनेक्टेड स्वैप सहकर्मी को इसकी घोषणा की जाती है। यह उस स्वैप सत्र को रद्द नहीं करता है जिसने पहले ही इन शर्तों को स्वीकार कर लिया है और रोक दिया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menarik tawaran %1$d sats yang telah ditandatangani untuk %2$@ HNS? ID Penawaran: %3$@. Pembatalan melepaskan reservasi saldo lokalnya dan diumumkan ke rekan swap yang terhubung. Itu tidak membatalkan sesi pertukaran yang telah menerima dan membekukan persyaratan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ritirare l'offerta firmata di %1$d sats per %2$@ HNS? ID offerta: %3$@. L'annullamento rilascia la prenotazione del saldo locale e viene annunciato al peer di scambio connesso. Non annulla una sessione di scambio che ha già accettato e congelato questi termini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d sats の %2$@ HNS に対する署名済みのオファーを撤回しますか?オファーID: %3$@。キャンセルするとローカル残高予約が解放され、接続されたスワップピアに通知されます。これらの条件にすでに同意して凍結されているスワップ セッションはキャンセルされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ HNS에 대한 %1$d sats의 서명된 제안을 철회하시겠습니까? 제안 ID: %3$@. 취소는 로컬 잔액 예약을 해제하고 연결된 스왑 피어에 공지됩니다. 이미 이러한 조건을 수락하고 동결한 스왑 세션은 취소되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het ondertekende aanbod van %1$d sats voor %2$@ HNS intrekken? Aanbiedings-ID: %3$@. Bij annulering wordt de lokale saldoreservering vrijgegeven en aangekondigd aan de aangesloten swappeer. Een swapsessie die deze voorwaarden al heeft geaccepteerd en bevroren, wordt niet geannuleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wycofać podpisaną ofertę %1$d sats na %2$@ HNS? Identyfikator oferty: %3$@. Anulowanie zwalnia rezerwację salda lokalnego i jest ogłaszane podłączonemu partnerowi wymiany. Nie anuluje sesji wymiany, która już zaakceptowała i zamroziła te warunki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirar a oferta assinada de %1$d sats por %2$@ HNS? ID da oferta: %3$@. O cancelamento libera sua reserva de saldo local e é anunciado ao peer de swap conectado. Não cancela uma sessão de swap que já aceitou e congelou estes termos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отозвать подписанное предложение %1$d sats на %2$@ HNS? Идентификатор предложения: %3$@. Отмена освобождает локальное резервирование баланса и объявляется подключенному узлу обмена. Он не отменяет сессию обмена, которая уже приняла и заморозила эти условия."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ HNS için %1$d sats imzalı teklifi geri çekilsin mi? Teklif Kimliği: %3$@. İptal, yerel bakiye rezervasyonunu iptal eder ve bağlı takas eşine duyurulur. Bu şartları zaten kabul etmiş ve dondurmuş bir takas seansını iptal etmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкликати підписану пропозицію %1$d sats для %2$@ HNS? Ідентифікатор пропозиції: %3$@. Скасування звільняє локальне резервування балансу та оголошується підключеному партнеру обміну. Це не скасовує сеанс обміну, який уже прийняв і заморозив ці умови."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Rút lại ưu đãi đã ký của %1$d sats cho %2$@ HNS? ID ưu đãi: %3$@. Việc hủy bỏ sẽ giải phóng phần dự trữ số dư cục bộ của nó và được thông báo cho đối tác hoán đổi được kết nối. Nó không hủy phiên hoán đổi đã chấp nhận và đóng băng các điều khoản này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回已签署的 %1$d sats 对 %2$@ HNS 的报价？优惠 ID：%3$@。取消会释放其本地余额预留，并向连接的交换节点宣布。它不会取消已经接受并冻结这些条款的交换会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤回已簽署的 %1$d sats 對 %2$@ HNS 的報價？优惠 ID：%3$@。取消會釋放其本地餘額預留，並向連接的交換節點宣布。它不會取消已經接受並凍結這些條款的交換會話。"
          }
        }
      }
    },
