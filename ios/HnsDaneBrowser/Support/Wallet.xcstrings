        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї пропозиції потрібен %1$d sat lock, включаючи %2$d sat Bitcoin резерв комісії (загалом %3$d sats), але цей гаманець має %4$d підтверджений sats."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ưu đãi này yêu cầu khóa sat %1$d bao gồm dự trữ phí sat %2$d Bitcoin (tổng cộng %3$d sats), nhưng ví này có %4$d đã xác nhận sats."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此优惠需要 %1$d sat 锁，包括 %2$d sat Bitcoin 费用储备（%3$d sats 总计），但此钱包有 %4$d 确认 sats。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
