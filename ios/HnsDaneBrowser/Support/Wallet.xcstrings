    "wallet_swap_take_insufficient_btc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب هذا العرض قفل %1$d بما في ذلك احتياطي رسوم %2$d Bitcoin (إجمالي %3$d sats)، ولكن هذه المحفظة تحتوي على %4$d المؤكدة sats."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für dieses Angebot ist ein %1$d-Sat-Schloss einschließlich einer %2$d-Sat-Bitcoin-Gebührenreserve (%3$d sats insgesamt) erforderlich, aber für diese Brieftasche ist %4$d sats bestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This offer requires a %1$d sat lock including a %2$d sat Bitcoin fee reserve (%3$d sats total), but this wallet has %4$d confirmed sats."
