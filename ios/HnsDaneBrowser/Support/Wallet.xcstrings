    "wallet_swap_settlement_prepare_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجراء المبادلة هذا غير مصرح به حاليًا. قم بتأكيد دورك، والتمويل الذي تم التحقق منه، والسر الملحوظ، واستحقاق المهلة، وحالة المزامنة، والحد الأقصى للرسوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Tauschaktion ist derzeit nicht autorisiert. Bestätigen Sie Ihre Rolle, verifizierte Finanzierung, beobachtetes Geheimnis, Timeout-Laufzeit, Synchronisierungsstatus und Gebührenobergrenze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That swap action is not currently authorized. Confirm your role, verified funding, observed secret, timeout maturity, synchronization state, and fee cap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa acción de intercambio no está autorizada actualmente. Confirme su función, financiación verificada, secreto observado, vencimiento del tiempo de espera, estado de sincronización y límite de tarifas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این اقدام مبادله در حال حاضر مجاز نیست. نقش خود، بودجه تأیید شده، راز مشاهده شده، سررسید مهلت زمانی، وضعیت همگام سازی و سقف هزینه را تأیید کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action d'échange n'est actuellement pas autorisée. Confirmez votre rôle, le financement vérifié, le secret observé, l'échéance du délai d'expiration, l'état de synchronisation et le plafond des frais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולת ההחלפה הזו אינה מורשית כרגע. אשר את תפקידך, מימון מאומת, סוד שנצפה, מועד זמן קצוב, מצב סנכרון ומכסת עמלות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह स्वैप कार्रवाई वर्तमान में अधिकृत नहीं है। अपनी भूमिका, सत्यापित फंडिंग, देखे गए रहस्य, टाइमआउट परिपक्वता, सिंक्रोनाइज़ेशन स्थिति और शुल्क सीमा की पुष्टि करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan pertukaran tersebut saat ini tidak diizinkan. Konfirmasikan peran Anda, pendanaan terverifikasi, rahasia yang diamati, batas waktu jatuh tempo, status sinkronisasi, dan batas biaya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione di scambio non è attualmente autorizzata. Conferma il tuo ruolo, i finanziamenti verificati, il segreto osservato, la scadenza del timeout, lo stato di sincronizzazione e il limite tariffario."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その交換アクションは現在許可されていません。自分の役割、確認された資金、観察されたシークレット、タイムアウト満期、同期状態、料金上限を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 교환 작업은 현재 승인되지 않았습니다. 귀하의 역할, 검증된 자금, 관찰된 비밀, 시간 초과 성숙도, 동기화 상태 및 수수료 상한선을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ruilactie is momenteel niet toegestaan. Bevestig uw rol, geverifieerde financiering, waargenomen geheim, time-outverlooptijd, synchronisatiestatus en vergoedingslimiet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta akcja zamiany nie jest obecnie autoryzowana. Potwierdź swoją rolę, zweryfikowane finansowanie, zaobserwowany sekret, termin przekroczenia limitu czasu, stan synchronizacji i limit opłat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa ação de troca não está autorizada atualmente. Confirme sua função, financiamento verificado, segredo observado, vencimento do tempo limite, estado de sincronização e limite de taxa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это действие замены в настоящее время не разрешено. Подтвердите свою роль, подтвержденное финансирование, наблюдаемый секрет, срок действия тайм-аута, состояние синхронизации и ограничение комиссии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu takas işlemine şu anda izin verilmedi. Rolünüzü, doğrulanmış finansmanı, gözlemlenen sırrı, zaman aşımı süresini, senkronizasyon durumunu ve ücret üst sınırını onaylayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця дія обміну наразі не дозволена. Підтвердьте свою роль, перевірене фінансування, спостережуваний секрет, час очікування, стан синхронізації та обмеження комісії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hành động hoán đổi đó hiện không được ủy quyền. Xác nhận vai trò của bạn, nguồn vốn đã được xác minh, bí mật được quan sát, thời gian chờ, trạng thái đồng bộ hóa và giới hạn phí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该交换行动目前尚未获得授权。确认您的角色、已验证的资金、观察到的秘密、超时期限、同步状态和费用上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該交換行動目前尚未獲得授權。確認您的角色、已驗證的資金、觀察到的秘密、超時期限、同步狀態和費用上限。"
          }
        }
      }
    },
