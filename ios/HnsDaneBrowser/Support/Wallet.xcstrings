    "wallet_delete_context_changed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تغيير ملكية المحفظة أو هويتها. تم إلغاء الحذف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet-Besitz oder Identität geändert. Der Löschvorgang wurde abgebrochen."
