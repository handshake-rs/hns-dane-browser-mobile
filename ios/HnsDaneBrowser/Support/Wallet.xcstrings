    "wallet_direct_shakescape_reachability_waiting_hsd_peer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرشح نقطة النهاية العامة وخدمة NETWORK التي تم التحقق منها جاهزة؛ إعادة توصيل أقرانهم HSD لنشر ADDR. مرشحو الاكتشاف %1$d."
