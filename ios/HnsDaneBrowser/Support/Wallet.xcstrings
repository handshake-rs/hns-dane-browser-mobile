    "wallet_value_actions_result_ambiguous": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إرجاع أي نتيجة كاملة. كانت المحفظة مقفلة؛ قم بالمزامنة قبل أن تقرر ما إذا كنت تريد إعادة المحاولة أم لا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es konnte kein vollständiges Ergebnis zurückgegeben werden. Die Brieftasche war verschlossen; Synchronisieren Sie, bevor Sie entscheiden, ob Sie es erneut versuchen möchten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No complete result could be returned. The wallet was locked; synchronize before deciding whether to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo devolver ningún resultado completo. La cartera estaba cerrada con llave; sincronizar antes de decidir si volver a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ نتیجه کاملی قابل بازگشت نیست. کیف پول قفل شد؛ قبل از تصمیم گیری برای تلاش مجدد، همگام سازی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun résultat complet n'a pu être renvoyé. Le portefeuille était verrouillé ; synchroniser avant de décider de réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להחזיר תוצאה מלאה. הארנק היה נעול; לסנכרן לפני שתחליט אם לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई पूर्ण परिणाम वापस नहीं किया जा सका. बटुआ बंद था; पुनः प्रयास करना है या नहीं यह निर्णय लेने से पहले सिंक्रनाइज़ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada hasil lengkap yang bisa dikembalikan. Dompetnya terkunci; sinkronisasi sebelum memutuskan apakah akan mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile restituire un risultato completo. Il portafoglio era chiuso a chiave; sincronizzarsi prima di decidere se riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全な結果は返されませんでした。財布はロックされていた。再試行するかどうかを決定する前に同期してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완전한 결과를 반환할 수 없습니다. 지갑이 잠겨 있었습니다. 재시도 여부를 결정하기 전에 동기화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er kon geen volledig resultaat worden geretourneerd. De portemonnee was op slot; synchroniseren voordat u besluit of u het opnieuw wilt proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zwrócić pełnego wyniku. Portfel był zamknięty; zsynchronizuj przed podjęciem decyzji o ponownej próbie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum resultado completo pôde ser retornado. A carteira estava trancada; sincronizar antes de decidir se deseja tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полный результат не может быть возвращен. Кошелек был заперт; синхронизируйте, прежде чем решить, следует ли повторять попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam bir sonuç döndürülemedi. Cüzdan kilitliydi; Yeniden denemeye karar vermeden önce senkronize edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неможливо повернути повний результат. Гаманець був замкнений; синхронізувати, перш ніж вирішити, чи повторювати спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có kết quả hoàn chỉnh có thể được trả lại. Ví đã bị khóa; đồng bộ hóa trước khi quyết định có thử lại hay không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法返回完整的结果。钱包被锁了；在决定是否重试之前进行同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法回傳完整的結果。錢包被鎖了；在決定是否重試之前進行同步。"
          }
        }
      }
    },
