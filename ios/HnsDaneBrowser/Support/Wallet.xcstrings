    "wallet_bitcoin_sync_operation_busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظر حتى تنتهي مزامنة Bitcoin قبل بدء عملية Bitcoin أخرى. تظل وظائف المحفظة HNS متاحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten Sie, bis die Bitcoin-Synchronisierung abgeschlossen ist, bevor Sie einen weiteren Bitcoin-Vorgang starten. HNS Wallet-Funktionen bleiben weiterhin verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for Bitcoin synchronization to finish before starting another Bitcoin operation. HNS wallet functions remain available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espere a que finalice la sincronización de Bitcoin antes de iniciar otra operación de Bitcoin. Las funciones de billetera HNS permanecen disponibles."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل از شروع عملیات Bitcoin دیگر صبر کنید تا همگام سازی Bitcoin به پایان برسد. عملکردهای کیف پول HNS همچنان در دسترس هستند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendez la fin de la synchronisation Bitcoin avant de lancer une autre opération Bitcoin. Les fonctions de portefeuille HNS restent disponibles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המתן לסיום סנכרון Bitcoin לפני שתתחיל פעולה נוספת של Bitcoin. פונקציות הארנק HNS נשארות זמינות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरा Bitcoin ऑपरेशन शुरू करने से पहले Bitcoin सिंक्रनाइज़ेशन समाप्त होने तक प्रतीक्षा करें। HNS वॉलेट फ़ंक्शन उपलब्ध रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunggu hingga sinkronisasi Bitcoin selesai sebelum memulai operasi Bitcoin lainnya. Fungsi dompet HNS tetap tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendere il completamento della sincronizzazione Bitcoin prima di avviare un'altra operazione Bitcoin. Le funzioni del portafoglio HNS rimangono disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の Bitcoin 操作を開始する前に、Bitcoin 同期が完了するまで待ってください。 HNS ウォレット機能は引き続きご利用いただけます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 Bitcoin 작업을 시작하기 전에 Bitcoin 동기화가 완료될 때까지 기다리십시오. HNS 지갑 기능은 계속 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wacht tot de Bitcoin-synchronisatie is voltooid voordat u een nieuwe Bitcoin-bewerking start. HNS portemonnee-functies blijven beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczekaj na zakończenie synchronizacji Bitcoin przed rozpoczęciem kolejnej operacji Bitcoin. Funkcje portfela HNS pozostają dostępne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguarde a conclusão da sincronização Bitcoin antes de iniciar outra operação Bitcoin. As funções da carteira HNS permanecem disponíveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дождитесь завершения синхронизации Bitcoin, прежде чем начинать следующую операцию Bitcoin. Функции кошелька HNS остаются доступными."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başka bir Bitcoin işlemine başlamadan önce Bitcoin senkronizasyonunun bitmesini bekleyin. HNS cüzdan işlevleri kullanılabilir durumda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачекайте, поки завершиться синхронізація Bitcoin, перш ніж починати іншу операцію Bitcoin. Функції гаманця HNS залишаються доступними."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đợi quá trình đồng bộ hóa Bitcoin hoàn tất trước khi bắt đầu một thao tác Bitcoin khác. Các chức năng ví HNS vẫn khả dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 Bitcoin 同步完成，然后再开始另一个 Bitcoin 操作。 HNS钱包功能仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 Bitcoin 同步完成，然後再開始另一個 Bitcoin 作業。 HNS錢包功能仍然可用。"
          }
        }
      }
    },
