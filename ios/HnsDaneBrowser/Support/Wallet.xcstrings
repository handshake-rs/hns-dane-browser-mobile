    "row_wallet_recover_name_summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنفيذ مسار استرداد البائع عند استيفاء شروط استرداد الأموال الخاصة به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie den Wiederherstellungspfad des Verkäufers aus, wenn die Rückerstattungsbedingungen erfüllt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Execute the seller recovery path when its refund conditions are satisfied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecutar la ruta de recuperación del vendedor cuando se cumplan sus condiciones de reembolso."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمانی که شرایط بازپرداخت فروشنده برآورده شد، مسیر بازیابی فروشنده را اجرا کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécutez le chemin de récupération du vendeur lorsque ses conditions de remboursement sont satisfaites."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בצע את נתיב השחזור של המוכר כאשר תנאי ההחזר שלו מתקיימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विक्रेता पुनर्प्राप्ति पथ निष्पादित करें जब उसकी धनवापसी शर्तें पूरी हो जाएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan jalur pemulihan penjual ketika kondisi pengembalian dana terpenuhi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui il percorso di recupero del venditore quando le sue condizioni di rimborso sono soddisfatte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返金条件が満たされた場合、販売者回復パスを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환불 조건이 만족되면 판매자 복구 경로를 실행합니다."
          }
        },
        "nl": {
          "stringUnit": {
