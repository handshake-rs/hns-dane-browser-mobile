    "wallet_swap_funding_prepare_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إعداد تمويل Bitcoin HTLC. قم بتأكيد الجلسة المقبولة وحالة السلسلة الحالية واحتياطي الرسوم الموقعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin HTLC Finanzierung wurde nicht vorbereitet. Bestätigen Sie die akzeptierte Sitzung, den aktuellen Kettenstatus und die unterzeichnete Gebührenreserve."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin HTLC funding was not prepared. Confirm the accepted session, current chain state, and signed fee reserve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin HTLC no se preparó la financiación. Confirme la sesión aceptada, el estado actual de la cadena y la reserva de tarifa firmada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بودجه Bitcoin HTLC آماده نشد. جلسه پذیرفته شده، وضعیت فعلی زنجیره و ذخیره هزینه امضا شده را تأیید کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le financement Bitcoin HTLC n’a pas été préparé. Confirmez la session acceptée, l'état actuel de la chaîne et la réserve de frais signée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מימון Bitcoin HTLC לא הוכן. אשר את ההפעלה המקובלת, מצב השרשרת הנוכחי ועתודת האגרה החתומה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin HTLC फंडिंग तैयार नहीं की गई थी। स्वीकृत सत्र, वर्तमान श्रृंखला स्थिति और हस्ताक्षरित शुल्क आरक्षित की पुष्टि करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendanaan Bitcoin HTLC belum disiapkan. Konfirmasikan sesi yang diterima, status rantai saat ini, dan cadangan biaya yang ditandatangani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin HTLC il finanziamento non è stato preparato. Conferma la sessione accettata, lo stato attuale della catena e la riserva tariffaria firmata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin HTLC 資金が準備されていませんでした。受け入れられたセッション、現在のチェーン状態、署名された料金予約を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin HTLC 펀딩이 준비되지 않았습니다. 승인된 세션, 현재 체인 상태, 서명된 수수료 예비를 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin HTLC financiering was niet voorbereid. Bevestig de geaccepteerde sessie, de huidige ketenstatus en de ondertekende kostenreservering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin HTLC finansowanie nie zostało przygotowane. Potwierdź zaakceptowaną sesję, bieżący stan łańcucha i podpisaną rezerwę opłat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O financiamento Bitcoin HTLC não foi preparado. Confirme a sessão aceita, o estado atual da cadeia e a reserva de taxa assinada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin HTLC финансирование не было подготовлено. Подтвердите принятый сеанс, текущее состояние цепочки и подписанный резерв комиссии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin HTLC finansmanı hazırlanmadı. Kabul edilen oturumu, mevcut zincir durumunu ve imzalanmış ücret rezervini onaylayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin HTLC фінансування не було підготовлено. Підтвердьте прийнятий сеанс, поточний стан ланцюга та підписаний резерв комісії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguồn vốn Bitcoin HTLC chưa được chuẩn bị. Xác nhận phiên được chấp nhận, trạng thái chuỗi hiện tại và dự trữ phí đã ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin HTLC 资金未准备。确认接受的会话、当前的链状态和签名的费用储备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin HTLC 資金未準備。確認接受的會話、目前的鏈狀態和簽署的費用儲備。"
          }
        }
      }
