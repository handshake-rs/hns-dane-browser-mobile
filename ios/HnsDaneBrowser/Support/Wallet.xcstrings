    "wallet_send_warning_fee_change": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يتغير تقدير الرسوم النهائي ولكن لا يمكن أن يتجاوز الحد الأقصى المعتمد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die endgültige Gebührenschätzung kann sich ändern, darf jedoch den genehmigten Höchstbetrag nicht überschreiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The final fee estimate may change but cannot exceed the approved maximum."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La estimación de la tarifa final puede cambiar pero no puede exceder el máximo aprobado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برآورد هزینه نهایی ممکن است تغییر کند، اما نمی تواند از حداکثر تایید شده تجاوز کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'estimation finale des frais peut changer mais ne peut pas dépasser le maximum approuvé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערכת האגרה הסופית עשויה להשתנות אך אינה יכולה לחרוג מהמקסימום המאושר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतिम शुल्क अनुमान बदल सकता है लेकिन अनुमोदित अधिकतम से अधिक नहीं हो सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkiraan biaya akhir dapat berubah tetapi tidak boleh melebihi jumlah maksimum yang disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stima della tariffa finale può cambiare ma non può superare il massimo approvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最終的な料金見積もりは変更される可能性がありますが、承認された最大額を超えることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최종 수수료 견적은 변경될 수 있지만 승인된 최대 금액을 초과할 수는 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De definitieve schatting van de vergoeding kan veranderen, maar kan het goedgekeurde maximum niet overschrijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostateczna szacunkowa opłata może ulec zmianie, ale nie może przekroczyć zatwierdzonej kwoty maksymalnej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A estimativa final da taxa pode sofrer alterações, mas não pode exceder o máximo aprovado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окончательная оценка комиссии может измениться, но не может превышать утвержденный максимум."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nihai ücret tahmini değişebilir ancak onaylanan maksimum tutarı aşamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Остаточна оцінка комісії може змінюватися, але не може перевищувати затверджений максимум."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ước tính phí cuối cùng có thể thay đổi nhưng không thể vượt quá mức tối đa được phê duyệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最终费用估算可能会发生变化，但不能超过批准的最高费用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最終費用估算可能會發生變化，但不能超過核准的最高費用。"
          }
        }
      }
    },
