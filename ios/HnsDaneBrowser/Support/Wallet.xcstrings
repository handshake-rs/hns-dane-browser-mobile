    "wallet_swap_settlement_broadcast_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التسوية المعدة لا تزال غير مؤكدة. تحقق من المزامنة وحالة المعاملة الدائمة قبل القيام بمحاولة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der vorbereitete Vergleich bleibt unbestätigt; Überprüfen Sie die Synchronisierung und den Status der dauerhaften Transaktion, bevor Sie einen weiteren Versuch unternehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prepared settlement remains unconfirmed; check synchronization and durable transaction status before making another attempt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acuerdo preparado sigue sin confirmarse; verifique la sincronización y el estado duradero de la transacción antes de realizar otro intento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تسویه حساب آماده شده هنوز تایید نشده است. همگام سازی و وضعیت تراکنش بادوام را قبل از تلاش مجدد بررسی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le règlement préparé n’est toujours pas confirmé ; vérifiez la synchronisation et l’état durable de la transaction avant de faire une autre tentative."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההסדר המוכן נותר ללא אישור; בדוק סנכרון ומצב עסקה עמיד לפני ביצוע ניסיון נוסף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तैयार समझौता अपुष्ट रहता है; दूसरा प्रयास करने से पहले सिंक्रनाइज़ेशन और टिकाऊ लेनदेन स्थिति की जांच करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyelesaian yang disiapkan masih belum dikonfirmasi; periksa sinkronisasi dan status transaksi yang tahan lama sebelum melakukan upaya lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accordo preparato rimane non confermato; controlla la sincronizzazione e lo stato della transazione durevole prima di fare un altro tentativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備された和解案は未確認のままである。別の試行を行う前に、同期と永続トランザクションのステータスを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "준비된 합의는 아직 확인되지 않은 상태입니다. 다시 시도하기 전에 동기화 및 내구성 있는 트랜잭션 상태를 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De voorbereide schikking blijft onbevestigd; controleer de synchronisatie en de duurzame transactiestatus voordat u een nieuwe poging doet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przygotowane rozliczenie pozostaje niepotwierdzone; sprawdź synchronizację i trwały status transakcji przed podjęciem kolejnej próby."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acordo preparado permanece não confirmado; verifique a sincronização e o status da transação durável antes de fazer outra tentativa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подготовленное поселение остается неподтвержденным; проверьте синхронизацию и статус устойчивой транзакции, прежде чем предпринимать еще одну попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırlanan anlaşma doğrulanmadı; başka bir deneme yapmadan önce senkronizasyonu ve kalıcı işlem durumunu kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підготовлене поселення залишається непідтвердженим; перевірте синхронізацію та статус довгострокової транзакції перед наступною спробою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc giải quyết đã chuẩn bị vẫn chưa được xác nhận; kiểm tra tính đồng bộ hóa và trạng thái giao dịch lâu bền trước khi thực hiện lần thử khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备好的和解方案尚未得到确认；在再次尝试之前检查同步和持久事务状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "準備好的和解方案尚未得到確認；在再次嘗試之前檢查同步和持久交易狀態。"
          }
        }
      }
    },
