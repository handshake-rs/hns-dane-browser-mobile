    "wallet_direct_shakescape_replaced": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استبدال نظير المبادلة النشط بـ %1$@. يتم تشغيل تبادل المجلس محليا دون التتابع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktive Swap-Peer wurde durch %1$@ ersetzt. Der Board-Austausch läuft lokal ohne Relay."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Replaced the active swap peer with %1$@. Board exchange is running locally without a relay."
          }
