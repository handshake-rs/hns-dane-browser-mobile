        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memvalidasi pos pemeriksaan Bitcoin yang disinkronkan dan batas reorganisasi… %1$@ yang telah berlalu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Convalida del checkpoint Bitcoin sincronizzato e del confine di riorganizzazione… %1$@ trascorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期された Bitcoin チェックポイントと再編成境界を検証しています… %1$@ が経過しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화된 Bitcoin 체크포인트 및 재구성 경계를 검증하는 중… %1$@가 경과되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Validatie van het gesynchroniseerde Bitcoin-controlepunt en de reorganisatiegrens… Verstreken %1$@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzanie zsynchronizowanego punktu kontrolnego Bitcoin i granicy reorganizacji… Upłynęło %1$@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Validando o ponto de verificação Bitcoin sincronizado e o limite de reorganização… Decorrido %1$@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка синхронизированной контрольной точки Bitcoin и границы реорганизации… Истекло %1$@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkronize Bitcoin kontrol noktası ve yeniden düzenleme sınırı doğrulanıyor… Geçen %1$@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірка синхронізованої контрольної точки Bitcoin і межі реорганізації… Минув %1$@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang xác thực điểm kiểm tra Bitcoin đã đồng bộ hóa và ranh giới tổ chức lại… %1$@ đã qua."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在验证同步的 Bitcoin 检查点和重组边界...已过 %1$@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在驗證同步的 Bitcoin 檢查點和重組邊界...已過 %1$@。"
          }
        }
      }
    },
