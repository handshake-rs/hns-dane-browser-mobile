          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifying current direct-peer wallet state before reviewing this send…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando el estado actual de la billetera de pares directos antes de revisar este envío..."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درحال تأیید وضعیت فعلی کیف پول همتا مستقیم قبل از بررسی این ارسال…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification de l’état actuel du portefeuille direct avant d’examiner cet envoi…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאמת את המצב הנוכחי של ארנק עמית ישיר לפני בדיקת השליחה הזו..."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रेषण की समीक्षा करने से पहले वर्तमान डायरेक्ट-पीयर वॉलेट स्थिति का सत्यापन किया जा रहा है..."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memverifikasi status dompet rekan langsung saat ini sebelum meninjau pengiriman ini…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica dello stato attuale del portafoglio peer diretto prima di rivedere questo invio…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この送信を確認する前に、現在のダイレクトピアウォレットの状態を確認しています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 전송을 검토하기 전에 현재 직접 피어 지갑 상태를 확인하는 중…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De huidige status van de directe peer-portemonnee verifiëren voordat u deze verzending bekijkt..."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzam bieżący stan portfela Direct Peer przed przejrzeniem tej wysyłki…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando o estado atual da carteira de peer direto antes de revisar este envio…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка текущего состояния однорангового кошелька перед просмотром этой отправки…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gönderimi incelemeden önce mevcut doğrudan eş cüzdan durumu doğrulanıyor…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірка поточного стану прямого гаманця перед переглядом цього надсилання…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang xác minh trạng thái ví ngang hàng trực tiếp hiện tại trước khi xem lại lần gửi này…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在查看此发送之前验证当前直接对等钱包状态..."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在查看此發送之前驗證當前直接對等錢包狀態..."
          }
        }
      }
    },
    "wallet_send_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال HNS غير متاح حتى تتصل المحفظة وتتحقق من حالتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Senden von HNS ist erst möglich, wenn das Wallet eine Verbindung herstellt und seinen Status überprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS sending is unavailable until the wallet connects and verifies its state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El envío de HNS no está disponible hasta que la billetera se conecte y verifique su estado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسال HNS تا زمانی که کیف پول متصل نشود و وضعیت آن را تأیید کند، در دسترس نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'envoi HNS n'est pas disponible jusqu'à ce que le portefeuille se connecte et vérifie son état."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שליחת HNS אינה זמינה עד שהארנק מתחבר ומאמת את מצבו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS भेजना तब तक अनुपलब्ध है जब तक वॉलेट कनेक्ट नहीं हो जाता और अपनी स्थिति सत्यापित नहीं कर लेता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengiriman HNS tidak tersedia hingga dompet terhubung dan memverifikasi statusnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'invio HNS non è disponibile finché il portafoglio non si connette e ne verifica lo stato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS の送信は、ウォレットが接続してその状態を確認するまで利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑이 연결되어 상태를 확인할 때까지 HNS 전송을 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verzenden van HNS is niet beschikbaar totdat de portemonnee verbinding maakt en de status ervan verifieert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysyłanie HNS jest niedostępne do czasu połączenia portfela i sprawdzenia jego stanu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio de HNS fica indisponível até que a carteira se conecte e verifique seu estado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка HNS недоступна до тех пор, пока кошелек не подключится и не проверит свое состояние."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS gönderme, cüzdan bağlanana ve durumunu doğrulayana kadar kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилання HNS недоступне, доки гаманець не підключиться та не перевірить свій стан."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc gửi HNS không khả dụng cho đến khi ví kết nối và xác minh trạng thái của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在钱包连接并验证其状态之前，HNS 发送不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在錢包連接並驗證其狀態之前，HNS 發送不可用。"
          }
        }
      }
    },
    "wallet_send_waiting_for_wallet": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وافتح محفظة مؤكدة قبل إرسال HNS."
          }
        },
        "de": {
