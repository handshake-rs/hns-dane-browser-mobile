          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở và mở khóa ví cục bộ đã được xác nhận để kiểm tra các lần đọc HNS được đồng bộ hóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开并解锁已确认的本地钱包以检查同步的 HNS 读取。"
