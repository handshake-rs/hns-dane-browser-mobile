    "wallet_direct_shakescape_reachability_advertised": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرشح نقطة النهاية العامة من %1$@؛ تم الإعلان عنها من خلال المخزون HSD. أقرانهم في مجلس %2$d؛ مرشحو الاكتشاف %3$d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffentlicher Endpunktkandidat von %1$@; beworben durch Lagerbestand HSD. %2$d Board-Peers; %3$d Discovery-Kandidaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Public endpoint candidate from %1$@; advertised through stock HSD. %2$d board peers; %3$d discovery candidates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Candidato de punto final público de %1$@; anunciado a través del stock HSD. pares de la junta %2$d; Candidatos de descubrimiento %3$d."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نامزد نقطه پایان عمومی از %1$@؛ از طریق سهام HSD تبلیغ می شود. همتایان برد %2$d; نامزدهای کشف %3$d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Candidat de point de terminaison public de %1$@ ; annoncé via le stock HSD. Pairs de cartes %2$d ; Candidats à la découverte %3$d."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מועמד לנקודת קצה ציבורית מ-%1$@; מפורסם דרך מלאי HSD. עמיתים ללוח %2$d; %3$d מועמדים לגילוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ से सार्वजनिक समापन बिंदु उम्मीदवार; स्टॉक HSD के माध्यम से विज्ञापित। %2$d बोर्ड सहकर्मी; %3$d खोज उम्मीदवार।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandidat titik akhir publik dari %1$@; diiklankan melalui stok HSD. Rekan dewan %2$d; Kandidat penemuan %3$d."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Candidato endpoint pubblico da %1$@; pubblicizzato tramite stock HSD. peer della scheda %2$d; Candidati alla scoperta %3$d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ のパブリック エンドポイント候補。 HSD という株式を通じて宣伝されます。 %2$d ボードピア。 %3$d 発見候補。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@의 공개 끝점 후보; 재고 HSD를 통해 광고되었습니다. %2$d 보드 피어; %3$d 발견 후보."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandidaat voor openbaar eindpunt van %1$@; geadverteerd via voorraad HSD. %2$d bestuursgenoten; %3$d ontdekkingskandidaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandydat na publiczny punkt końcowy z %1$@; reklamowane w magazynie HSD. Elementy równorzędne płyty %2$d; Kandydaci do odkrycia %3$d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Candidato a endpoint público de %1$@; anunciado através do estoque HSD. Pares da placa %2$d; Candidatos à descoberta %3$d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кандидат общедоступной конечной точки от %1$@; рекламируется через акции HSD. Одноранговые узлы платы %2$d; Кандидаты на открытие %3$d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'den genel uç nokta adayı; HSD stok aracılığıyla reklamı yapılır. %2$d yönetim kurulu akranları; %3$d keşif adayları."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Публічна кінцева точка-кандидат від %1$@; рекламується на складі HSD. %2$d вузли плати; Кандидати на відкриття %3$d."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng cử viên điểm cuối công khai từ %1$@; được quảng cáo thông qua kho HSD. Hội đồng quản trị %2$d; Ứng cử viên khám phá %3$d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 %1$@ 的公共端点候选者；通过股票 HSD 进行广告。 %2$d板同行； %3$d 发现候选者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 %1$@ 的公共端點候選者；透過股票 HSD 進行廣告。 %2$d板同行； %3$d 發現候選者。"
          }
        }
      }
    },
    "wallet_direct_shakescape_reachability_ipv6_verification": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد مرشح عالمي لـ IPv6، ولكن يلزم التحقق من TCP خارجيًا قبل نشر ADDR. مرشحو الاكتشاف %1$d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt einen globalen IPv6-Kandidaten, aber vor der Veröffentlichung von ADDR ist eine externe eingehende TCP-Verifizierung erforderlich. %1$d Discovery-Kandidaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A global IPv6 candidate exists, but external inbound TCP verification is required before ADDR publication. %1$d discovery candidates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe un candidato IPv6 global, pero se requiere una verificación entrante externa de TCP antes de la publicación de ADDR. Candidatos de descubrimiento %1$d."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک نامزد جهانی IPv6 وجود دارد، اما تأیید TCP ورودی خارجی قبل از انتشار ADDR مورد نیاز است. نامزدهای کشف %1$d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un candidat IPv6 global existe, mais une vérification externe TCP entrante est requise avant la publication de ADDR. Candidats à la découverte %1$d."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיים מועמד גלובלי של IPv6, אך נדרש אימות TCP נכנס חיצוני לפני פרסום ADDR. %1$d מועמדים לגילוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक वैश्विक IPv6 उम्मीदवार मौजूद है, लेकिन ADDR प्रकाशन से पहले बाहरी इनबाउंड TCP सत्यापन आवश्यक है। %1$d खोज उम्मीदवार।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandidat IPv6 global ada, namun verifikasi TCP masuk eksternal diperlukan sebelum publikasi ADDR. Kandidat penemuan %1$d."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste un candidato IPv6 globale, ma è richiesta la verifica TCP in entrata esterna prima della pubblicazione di ADDR. Candidati alla scoperta %1$d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グローバル IPv6 候補は存在しますが、ADDR を公開する前に外部インバウンド TCP 検証が必要です。 %1$d 発見候補。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글로벌 IPv6 후보가 존재하지만 ADDR 게시 전에 외부 인바운드 TCP 확인이 필요합니다. %1$d 발견 후보."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bestaat een globale IPv6-kandidaat, maar externe inkomende TCP-verificatie is vereist voordat ADDR wordt gepubliceerd. %1$d ontdekkingskandidaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Istnieje globalny kandydat IPv6, ale przed publikacją ADDR wymagana jest zewnętrzna weryfikacja przychodzącego TCP. Kandydaci do odkrycia %1$d."
          }
