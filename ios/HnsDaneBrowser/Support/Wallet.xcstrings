    "wallet_auth_unlock_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد كلمة مرور الجهاز أو رمز PIN أو النمط لفتح صلاحية التوقيع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige Gerätepasswort, PIN oder Muster, um das Signieren freizugeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm your device password, PIN, or pattern to unlock signing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma la contraseña, el PIN o el patrón del dispositivo para habilitar la firma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای فعال کردن امضا، گذرواژه، PIN یا الگوی دستگاه را تأیید کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez le mot de passe, le code PIN ou le schéma de l’appareil pour autoriser la signature."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשרו את סיסמת המכשיר, קוד ה-PIN או התבנית כדי לפתוח את החתימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइनिंग चालू करने के लिए डिवाइस पासवर्ड, PIN या पैटर्न की पुष्टि करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmasikan kata sandi, PIN, atau pola perangkat untuk membuka penandatanganan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma password, PIN o sequenza del dispositivo per abilitare la firma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名を有効にするため、端末のパスワード、PIN、またはパターンを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명을 활성화하려면 기기 비밀번호, PIN 또는 패턴을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig het apparaatwachtwoord, de pincode of het patroon om ondertekenen in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdź hasło, PIN lub wzór urządzenia, aby włączyć podpisywanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme a palavra-passe, PIN ou padrão do dispositivo para ativar a assinatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите пароль, PIN-код или графический ключ устройства, чтобы разрешить подпись."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmzalamayı etkinleştirmek için cihaz parolasını, PIN’i veya deseni doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердьте пароль, PIN-код або графічний ключ пристрою, щоб дозволити підписування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận mật khẩu, PIN hoặc hình mở khóa của thiết bị để bật ký giao dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认设备密码、PIN 或图案以启用签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請確認裝置密碼、PIN 或圖形以啟用簽署。"
          }
        }
      }
    },
