        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تأییدیه را نمی‌توان به‌طور تمیز دور انداخت، بنابراین کیف پول قفل شد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’approbation ne pouvait pas être rejetée proprement, le portefeuille était donc verrouillé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לזרוק את האישור בצורה נקייה, ולכן הארנק היה נעול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमोदन को साफ-साफ खारिज नहीं किया जा सकता था, इसलिए वॉलेट लॉक कर दिया गया था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persetujuan tersebut tidak dapat dibuang begitu saja, sehingga dompet terkunci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile eliminare l'approvazione in modo netto, quindi il portafoglio era bloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認をきれいに破棄できなかったため、ウォレットがロックされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인을 깔끔하게 폐기할 수 없어 지갑이 잠겼습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De goedkeuring kon niet netjes worden weggegooid, dus de portemonnee zat op slot."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdzenia nie można było odrzucić w czysty sposób, więc portfel został zamknięty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprovação não pôde ser descartada de forma limpa, então a carteira foi trancada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобрение не удалось полностью отбросить, поэтому кошелек был заблокирован."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay temiz bir şekilde atılamadığı için cüzdan kilitlendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схвалення не можна було скасувати, тому гаманець був заблокований."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc phê duyệt không thể bị loại bỏ một cách sạch sẽ nên ví đã bị khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
