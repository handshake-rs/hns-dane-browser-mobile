    "wallet_swap_notification_channel_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديثات التمويل والاسترداد والاسترداد والإكمال القابلة للتنفيذ للمقايضات الذرية التي تم التحقق منها محليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umsetzbare Finanzierungs-, Einlösungs-, Rückerstattungs- und Abschlussaktualisierungen für lokal verifizierte Atom-Swaps."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Actionable funding, redemption, refund, and completion updates for locally verified atomic swaps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizaciones procesables de financiación, canje, reembolso y finalización para intercambios atómicos verificados localmente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌روزرسانی‌های تأمین مالی، بازخرید، بازپرداخت و تکمیل برای سوآپ‌های اتمی تأیید شده محلی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mises à jour concrètes du financement, du rachat, du remboursement et de l'achèvement des échanges atomiques vérifiés localement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכוני מימון, פדיון, החזר והשלמה ניתנים לפעולה עבור החלפות אטומיות מאומתות מקומית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय रूप से सत्यापित परमाणु स्वैप के लिए कार्रवाई योग्य फंडिंग, मोचन, धनवापसी और पूर्णता अद्यतन।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan pendanaan, penebusan, pengembalian dana, dan penyelesaian yang dapat ditindaklanjuti untuk pertukaran atom yang diverifikasi secara lokal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamenti attuabili su finanziamenti, rimborsi, rimborsi e completamento per atomic swap verificati localmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルで検証されたアトミック スワップの実用的な資金調達、償還、払い戻し、完了に関する最新情報。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현지에서 검증된 아토믹 스왑에 대한 실행 가능한 자금 조달, 상환, 환불 및 완료 업데이트."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruikbare updates voor financiering, aflossing, terugbetaling en voltooiing voor lokaal geverifieerde atomaire swaps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywne aktualizacje dotyczące finansowania, wykupu, zwrotu kosztów i zakończenia dla lokalnie zweryfikowanych swapów atomowych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizações acionáveis de financiamento, resgate, reembolso e conclusão para trocas atômicas verificadas localmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Практические обновления финансирования, погашения, возврата и завершения локально проверенных атомных свопов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel olarak doğrulanmış atom takasları için uygulanabilir finansman, itfa, geri ödeme ve tamamlama güncellemeleri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Актуальні оновлення щодо фінансування, викупу, відшкодування та завершення для локально підтверджених атомарних обмінів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
