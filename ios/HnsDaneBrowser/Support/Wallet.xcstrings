    "wallet_name_import_success_refresh_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تأكيد نتيجة الاستيراد في صفوف المحفظة الجديدة المطلوبة. تم قفل المحفظة ولم يتم نشر أي صف مستورد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Importergebnis konnte in den erforderlichen neuen Wallet-Zeilen nicht bestätigt werden. Das Wallet war gesperrt und es wurde keine importierte Zeile veröffentlicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The import result could not be confirmed in the required fresh wallet rows. The wallet was locked and no imported row was published."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado de la importación no se pudo confirmar en las nuevas filas de billetera requeridas. La billetera estaba bloqueada y no se publicó ninguna fila importada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نتیجه واردات در ردیف‌های کیف پول جدید مورد نیاز تأیید نشد. کیف پول قفل شد و ردیف وارداتی منتشر نشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de l'importation n'a pas pu être confirmé dans les nouvelles lignes de portefeuille requises. Le portefeuille était verrouillé et aucune ligne importée n'a été publiée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאשר את תוצאת הייבוא בשורות הארנק החדשות הנדרשות. הארנק היה נעול ולא פורסמה שורה מיובאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आवश्यक ताज़ा वॉलेट पंक्तियों में आयात परिणाम की पुष्टि नहीं की जा सकी। वॉलेट लॉक कर दिया गया था और कोई आयातित पंक्ति प्रकाशित नहीं की गई थी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil impor tidak dapat dikonfirmasi di baris dompet baru yang diperlukan. Dompet terkunci dan tidak ada baris impor yang dipublikasikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile confermare il risultato dell'importazione nelle righe del nuovo portafoglio richieste. Il portafoglio è stato bloccato e non è stata pubblicata alcuna riga importata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要な新しいウォレット行でインポート結果を確認できませんでした。ウォレットはロックされており、インポートされた行は公開されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필수 신규 지갑 행에서 가져오기 결과를 확인할 수 없습니다. 지갑이 잠겨 있고 가져온 행이 게시되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het importresultaat kon niet worden bevestigd in de vereiste nieuwe portefeuillerijen. De portemonnee is vergrendeld en er is geen geïmporteerde rij gepubliceerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się potwierdzić wyniku importu w wymaganych świeżych wierszach portfela. Portfel został zablokowany i nie opublikowano żadnego zaimportowanego wiersza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado da importação não pôde ser confirmado nas novas linhas exigidas da carteira. A carteira foi bloqueada e nenhuma linha importada foi publicada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат импорта не удалось подтвердить в необходимых строках нового кошелька. Кошелек был заблокирован, и импортированная строка не была опубликована."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarma sonucu gerekli yeni cüzdan satırlarında doğrulanamadı. M-cüzdan kilitlendi ve içe aktarılan satır yayınlanmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підтвердити результат імпорту в необхідних свіжих рядках гаманця. Гаманець було заблоковано, а імпортований рядок не опубліковано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác nhận kết quả nhập trong các hàng ví mới được yêu cầu. Ví đã bị khóa và không có hàng nhập nào được xuất bản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在所需的新钱包行中确认导入结果。钱包被锁定，没有发布导入的行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在所需的新錢包行中確認匯入結果。錢包被鎖定，沒有發布導入的行。"
          }
        }
      }
    },
    "wallet_name_import_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيراد الاسم الموثوق به غير متاح لأنه لا توجد واجهة خلفية لمحفظة نظير تم التحقق منها جاهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Import vertrauenswürdiger Namen ist nicht verfügbar, da kein verifiziertes Wallet-Peer-Backend bereit ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trusted name import is unavailable because no verified wallet peer backend is ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La importación de nombres confiables no está disponible porque no hay ningún backend de pares de billetera verificado listo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وارد کردن نام معتمد در دسترس نیست زیرا هیچ پشتیبان همتا کیف پول تأیید شده ای آماده نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’importation de noms de confiance n’est pas disponible car aucun backend de homologue de portefeuille vérifié n’est prêt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייבוא שם מהימן אינו זמין מכיוון שאין קצה אחורי של עמיתים מאומת של ארנק מוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विश्वसनीय नाम आयात अनुपलब्ध है क्योंकि कोई सत्यापित वॉलेट पीयर बैकएंड तैयार नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor nama tepercaya tidak tersedia karena tidak ada backend rekan dompet terverifikasi yang siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importazione del nome attendibile non è disponibile perché nessun backend peer del portafoglio verificato è pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検証済みのウォレットピアバックエンドの準備ができていないため、信頼できる名前のインポートは使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인된 지갑 피어 백엔드가 준비되지 않아 신뢰할 수 있는 이름 가져오기를 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het importeren van vertrouwde namen is niet beschikbaar omdat er geen geverifieerde portemonnee-peer-backend gereed is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Import zaufanych nazw jest niedostępny, ponieważ nie jest gotowy żaden zweryfikowany moduł równorzędny z portfelem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação de nomes confiáveis não está disponível porque nenhum back-end de peer de carteira verificado está pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт доверенных имен недоступен, поскольку ни один проверенный одноранговый сервер кошелька не готов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanmış cüzdan eş arka ucu hazır olmadığından güvenilir ad içe aktarımı kullanılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпорт довіреного імені недоступний, оскільки немає готового верифікованого однорангового сервера гаманця."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng nhập tên đáng tin cậy không khả dụng vì chưa có chương trình phụ trợ ngang hàng của ví đã được xác minh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可信名称导入不可用，因为没有已验证的钱包对等后端准备就绪。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可信任名稱導入不可用，因為沒有已驗證的錢包對等後端準備就緒。"
          }
        }
      }
    },
    "wallet_name_import_waiting_for_wallet": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وافتح محفظة محلية مؤكدة قبل استيراد الاسم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen und entsperren Sie eine bestätigte lokale Wallet, bevor Sie einen Namen importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open and unlock a confirmed local wallet before importing a name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra y desbloquee una billetera local confirmada antes de importar un nombre."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل از وارد کردن نام، یک کیف پول محلی تایید شده را باز کرده و آنلاک کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez et déverrouillez un portefeuille local confirmé avant d'importer un nom."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח ופתח את הנעילה של ארנק מקומי מאושר לפני ייבוא שם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम आयात करने से पहले एक पुष्टिकृत स्थानीय वॉलेट खोलें और अनलॉक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka dan buka kunci dompet lokal yang dikonfirmasi sebelum mengimpor nama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri e sblocca un portafoglio locale confermato prima di importare un nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前をインポートする前に、確認済みのローカルウォレットを開いてロックを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 가져오기 전에 확인된 로컬 지갑을 열고 잠금을 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open en ontgrendel een bevestigde lokale portemonnee voordat u een naam importeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz i odblokuj potwierdzony portfel lokalny przed zaimportowaniem nazwy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra e desbloqueie uma carteira local confirmada antes de importar um nome."
          }
        },
        "ru": {
          "stringUnit": {
