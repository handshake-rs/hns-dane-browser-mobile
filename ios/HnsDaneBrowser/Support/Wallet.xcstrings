          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể chuẩn bị gửi Bitcoin. Đồng bộ hóa ví Bitcoin và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
