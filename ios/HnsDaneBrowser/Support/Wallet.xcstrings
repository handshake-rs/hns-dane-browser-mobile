    "row_wallet_retry_direct_shakescape_host_summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد محاولة الاستماع على المنفذ 12038. لم تتغير حالة المحفظة والسلسلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie erneut, Port 12038 abzuhören. Wallet- und Chain-Status bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retry listening on port 12038. Wallet and chain state are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelva a intentar escuchar en el puerto 12038. El estado de la billetera y la cadena no cambia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دوباره سعی کنید در پورت 12038 گوش دهید. وضعیت کیف پول و زنجیره تغییری نکرده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réessayez d'écouter sur le port 12038. L'état du portefeuille et de la chaîne reste inchangé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נסה להאזין שוב ביציאה 12038. מצב הארנק והשרשרת לא השתנו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोर्ट 12038 पर सुनने का पुनः प्रयास करें। वॉलेट और चेन स्थिति अपरिवर्तित हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Coba lagi mendengarkan pada port 12038. Status dompet dan rantai tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprova ad ascoltare sulla porta 12038. Lo stato del portafoglio e della catena rimane invariato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポート 12038 でのリッスンを再試行します。ウォレットとチェーンの状態は変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트 12038에서 수신 대기를 다시 시도하세요. 지갑과 체인 상태는 변경되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer opnieuw te luisteren op poort 12038. De portemonnee- en ketenstatus zijn ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponów próbę nasłuchiwania na porcie 12038. Stan portfela i łańcucha pozostaje niezmieniony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tente escutar novamente na porta 12038. A carteira e o estado da cadeia permanecem inalterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторите попытку прослушивания порта 12038. Состояние кошелька и цепочки не изменились."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "12038 numaralı bağlantı noktasını dinlemeyi yeniden deneyin. Cüzdan ve zincir durumu değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторіть спробу прослуховування порту 12038. Гаманець і стан ланцюжка не змінені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử nghe lại trên cổng 12038. Trạng thái ví và chuỗi không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试监听12038端口，钱包和链状态不变。"
          }
