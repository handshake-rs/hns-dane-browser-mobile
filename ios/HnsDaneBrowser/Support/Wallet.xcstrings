    "wallet_bitcoin_send_approval_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستلم: \n%1$@\n\n المبلغ: %2$d sats\n الرسوم: %3$d sats\n الحد الأقصى للرسوم: %4$d sats\n تنتهي صلاحية الموافقة: %5$@\n\n يمكن بث هذه المعاملة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfänger:\n%1$@\n\nABetrag: %2$d sats\nGebühr: %3$d sats\nMaximale Gebühr: %4$d sats\nGenehmigung läuft ab: %5$@\n\nNur diese Transaktion kann gesendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipient:\n%1$@\n\nAmount: %2$d sats\nFee: %3$d sats\nMaximum fee: %4$d sats\nApproval expires: %5$@\n\nOnly this transaction can be broadcast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinatario:\n%1$@\n\nAmonto: %2$d sats\nTarifa: %3$d sats\nTarifa máxima: %4$d sats\nLa aprobación caduca: %5$@\n\nSolo se puede transmitir esta transacción."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گیرنده:\n%1$@\n\nمقدار: %2$d نشست\nکارمزد: %3$d نشست\nحداکثر کارمزد: %4$d جلسه\nتأیید منقضی می‌شود: %5$@\n\nفقط این تراکنش می تواند پخش شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinataire : \n%1$@\n\nAMontant : %2$d sats\nFrais : %3$d sats\nFrais maximum : %4$d sats\nAl'approbation expire : %5$@\n\nSeule cette transaction peut être diffusée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מְקַבֵּל:\n%1$@\n\nכמות: %2$d sats\nעמלה: %3$d sats\nעמלה מקסימלית: %4$d sats\nתוקף האישור יפוג: %5$@\n\nניתן לשדר רק עסקה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राप्तकर्ता:\n%1$@\n\nराशि: %2$d sats\nशुल्क: %3$d शनिवार\nअधिकतम शुल्क: %4$d sats\nअनुमोदन समाप्त हो रहा है: %5$@\n\nकेवल इस लेनदेन को प्रसारित किया जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerima:\n%1$@\n\nAJumlah: %2$d sats\nBiaya: %3$d sats\nBiaya maksimum: %4$d sats\nPersetujuan berakhir: %5$@\n\nHanya transaksi ini yang dapat disiarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinatario:\n%1$@\n\nAmount: %2$d sats\n Tariffa: %3$d sats\n Tariffa massima: %4$d sats\nL'approvazione scade: %5$@\n\nSolo questa transazione può essere trasmessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信者:\n%1$@\n\n金額: %2$d 飽和\n料金: %3$d 飽和\n最大料金: %4$d 飽和\n承認の有効期限が切れます: %5$@\n\nこのトランザクションのみをブロードキャストできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받는 사람:\n%1$@\n\n금액: %2$d sats\n수수료: %3$d sats\n최대 수수료: %4$d sats\n승인 만료: %5$@\n\n이 거래만 브로드캐스트할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvanger:\n%1$@\n\nAmount: %2$d sats\nVergoeding: %3$d sats\nMaximale vergoeding: %4$d sats\nGoedkeuring verloopt: %5$@\n\nAlleen deze transactie kan worden uitgezonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbiorca: \n%1$@\n\nAkwota: %2$d sats\nOpłata: %3$d sats\n Opłata maksymalna: %4$d sats\nAzatwierdzenie wygasa: %5$@\n\nTylko ta transakcja może być rozgłaszana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinatário:\n%1$@\n\nAQuantidade: %2$d sats\nTaxa: %3$d sats\nTaxa máxima: %4$d sats\nA aprovação expira: %5$@\n\nSomente esta transação pode ser transmitida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получатель:\n%1$@\n\nСумма: %2$d sats\nКомиссия: %3$d sats\nМаксимальная комиссия: %4$d sats\nСрок действия утверждения истек: %5$@\n\nТолько эта транзакция может быть широковещательной."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıcı:\n%1$@\n\nAmiktar: %2$d sats\nÜcret: %3$d sats\nMaksimum ücret: %4$d sats\nOnay süresi doluyor: %5$@\n\nYalnızca bu işlem yayınlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одержувач: \n%1$@\n\nAсума: %2$d sats\nКомісія: %3$d sats\nМаксимальна комісія: %4$d sats\nA Термін дії схвалення закінчився: %5$@\n\nТільки ця трансакція може транслюватися."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người nhận:\n%1$@\n\nASố tiền: %2$d sats\nPhí: %3$d sats\nPhí tối đa: %4$d sats\n Phê duyệt hết hạn: %5$@\n\nChỉ giao dịch này mới có thể được phát sóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收件人：\n%1$@\n\n金额：%2$d sats\n费用：%3$d sats\n最高费用： %4$d sats\n 审批过期：%5$@\n\n 只能广播此交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接受者：\n%1$@\n\n金額： %2$d週六\n費用： %3$d週六\n最高費用： %4$d sats\n批准到期： %5$@\n\n只有該交易才能被廣播。"
          }
        }
      }
    },
