    "wallet_send_approval_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المستلم: \n%1$@\n\n المبلغ: %2$@ HNS\n الحد الأقصى للرسوم: %3$@ HNS\nالنهاية: %4$@\n تحذير: %5$@\n انتهاء صلاحية الموافقة: %6$@\n\n يمكن بث هذه المعاملة فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfänger:\n%1$@\n\nABetrag: %2$@ HNS\nMaximale Gebühr: %3$@ HNS\nEndgültigkeit: %4$@\nWarnung: %5$@\nGenehmigung läuft ab: %6$@\n\nNur diese Transaktion kann gesendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipient:\n%1$@\n\nAmount: %2$@ HNS\nMaximum fee: %3$@ HNS\nFinality: %4$@\nWarning: %5$@\nApproval expires: %6$@\n\nOnly this transaction can be broadcast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinatario:\n%1$@\n\nAmonto: %2$@ HNS\nTarifa máxima: %3$@ HNS\nFinalidad: %4$@\nAdvertencia: %5$@\nLa aprobación caduca: %6$@\n\nSolo se puede transmitir esta transacción."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گیرنده:\n%1$@\n\nAمقدار: %2$@ HNS\nحداکثر کارمزد: %3$@\n %4$@\n هشدار: %5$@\nتأیید منقضی می‌شود: %6$@\n\n فقط این تراکنش قابل پخش است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinataire : \n%1$@\n\nAmontant : %2$@ HNS\nFrais maximum : %3$@ HNS\nFinalité : %4$@\nAvertissement : %5$@\nAl'approbation expire : %6$@\n\nSeule cette transaction peut être diffusée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מְקַבֵּל:\n%1$@\n\nסכום: %2$@ HNS\nעמלה מקסימלית: %3$@ HNS\nסופיות: %4$@\nאזהרה: %5$@\nתוקף האישור יפוג: %6$@\n\nניתן לשדר רק עסקה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राप्तकर्ता:\n%1$@\n\nराशि: %2$@ HNS\nअधिकतम शुल्क: %3$@ HNS\nअंतिमता: %4$@\nचेतावनी: %5$@\nअनुमोदन समाप्त हो रहा है: %6$@\n\nकेवल इस लेनदेन को प्रसारित किया जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerima:\n%1$@\n\nAJumlah: %2$@ HNS\nBiaya maksimum: %3$@ HNS\nFinalitas: %4$@\nPeringatan: %5$@\nPersetujuan berakhir: %6$@\n\nHanya transaksi ini yang dapat disiarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinatario:\n%1$@\n\nAMontaggio: %2$@ HNS\nCompenso massimo: %3$@ HNS\nFinale: %4$@\nAvviso: %5$@\nL'approvazione scade: %6$@\n\nSolo questa transazione può essere trasmessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信者:\n%1$@\n\n金額: %2$@ HNS\n最大料金: %3$@ HNS\nファイナリティ: %4$@\n警告: %5$@\n承認の有効期限が切れます: %6$@\n\nこのトランザクションのみをブロードキャストできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받는 사람:\n%1$@\n\n금액: %2$@ HNS\n최대 수수료: %3$@ HNS\n최종성: %4$@\n경고: %5$@\n승인 만료: %6$@\n\n이 거래만 브로드캐스트할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontvanger:\n%1$@\n\nAmount: %2$@ HNS\nMaximumbedrag: %3$@ HNS\nFinaliteit: %4$@\nWaarschuwing: %5$@\nGoedkeuring verloopt: %6$@\n\nOAlleen deze transactie kan worden uitgezonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbiorca: \n%1$@\n\nAkwota: %2$@ HNS\nMaksymalna opłata: %3$@ HNS\nOstateczność: %4$@\nOstrzeżenie: %5$@\nAzatwierdzenie wygasa: %6$@\n\nTylko ta transakcja może być rozgłaszana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Destinatário:\n%1$@\n\nAQuantidade: %2$@ HNS\nTaxa máxima: %3$@ HNS\nFinalidade: %4$@\nAviso: %5$@\nA aprovação expira: %6$@\n\nSomente esta transação pode ser transmitida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получатель: \n%1$@\n\n Сумма: %2$@ HNS\nМаксимальный сбор: %3$@ HNS\nОкончание: %4$@\nПредупреждение: %5$@\nСрок действия утверждения истекает: %6$@\n\nТолько эта транзакция может быть широковещательной."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıcı:\n%1$@\n\nAmiktarı: %2$@ HNS\nMaksimum ücret: %3$@ HNS\nSonluluk: %4$@\nUyarı: %5$@\nOnay süresi doluyor: %6$@\n\nYalnızca bu işlem yayınlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одержувач: \n%1$@\n\nAСума: %2$@ HNS\nМаксимальна комісія: %3$@ HNS\nЗакінченість: %4$@\nПопередження: %5$@\n Термін дії схвалення закінчується: %6$@\n\nТільки цю транзакцію можна транслювати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người nhận:\n%1$@\n\nASố tiền: %2$@ HNS\nPhí tối đa: %3$@ HNS\nFinality: %4$@\nCảnh báo: %5$@\n Phê duyệt hết hạn: %6$@\n\nChỉ giao dịch này mới có thể được phát sóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收件人：\n%1$@\n\n金额：%2$@ HNS\n最高费用：%3$@ HNS\n最终结果： %4$@\n警告：%5$@\n批准过期：%6$@\n\n只能广播此交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接受者：\n%1$@\n\n金額： %2$@ HNS\n最高費用： %3$@ HNS\n最終確定： %4$@\n警告： %5$@\n批准到期： %6$@\n\n只有該交易才能被廣播。"
          }
        }
      }
    },
