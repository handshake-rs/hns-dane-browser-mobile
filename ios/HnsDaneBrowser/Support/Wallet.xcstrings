    "wallet_swap_stage_funding_expired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت فترة التمويل · لا يُسمح بأي تمويل محلي جديد؛ يتم تحرير أي حجز محلي غير ممول، ويمكن استرداد قفل السلسلة الأولى الحالي بعد انتهاء المهلة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finanzierungsfenster abgelaufen · keine neue lokale Finanzierung zulässig; Jede nicht finanzierte lokale Reservierung wird freigegeben und eine bestehende Erstbuchungssperre kann nach Ablauf der Zeit erstattet werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Funding window expired · no new local funding is allowed; any unfunded local reservation is released, and an existing first-chain lock can be refunded after timeout"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plazo de financiación expiró · no se permite nueva financiación local; cualquier reserva local no financiada se libera y un candado de primera cadena existente se puede reembolsar después del tiempo de espera"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پنجره بودجه منقضی شده است · هیچ بودجه محلی جدیدی مجاز نیست. هرگونه رزرو محلی بدون بودجه آزاد می شود و قفل زنجیره اول موجود را می توان پس از اتمام زمان بازپرداخت کرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenêtre de financement expirée · aucun nouveau financement local n'est autorisé ; toute réservation locale non financée est libérée et un verrou de première chaîne existant peut être remboursé après expiration du délai"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פג תוקף חלון המימון · אין מימון מקומי חדש מותר; כל הזמנה מקומית ללא מימון משוחררת, וניתן לקבל החזר על מנעול שרשרת ראשון קיים לאחר הזמן הקצוב"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ंडिंग विंडो समाप्त हो गई · किसी नई स्थानीय फ़ंडिंग की अनुमति नहीं है; कोई भी गैर-वित्त पोषित स्थानीय आरक्षण जारी किया जाता है, और मौजूदा प्रथम-श्रृंखला लॉक को समय समाप्ति के बाद वापस किया जा सकता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangka waktu pendanaan telah habis · tidak ada pendanaan lokal baru yang diperbolehkan; setiap reservasi lokal yang tidak didanai akan dilepaskan, dan kunci rantai pertama yang ada dapat dikembalikan setelah batas waktu habis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il periodo di finanziamento è scaduto · non è consentito alcun nuovo finanziamento locale; qualsiasi prenotazione locale non finanziata viene rilasciata e un blocco della prima catena esistente può essere rimborsato dopo il timeout"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資金調達枠が期限切れになりました。新しいローカル資金調達は許可されません。資金のないローカル予約はすべて解放され、タイムアウト後に既存のファーストチェーン ロックを返金できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자금 조달 기간이 만료되었습니다. 새로운 지역 자금 조달은 허용되지 않습니다. 자금이 지원되지 않은 현지 예약은 해제되며 기존 첫 번째 체인 잠금은 시간 초과 후 환불될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Financieringstermijn verlopen · er is geen nieuwe lokale financiering toegestaan; elke niet-gefinancierde lokale reservering wordt vrijgegeven en een bestaand slot van de eerste keten kan na een time-out worden terugbetaald"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upłynął okres finansowania · żadne nowe finansowanie lokalne nie jest dozwolone; każda niesfinansowana rezerwacja lokalna zostaje zwolniona, a istniejąca blokada pierwszego łańcucha może zostać zwrócona po przekroczeniu limitu czasu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O período de financiamento expirou · nenhum novo financiamento local é permitido; qualquer reserva local não financiada será liberada e um bloqueio de primeira cadeia existente poderá ser reembolsado após o tempo limite"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно финансирования истекло · новое местное финансирование не допускается; любое необеспеченное местное резервирование снимается, а существующая блокировка первой цепи может быть возвращена после тайм-аута."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Finansman penceresinin süresi doldu · yeni yerel finansmana izin verilmiyor; Finanse edilmemiş herhangi bir yerel rezervasyon iptal edilir ve mevcut bir ilk zincir kilidi, zaman aşımından sonra iade edilebilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Період фінансування закінчився · нове місцеве фінансування не дозволяється; будь-яке нефінансоване локальне резервування скасовується, а наявне блокування першого ланцюга може бути відшкодовано після тайм-ауту"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời hạn cấp vốn đã hết · Không được phép cấp vốn mới tại địa phương; mọi đặt chỗ địa phương chưa được cấp vốn sẽ được giải phóng và khóa chuỗi đầu tiên hiện có có thể được hoàn lại sau khi hết thời gian chờ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资助窗口期满 · 不允许新的地方资助；任何未提供资金的本地预订都会被释放，并且现有的第一链锁可以在超时后退款"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "資助窗口期滿 · 不允許新的地方資助；任何未提供資金的本地預訂都會被釋放，並且現有的第一鏈鎖可以在超時後退款"
          }
        }
      }
    },
