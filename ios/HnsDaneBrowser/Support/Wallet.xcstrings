    "wallet_swap_hns_funding_prepare_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إعداد التمويل Handshake HTLC. يجب أولاً تأكيد قفل Bitcoin بشكل مستقل ويجب أن تظل الرسوم ضمن الاحتياطي الموقع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake HTLC Finanzierung wurde nicht vorbereitet. Die Bitcoin-Sperre muss zunächst unabhängig bestätigt werden und die Gebühr muss innerhalb der unterzeichneten Reserve bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake HTLC funding was not prepared. The Bitcoin lock must first be independently confirmed and the fee must remain within the signed reserve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake HTLC no se preparó la financiación. El candado Bitcoin primero debe confirmarse de forma independiente y la tarifa debe permanecer dentro de la reserva firmada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بودجه Handshake HTLC آماده نشد. قفل Bitcoin ابتدا باید به طور مستقل تأیید شود و هزینه باید در ذخیره امضا شده باقی بماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le financement Handshake HTLC n’a pas été préparé. Le verrou Bitcoin doit d'abord être confirmé indépendamment et les frais doivent rester dans la réserve signée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מימון Handshake HTLC לא הוכן. תחילה יש לאשר באופן עצמאי את המנעול Bitcoin והעמלה חייבת להישאר במסגרת העתודה החתומה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake HTLC फंडिंग तैयार नहीं की गई थी। Bitcoin लॉक को पहले स्वतंत्र रूप से पुष्टि की जानी चाहिए और शुल्क हस्ताक्षरित रिजर्व के भीतर रहना चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendanaan Handshake HTLC belum disiapkan. Kunci Bitcoin harus dikonfirmasi terlebih dahulu secara independen dan biayanya harus tetap dalam cadangan yang ditandatangani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake HTLC il finanziamento non è stato preparato. La serratura Bitcoin deve prima essere confermata in modo indipendente e la tariffa deve rimanere all'interno della riserva firmata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake HTLC 資金が準備されていませんでした。 Bitcoin ロックは最初に個別に確認される必要があり、料金は署名された準備金の範囲内にとどまる必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake HTLC 펀딩이 준비되지 않았습니다. Bitcoin 잠금 장치는 먼저 독립적으로 확인되어야 하며 수수료는 서명된 예비금 내에서 유지되어야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
