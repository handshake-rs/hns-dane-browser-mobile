    "wallet_swap_publish_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ولم يتم نشر العرض. ربما تغيرت حالة المحفظة والنظير؛ قم بمراجعة القوائم النشطة قبل إعادة المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Angebot wurde nicht veröffentlicht. Wallet- und Peer-Status haben sich möglicherweise geändert; Überprüfen Sie die aktiven Einträge, bevor Sie es erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The offer was not published. Wallet and peer state may have changed; review active listings before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La oferta no fue publicada. Es posible que el estado de la billetera y del par haya cambiado; revise los listados activos antes de volver a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پیشنهاد منتشر نشد. کیف پول و وضعیت همتا ممکن است تغییر کرده باشد. قبل از تلاش مجدد، فهرست های فعال را مرور کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'offre n'a pas été publiée. L’état du portefeuille et du homologue peut avoir changé ; examinez les annonces actives avant de réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההצעה לא פורסמה. ייתכן שמצב הארנק והעמית השתנו; סקור רישומים פעילים לפני שתנסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रस्ताव प्रकाशित नहीं किया गया था. वॉलेट और सहकर्मी स्थिति बदल गई होगी; पुनः प्रयास करने से पहले सक्रिय लिस्टिंग की समीक्षा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tawaran itu tidak dipublikasikan. Dompet dan status rekan mungkin telah berubah; tinjau daftar aktif sebelum mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'offerta non è stata pubblicata. Lo stato del portafoglio e del peer potrebbe essere cambiato; rivedere gli elenchi attivi prima di riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オファーは公開されていませんでした。ウォレットとピアの状態が変更された可能性があります。再試行する前に、アクティブなリストを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안이 게시되지 않았습니다. 지갑 및 피어 상태가 변경되었을 수 있습니다. 다시 시도하기 전에 활성 목록을 검토하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het aanbod is niet gepubliceerd. De portemonnee- en peerstatus zijn mogelijk gewijzigd; bekijk actieve vermeldingen voordat u het opnieuw probeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferta nie została opublikowana. Stan portfela i urządzenia równorzędnego mógł się zmienić; przejrzyj aktywne aukcje przed ponowną próbą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A oferta não foi publicada. O estado da carteira e do peer pode ter mudado; revise as listagens ativas antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложение не было опубликовано. Состояние кошелька и узла могло измениться; просмотрите активные объявления, прежде чем повторять попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teklif yayınlanmadı. Cüzdan ve eş durumu değişmiş olabilir; yeniden denemeden önce aktif listeleri inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропозиція не була опублікована. Гаманець і одноранговий стан могли змінитися; перед повторною спробою перегляньте активні списки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời đề nghị đã không được công bố. Trạng thái ví và ngang hàng có thể đã thay đổi; xem lại danh sách đang hoạt động trước khi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该报价尚未公布。钱包和对等状态可能已经改变；在重试之前查看活动列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該報價尚未公佈。錢包和對等狀態可能已經改變；在重試之前查看活動清單。"
          }
        }
      }
    },
