    "wallet_name_bulk_import_catching_up": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسماء %1$d المستوردة ذريًا. فهرسة الأسماء بدأت باللحاق بالركب؛ يبقى الرصيد الذي تم التحقق منه مسبقًا متاحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte %1$d-Namen atomar. Die Namensindizierung holt auf; das zuvor verifizierte Guthaben bleibt verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported %1$d names atomically. Name indexing is catching up; the previously verified balance remains available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres %1$d importados atómicamente. La indexación de nombres se está poniendo al día; el saldo previamente verificado permanece disponible."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام های %1$d به صورت اتمی وارد شده است. نمایه سازی نام در حال افزایش است. موجودی قبلاً تأیید شده در دسترس است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms %1$d importés de manière atomique. L'indexation des noms rattrape son retard ; le solde préalablement vérifié reste disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported %1$d names atomically. Name indexing is catching up; היתרה שאומתה בעבר נשארת זמינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परमाणु रूप से आयातित %1$d नाम। नाम अनुक्रमण तेजी पकड़ रहा है; पहले से सत्यापित शेष उपलब्ध रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama %1$d yang diimpor secara atom. Pengindeksan nama sedang mengejar; saldo yang diverifikasi sebelumnya tetap tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomi %1$d importati atomicamente. L’indicizzazione dei nomi sta recuperando terreno; resta disponibile il saldo precedentemente verificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d 名をアトミックにインポートしました。名前のインデックス作成も追いつきつつあります。以前に確認された残高は引き続き利用可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d 이름을 원자적으로 가져왔습니다. 이름 인덱싱이 따라잡고 있습니다. 이전에 확인된 잔액은 계속 사용 가능합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d-namen atomair geïmporteerd. Naamindexering is bezig met een inhaalslag; het eerder geverifieerde saldo blijft beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportowane nazwy %1$d niepodzielnie. Indeksowanie nazw nadrabia zaległości; wcześniej zweryfikowane saldo pozostaje dostępne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes %1$d importados atomicamente. A indexação de nomes está se atualizando; o saldo previamente verificado permanece disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена %1$d импортированы атомарно. Индексация имен набирает обороты; ранее проверенный баланс остается доступным."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d adları atomik olarak içe aktarıldı. Ad indeksleme yetişiyor; önceden doğrulanan bakiye mevcut kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортовані назви %1$d атомарно. Індексація імен наздоганяє; Раніше перевірений баланс залишається доступним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã nhập tên %1$d nguyên tử. Việc lập chỉ mục tên đang bắt kịp; số dư đã được xác minh trước đó vẫn có sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以原子方式导入 %1$d 名称。名称索引正在迎头赶上；之前验证的余额仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以原子方式導入 %1$d 名稱。名稱索引正在迎頭趕上；先前驗證的餘額仍然可用。"
          }
        }
      }
    },
