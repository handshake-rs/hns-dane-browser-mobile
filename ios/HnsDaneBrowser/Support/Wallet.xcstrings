    "wallet_swap_approval_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض %1$d sats لـ %2$@ HNS. احتياطي الرسوم: حتى %3$d sats. إجمالي القفل: %4$d sats. انتهاء الصلاحية: %5$@. نشر يشارك الشروط ولكن لا يمول المقايضة. يتطلب التمويل موافقة منفصلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angebot %1$d sats für %2$@ HNS. Gebührenreserve: bis %3$d sats. Insgesamt gesperrt: %4$d sats. Gültig bis: %5$@. Publishing teilt die Bedingungen mit, finanziert den Tausch jedoch nicht. Eine Förderung bedarf einer gesonderten Genehmigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offer %1$d sats for %2$@ HNS. Fee reserve: up to %3$d sats. Total locked: %4$d sats. Expires: %5$@. Publishing shares the terms but does not fund the swap. Funding requires separate approval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferta %1$d sats por %2$@ HNS. Reserva de cuota: hasta %3$d sats. Total bloqueado: %4$d sats. Vence: %5$@. La publicación comparte los términos pero no financia el intercambio. La financiación requiere aprobación por separado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشنهاد %1$d sats برای %2$@ HNS. ذخیره هزینه: حداکثر %3$d sats. کل قفل شده: %4$d sats. منقضی می شود: %5$@. انتشار شرایط را به اشتراک می گذارد اما مبادله را تامین مالی نمی کند. تأمین مالی نیاز به تأیید جداگانه دارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offre %1$d sats pour %2$@ HNS. Réserve de frais : jusqu'à %3$d sats. Total verrouillé : %4$d sats. Expire : %5$@. Publishing partage les conditions mais ne finance pas l’échange. Le financement nécessite une approbation distincte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצע %1$d sats עבור %2$@ HNS. רזרבה לתשלום: עד %3$d sats. סך הכל נעול: %4$d sats. פג תוקף: %5$@. הוצאה לאור חולקת את התנאים אך אינה מממנת את ההחלפה. המימון דורש אישור נפרד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ HNS के लिए %1$d sats ऑफर करें। शुल्क आरक्षित: %3$d sats तक। कुल लॉक: %4$d sats। समाप्ति: %5$@. प्रकाशन शर्तें साझा करता है लेकिन स्वैप को निधि नहीं देता है। फंडिंग के लिए अलग से मंजूरी की आवश्यकता होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tawarkan %1$d sats untuk %2$@ HNS. Cadangan biaya: hingga %3$d sats. Total terkunci: %4$d sats. Kedaluwarsa: %5$@. Penerbitan membagikan persyaratannya tetapi tidak mendanai pertukaran. Pendanaan memerlukan persetujuan terpisah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Offerta %1$d sats per %2$@ HNS. Riserva tariffa: fino a %3$d sats. Bloccato totale: %4$d sats. Scadenza: %5$@. La pubblicazione condivide i termini ma non finanzia lo scambio. Il finanziamento richiede un'approvazione separata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ HNS には %1$d sats を提供します。料金保留: %3$d sats まで。合計ロック: %4$d sats。有効期限: %5$@。パブリッシングは条件を共有しますが、スワップに資金を提供しません。資金提供には別途承認が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ HNS에 대해 %1$d sats를 제공합니다. 수수료 예치금: 최대 %3$d sats. 전체 잠김: %4$d sats. 만료: %5$@. 게시는 조건을 공유하지만 스왑에 자금을 지원하지는 않습니다. 펀딩에는 별도의 승인이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanbieding %1$d sats voor %2$@ HNS. Kostenreservering: tot %3$d sats. Totaal vergrendeld: %4$d sats. Verloopt: %5$@. Publishing deelt de voorwaarden, maar financiert de ruil niet. Voor financiering is aparte goedkeuring vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferta %1$d sats dla %2$@ HNS. Rezerwa opłat: do %3$d sats. Razem zablokowane: %4$d sats. Wygasa: %5$@. Wydawnictwo udostępnia warunki, ale nie finansuje zamiany. Finansowanie wymaga osobnej zgody."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferta %1$d sats para %2$@ HNS. Reserva de taxa: até %3$d sats. Total bloqueado: %4$d sats. Expira em: %5$@. A publicação compartilha os termos, mas não financia a troca. O financiamento requer aprovação separada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложите %1$d sats за %2$@ HNS. Резерв комиссии: до %3$d sats. Всего заблокировано: %4$d sats. Срок действия истекает: %5$@. Издательство разделяет условия, но не финансирует обмен. Финансирование требует отдельного одобрения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ HNS için %1$d sats teklifini verin. Ücret rezervi: %3$d sats'ye kadar. Tamamen kilitli: %4$d sats. Son kullanma tarihi: %5$@. Publishing, şartları paylaşır ancak takası finanse etmez. Finansman ayrı bir onay gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропозиція %1$d sats для %2$@ HNS. Резерв комісії: до %3$d sats. Всього заблоковано: %4$d sats. Термін дії закінчується: %5$@. Видавництво поділяє умови, але не фінансує обмін. Фінансування вимагає окремого погодження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cung cấp %1$d sats cho %2$@ HNS. Dự trữ phí: lên tới %3$d sats. Tổng số bị khóa: %4$d sats. Hết hạn: %5$@. Việc xuất bản chia sẻ các điều khoản nhưng không tài trợ cho việc hoán đổi. Việc tài trợ cần có sự phê duyệt riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 %2$@ HNS 提供 %1$d sats。费用预留：最高为%3$d sats。总锁定：%4$d sats。过期：%5$@。出版公司同意这些条款，但不为交换提供资金。资金需要单独批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提供 %2$@ HNS %1$d sats。費用預留：最高為%3$d sats。總鎖定：%4$d sats。過期：%5$@。出版公司同意這些條款，但不為交換提供資金。資金需要單獨批准。"
          }
        }
      }
    },
