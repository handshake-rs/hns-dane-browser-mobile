          "stringUnit": {
            "state": "translated",
            "value": "किसी भी वॉलेट रीड बैकएंड को स्थापित करने से पहले पुनर्प्राप्ति बैकअप की पुष्टि करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmasikan cadangan pemulihan sebelum backend pembacaan dompet apa pun dapat diinstal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confermare il backup di ripristino prima di poter installare qualsiasi backend di lettura del portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレット読み取りバックエンドをインストールする前に、リカバリ バックアップを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑 읽기 백엔드를 설치하기 전에 복구 백업을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig de herstelback-up voordat een portemonnee-lees-backend kan worden geïnstalleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdź kopię zapasową odzyskiwania, zanim będzie można zainstalować moduł odczytu portfela."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme o backup de recuperação antes que qualquer back-end de leitura de carteira possa ser instalado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите резервную копию для восстановления, прежде чем можно будет установить какой-либо сервер чтения кошелька."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir cüzdan okuma arka ucunun kurulabilmesi için kurtarma yedeğini onaylayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердьте резервну копію для відновлення, перш ніж можна буде встановити будь-який бекенд для читання гаманця."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận bản sao lưu khôi phục trước khi có thể cài đặt bất kỳ chương trình phụ trợ đọc ví nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在安装任何钱包读取后端之前确认恢复备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在安裝任何錢包讀取後端之前確認恢復備份。"
          }
        }
      }
    },
    "wallet_reads_refresh_failed_retained": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل التحديث. يظل آخر رصيد تم التحقق منه مرئيًا ولكن لا يمكن إنفاقه. مزامنة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Update fehlgeschlagen. Der zuletzt verifizierte Saldo bleibt sichtbar, kann aber nicht ausgegeben werden. Erneut synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update failed. The last verified balance remains visible but cannot be spent. Synchronize again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización falló. El último saldo verificado permanece visible pero no se puede gastar. Sincronizar nuevamente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به روز رسانی انجام نشد. آخرین موجودی تأیید شده قابل مشاهده است اما نمی توان آن را خرج کرد. دوباره همگام سازی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à jour a échoué. Le dernier solde vérifié reste visible mais ne peut être dépensé. Synchronisez à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העדכון נכשל. היתרה המאומתת האחרונה נשארת גלויה אך לא ניתן לנצל אותה. סנכרן שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अद्यतन विफल रहा. अंतिम सत्यापित शेष दृश्यमान रहता है लेकिन खर्च नहीं किया जा सकता। पुनः सिंक्रनाइज़ करें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan gagal. Saldo terverifikasi terakhir tetap terlihat tetapi tidak dapat dibelanjakan. Sinkronkan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamento non riuscito. L'ultimo saldo verificato rimane visibile ma non può essere speso. Sincronizza di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートに失敗しました。最後に確認された残高は表示されたままですが、使用することはできません。再度同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트에 실패했습니다. 마지막으로 확인된 잔액은 계속 표시되지만 사용할 수는 없습니다. 다시 동기화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Update mislukt. Het laatst geverifieerde saldo blijft zichtbaar maar kan niet worden uitgegeven. Synchroniseer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizacja nie powiodła się. Ostatnie zweryfikowane saldo pozostaje widoczne, ale nie można go wydać. Zsynchronizuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na atualização. O último saldo verificado permanece visível, mas não pode ser gasto. Sincronize novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление не удалось. Последний подтвержденный баланс остается видимым, но его нельзя потратить. Синхронизируйте еще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güncelleme başarısız oldu. Son doğrulanan bakiye görünür durumda kalır ancak harcanamaz. Tekrar senkronize edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Помилка оновлення. Останній перевірений баланс залишається видимим, але його не можна витратити. Знову синхронізувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật không thành công. Số dư được xác minh cuối cùng vẫn hiển thị nhưng không thể chi tiêu. Đồng bộ hóa lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新失败。最后验证的余额仍然可见，但无法花费。再次同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更新失敗。最後驗證的餘額仍然可見，但無法花費。再次同步。"
          }
        }
      }
    },
    "wallet_reads_swap_reserved": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS محجوز من خلال التزامات المقايضة النشطة أو غير الممولة\n%2$@ HNS متاح بعد حجوزات المبادلة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS reserviert durch aktive oder nicht finanzierte Swap-Verpflichtungen\n%2$@ HNS verfügbar nach Swap-Reservierungen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS reserved by active or unfunded swap commitments\n%2$@ HNS available after swap reservations"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS reservado por compromisos de swap activos o no financiados\n%2$@ HNS disponible después de reservas de swap"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS توسط تعهدات مبادله فعال یا بدون بودجه رزرو شده است\n%2$@ HNS پس از رزرو تعویض در دسترس است"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS réservé par des engagements de swap actifs ou non financés\n%2$@ HNS disponible après les réservations de swap"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS שמורה על ידי התחייבויות החלפה פעילות או ללא מימון \n%2$@ HNS זמינה לאחר הזמנות החלפה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS सक्रिय या गैर-वित्त पोषित स्वैप प्रतिबद्धताओं द्वारा आरक्षित\n%2$@ HNS स्वैप आरक्षण के बाद उपलब्ध है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS dicadangkan berdasarkan komitmen swap aktif atau tidak didanai\n%2$@ HNS tersedia setelah reservasi swap"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS riservato tramite impegni di swap attivi o non finanziati\n%2$@ HNS disponibile dopo le prenotazioni di swap"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS はアクティブまたは未資金のスワップ コミットメントによって予約されています\n%2$@ HNS はスワップ予約後に利用可能です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 또는 미지원 스왑 약정으로 예약된 %1$@ HNS\n%2$@ HNS 스왑 예약 후 사용 가능"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS gereserveerd door actieve of niet-gefinancierde swapverplichtingen\n%2$@ HNS beschikbaar na swapreserveringen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS zarezerwowane przez aktywne lub niefinansowane zobowiązania do swapu\n%2$@ HNS dostępne po rezerwacji swapu"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS reservado por compromissos de swap ativos ou não financiados\n%2$@ HNS disponível após reservas de swap"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS зарезервировано активными или необеспеченными обязательствами по свопу \n%2$@ HNS доступно после резервирования по свопу"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS aktif veya finansmansız takas taahhütleri ile ayrılmıştır\n%2$@ HNS takas rezervasyonlarından sonra mevcuttur"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS зарезервовано активними або незабезпеченими зобов’язаннями обміну \n%2$@ HNS доступно після резервування свопу"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS được đặt trước theo cam kết hoán đổi đang hoạt động hoặc chưa được cấp vốn\n%2$@ HNS có sẵn sau khi đặt trước hoán đổi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS 由有效或无资金的掉期承诺预留\n%2$@ HNS 在掉期预留后可用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS 由有效或無資金的掉期承諾預留\n%2$@ HNS 在掉期預留後可用"
          }
        }
      }
    },
    "wallet_reads_sync_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تكتمل مزامنة HNS. يظل الرصيد والإرسال غير متاحين؛ تظل المحفظة مفتوحة ويمكنها إعادة محاولة التحقق المباشر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS-Synchronisierung wurde nicht abgeschlossen. Guthaben und Versand sind weiterhin nicht verfügbar; Das Wallet bleibt entsperrt und kann die direkte Verifizierung erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS synchronization did not complete. Balance and sending remain unavailable; the wallet stays unlocked and can retry direct verification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización HNS no se completó. El saldo y el envío siguen no disponibles; la billetera permanece desbloqueada y puede volver a intentar la verificación directa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همگام سازی HNS کامل نشد. موجودی و ارسال در دسترس باقی می ماند. کیف پول باز می ماند و می تواند تأیید مستقیم را دوباره امتحان کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation HNS n’a pas été terminée. Le solde et l'envoi restent indisponibles ; le portefeuille reste déverrouillé et peut réessayer la vérification directe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סנכרון HNS לא הושלם. היתרה והשליחה נשארים לא זמינים; הארנק נשאר לא נעול ויכול לנסות שוב אימות ישיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS सिंक्रोनाइज़ेशन पूरा नहीं हुआ। शेष राशि और भेजना अनुपलब्ध रहता है; वॉलेट अनलॉक रहता है और सीधे सत्यापन का पुनः प्रयास कर सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronisasi HNS tidak selesai. Saldo dan pengiriman tetap tidak tersedia; dompet tetap tidak terkunci dan dapat mencoba kembali verifikasi langsung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione HNS non è stata completata. Il saldo e l'invio rimangono non disponibili; il portafoglio rimane sbloccato e può riprovare la verifica diretta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 同期が完了しませんでした。残高と送信は引き続き利用できません。ウォレットはロックが解除されたままになり、直接検証を再試行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 동기화가 완료되지 않았습니다. 잔액 및 송금은 계속 사용할 수 없습니다. 지갑은 잠금 해제된 상태로 유지되며 직접 확인을 다시 시도할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS-synchronisatie is niet voltooid. Saldo en verzending blijven onbeschikbaar; de portemonnee blijft ontgrendeld en kan de directe verificatie opnieuw proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja HNS nie została ukończona. Saldo i wysyłanie pozostają niedostępne; portfel pozostaje odblokowany i może ponowić próbę bezpośredniej weryfikacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização HNS não foi concluída. Saldo e envio permanecem indisponíveis; a carteira permanece desbloqueada e pode tentar novamente a verificação direta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация HNS не завершена. Баланс и отправка остаются недоступными; кошелек остается разблокированным и может повторить попытку прямой проверки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS senkronizasyonu tamamlanmadı. Bakiye ve gönderim kullanılamıyor; cüzdanın kilidi açık kalır ve doğrudan doğrulamayı yeniden deneyebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізацію HNS не завершено. Баланс і відправлення залишаються недоступними; гаманець залишається розблокованим і може повторити пряму перевірку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ hóa HNS không hoàn tất. Số dư và gửi vẫn không khả dụng; ví vẫn được mở khóa và có thể thử xác minh lại trực tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 同步未完成。余额和发送仍然不可用；钱包保持解锁状态，可以重试直接验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 同步未完成。餘額和發送仍然不可用；錢包保持解鎖狀態，可以重試直接驗證。"
          }
        }
      }
    },
    "wallet_reads_sync_stopped_checkpoint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت مزامنة HNS. تم الاحتفاظ بآخر نقطة تفتيش دائمة مكتملة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS-Synchronisierung gestoppt. Der letzte fertiggestellte dauerhafte Kontrollpunkt wurde beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS synchronization stopped. The last completed durable checkpoint was retained."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS se detuvo la sincronización. Se mantuvo el último puesto de control duradero terminado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همگام سازی HNS متوقف شد. آخرین ایست بازرسی بادوام تکمیل شده حفظ شد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation HNS s'est arrêtée. Le dernier point de contrôle durable réalisé a été retenu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סנכרון HNS הופסק. המחסום העמיד האחרון שהושלם נשמר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS सिंक्रोनाइज़ेशन बंद हो गया। अंतिम पूर्ण टिकाऊ चौकी को बरकरार रखा गया था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronisasi HNS terhenti. Pos pemeriksaan tahan lama terakhir yang diselesaikan dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS sincronizzazione interrotta. L'ultimo checkpoint durevole completato è stato mantenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 同期が停止しました。最後に完了した永続チェックポイントが保持されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 동기화가 중지되었습니다. 마지막으로 완료된 지속성 체크포인트가 유지되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS-synchronisatie gestopt. Het laatst voltooide duurzame controlepunt bleef behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja HNS została zatrzymana. Ostatni ukończony trwały punkt kontrolny został zachowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização HNS foi interrompida. O último ponto de verificação durável concluído foi mantido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация HNS остановлена. Последний завершенный прочный контрольно-пропускной пункт был сохранен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS senkronizasyonu durduruldu. Tamamlanan son dayanıklı kontrol noktası muhafaza edildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізацію HNS зупинено. Останню завершену довговічну КПП було збережено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ hóa HNS đã dừng. Điểm kiểm tra bền vững đã hoàn thành cuối cùng được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 同步已停止。最后完成的持久检查点被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 同步已停止。最後完成的持久檢查點被保留。"
          }
        }
      }
    },
