          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri e sblocca un portafoglio confermato prima di inviare HNS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS を送信する前に、確認済みのウォレットを開いてロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS를 보내기 전에 확인된 지갑을 열고 잠금을 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open en ontgrendel een bevestigde portemonnee voordat u HNS verzendt."
          }
        },
        "pl": {
          "stringUnit": {
