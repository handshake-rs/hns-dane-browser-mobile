    "wallet_name_import_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل استيراد الاسم مغلق. أعد فتح المحفظة وفتحها قبل إعادة المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namenimport fehlgeschlagen. Schließen. Öffnen Sie die Brieftasche erneut und entsperren Sie sie, bevor Sie es erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name import failed closed. Reopen and unlock the wallet before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al importar el nombre cerrado. Vuelva a abrir y desbloquear la billetera antes de volver a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وارد کردن نام بسته نشد. قبل از تلاش مجدد کیف پول را دوباره باز کنید و قفل آن را باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importation du nom a échoué. Rouvrez et déverrouillez le portefeuille avant de réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייבוא השמות נכשל בסגירה. פתח מחדש ופתח את הנעילה של הארנק לפני שתנסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम आयात विफल बंद हुआ. पुनः प्रयास करने से पहले वॉलेट को दोबारा खोलें और अनलॉक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor nama gagal ditutup. Buka kembali dan buka kunci dompet sebelum mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'importazione del nome non è riuscita a chiudersi. Riapri e sblocca il portafoglio prima di riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前のインポートが失敗して閉じられました。再試行する前に、ウォレットを再度開いてロックを解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름 가져오기가 실패하여 종료되었습니다. 다시 시도하기 전에 지갑을 다시 열고 잠금을 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naamimport mislukt, gesloten. Open en ontgrendel de portemonnee opnieuw voordat u het opnieuw probeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Import nazwy nie powiódł się, został zamknięty. Otwórz ponownie i odblokuj portfel przed ponowną próbą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A importação de nome falhou ao fechar. Reabra e desbloqueie a carteira antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось импортировать имя. Закрытие. Прежде чем повторить попытку, снова откройте и разблокируйте кошелек."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad içe aktarma işlemi kapatılamadı. Yeniden denemeden önce cüzdanı yeniden açın ve kilidini açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося імпортувати ім’я закрито. Відкрийте та розблокуйте гаманець перед повторною спробою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập tên không thành công đã đóng. Mở lại và mở khóa ví trước khi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
