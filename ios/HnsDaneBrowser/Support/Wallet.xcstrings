    "wallet_swap_take_reserved_btc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج هذا العرض إلى %1$d sats؛ تم تأكيد المحفظة %2$d، لكن المقايضات الأخرى تحتفظ كثيرًا. قم بتحرير قبول غير ممول، أو إنهاء المبادلة أو استردادها، أو إضافة Bitcoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Angebot erfordert %1$d sats; Das Wallet hat %2$d bestätigt, aber andere Swaps reservieren zu viel. Geben Sie eine nicht finanzierte Annahme frei, beenden oder erstatten Sie einen Tausch oder fügen Sie Bitcoin hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This offer needs %1$d sats; the wallet has %2$d confirmed, but other swaps reserve too much. Release an unfunded acceptance, finish or refund a swap, or add Bitcoin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta oferta necesita %1$d sats; la billetera tiene confirmado %2$d, pero otros swaps reservan demasiado. Libere una aceptación no financiada, finalice o reembolse un intercambio, o agregue Bitcoin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پیشنهاد به %1$d sats نیاز دارد. کیف پول دارای %2$d تایید شده است، اما سایر مبادلات بیش از حد ذخیره می کنند. یک پذیرش بدون بودجه را منتشر کنید، یک مبادله را تکمیل یا بازپرداخت کنید، یا Bitcoin را اضافه کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette offre nécessite %1$d sats ; le portefeuille a confirmé %2$d, mais d'autres swaps réservent trop. Libérez une acceptation non financée, terminez ou remboursez un échange, ou ajoutez Bitcoin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצעה זו צריכה %1$d sats; לארנק יש אישור %2$d, אבל החלפות אחרות שומרות יותר מדי. שחרר קבלה ללא מימון, סיים או החזר החלפה, או הוסף Bitcoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ऑफर के लिए %1$d sats की आवश्यकता है; वॉलेट में %2$d की पुष्टि की गई है, लेकिन अन्य स्वैप बहुत अधिक आरक्षित हैं। एक अनिधिकृत स्वीकृति जारी करें, एक स्वैप समाप्त करें या वापस करें, या Bitcoin जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penawaran ini membutuhkan %1$d sats; dompet telah mengkonfirmasi %2$d, tetapi swap lainnya memiliki terlalu banyak cadangan. Lepaskan penerimaan yang tidak didanai, selesaikan atau kembalikan dana swap, atau tambahkan Bitcoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa offerta richiede %1$d sats; il portafoglio ha %2$d confermato, ma altri scambi riservano troppo. Rilascia un'accettazione non finanziata, completa o rimborsa uno scambio oppure aggiungi Bitcoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオファーには %1$d sats が必要です。ウォレットには%2$dが確認されていますが、他のスワップの予約が多すぎます。未入金の受け入れを解除するか、スワップを終了または返金するか、Bitcoin を追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제안에는 %1$d sats가 필요합니다. 지갑에 %2$d가 확인되었지만 다른 스왑은 너무 많이 보유하고 있습니다. 자금이 지원되지 않은 수락을 해제하거나, 스왑을 완료 또는 환불하거나, Bitcoin를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze aanbieding is %1$d sats nodig; de portemonnee heeft %2$d bevestigd, maar andere swaps reserveren te veel. Geef een niet-gefinancierde acceptatie vrij, voltooi een ruil of betaal deze terug, of voeg Bitcoin toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta oferta wymaga %1$d sats; portfel ma potwierdzone %2$d, ale inne swapy rezerwują za dużo. Zwolnij akceptację bez środków, zakończ wymianę lub zwróć pieniądze albo dodaj Bitcoin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta oferta precisa de %1$d sats; a carteira tem %2$d confirmado, mas outros swaps reservam muito. Libere uma aceitação sem financiamento, finalize ou reembolse uma troca ou adicione Bitcoin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого предложения требуется %1$d sats; в кошельке подтвержден %2$d, но другие свопы резервируют слишком много. Отпустите необеспеченный акцепт, завершите или возместите своп или добавьте Bitcoin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu teklifin %1$d sats'ye ihtiyacı vardır; cüzdanda %2$d onaylandı ancak diğer swaplar çok fazla rezerve ediyor. Finanse edilmemiş bir kabulü iptal edin, takas işlemini tamamlayın veya iade edin ya da Bitcoin ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї пропозиції потрібен %1$d sats; гаманець підтвердив %2$d, але інші свопи резервують занадто багато. Відпустіть нефінансований акцепт, завершіть або відшкодуйте обмін або додайте Bitcoin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ưu đãi này cần %1$d sats; ví đã xác nhận %2$d nhưng các giao dịch hoán đổi khác dự trữ quá nhiều. Phát hành chấp nhận không được cấp vốn, hoàn thành hoặc hoàn lại tiền hoán đổi hoặc thêm Bitcoin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此报价需要%1$d sats；钱包已确认%2$d，但其他掉期储备太多。释放无资金支持的承兑，完成或退款掉期，或添加 Bitcoin。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此報價需要%1$d sats；皮夾已確認%2$d，但其他掉期儲備太多。釋放無資金支持的承兌，完成或退款掉期，或增加 Bitcoin。"
          }
        }
      }
    },
