        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS भेजने से पहले एक पुष्टिकृत वॉलेट खोलें और अनलॉक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
