        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send and Receive are temporarily unavailable while the outgoing transaction is pending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar y Recibir no están disponibles temporalmente mientras la transacción saliente está pendiente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا زمانی که تراکنش خروجی در انتظار است، ارسال و دریافت موقتاً در دسترس نیستند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'envoi et la réception sont temporairement indisponibles pendant que la transaction sortante est en attente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שלח וקבלה אינם זמינים באופן זמני בזמן שהעסקה היוצאת בהמתנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आउटगोइंग लेनदेन लंबित होने पर भेजें और प्राप्त करें अस्थायी रूप से अनुपलब्ध हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirim dan Terima untuk sementara tidak tersedia saat transaksi keluar tertunda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia e Ricevi sono temporaneamente non disponibili mentre la transazione in uscita è in sospeso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信トランザクションが保留されている間は、送信と受信は一時的に利用できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나가는 거래가 보류 중인 동안에는 보내기 및 받기를 일시적으로 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzenden en ontvangen zijn tijdelijk niet beschikbaar terwijl de uitgaande transactie in behandeling is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Funkcje Wysyłanie i Odbieranie są chwilowo niedostępne, gdy transakcja wychodząca jest w toku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar e Receber ficam temporariamente indisponíveis enquanto a transação de saída está pendente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка и получение временно недоступны, пока исходящая транзакция находится в состоянии ожидания."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Giden işlem beklemedeyken Gönder ve Al geçici olarak kullanılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надсилання й отримання тимчасово недоступні, поки вихідна транзакція очікує на розгляд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gửi và Nhận tạm thời không khả dụng trong khi giao dịch gửi đi đang chờ xử lý."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当传出交易待处理时，发送和接收暂时不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當傳出交易待處理時，發送和接收暫時無法使用。"
          }
        }
      }
    },
    "wallet_pending_outgoing_balance_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصفقة معلقة. سيتم إرجاع الرصيد المتزامن بعد تسوية المعاملة الصادرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktion ausstehend. Der synchronisierte Saldo wird zurückgegeben, nachdem die ausgehende Transaktion abgewickelt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction pending. The synchronized balance will return after the outgoing transaction is settled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacción pendiente. El saldo sincronizado volverá después de que se liquide la transacción saliente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "معامله در انتظار موجودی همگام شده پس از تسویه تراکنش خروجی باز خواهد گشت."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction en attente. Le solde synchronisé reviendra une fois la transaction sortante réglée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה בהמתנה. היתרה המסונכרנת תחזור לאחר סילוק העסקה היוצאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेन-देन लंबित है. आउटगोइंग लेनदेन के निपटारे के बाद सिंक्रोनाइज्ड बैलेंस वापस आ जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi tertunda. Saldo tersinkronisasi akan kembali setelah transaksi keluar diselesaikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Transazione in sospeso. Il saldo sincronizzato verrà restituito dopo il saldo della transazione in uscita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランザクションは保留中です。同期された残高は、送信トランザクションが決済された後に返されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 보류 중입니다. 나가는 거래가 정산된 후 동기화된 잔액이 반환됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactie in behandeling. Het gesynchroniseerde saldo keert terug nadat de uitgaande transactie is vereffend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja oczekująca. Saldo zsynchronizowane powróci po rozliczeniu transakcji wychodzącej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Transação pendente. O saldo sincronizado retornará após a liquidação da transação de saída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидается транзакция. Синхронизированный баланс вернется после урегулирования исходящей транзакции."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem beklemede. Senkronize bakiye, yapılan işlem tamamlandıktan sonra geri dönecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансакція очікує на розгляд. Синхронізований баланс повернеться після розрахунку вихідної транзакції."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch đang chờ xử lý. Số dư được đồng bộ hóa sẽ trở lại sau khi giao dịch gửi đi được giải quyết."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易待处理。对外交易结算后，同步余额将返回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易待處理。對外交易結算後，同步餘額將返回。"
          }
        }
      }
    },
    "wallet_pending_outgoing_recovery": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصفقة معلقة. قم بالمزامنة بعد كتلة Handshake جديدة حتى يتمكن Shakescape من تسوية المعاملة الصادرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktion ausstehend. Synchronisieren Sie nach einem neuen Handshake-Block, damit Shakescape die ausgehende Transaktion abwickeln kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction pending. Synchronize after a new Handshake block so Shakescape can settle the outgoing transaction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacción pendiente. Sincronice después de un nuevo bloque Handshake para que Shakescape pueda liquidar la transacción saliente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "معامله در انتظار بعد از یک بلوک جدید Handshake همگام سازی کنید تا Shakescape بتواند تراکنش خروجی را تسویه کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction en attente. Synchronisez après un nouveau bloc Handshake afin que Shakescape puisse régler la transaction sortante."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה בהמתנה. סנכרן לאחר בלוק Handshake חדש כדי ש-Shakescape יוכל ליישב את העסקה היוצאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेन-देन लंबित है. नए Handshake ब्लॉक के बाद सिंक्रोनाइज़ करें ताकि Shakescape आउटगोइंग लेनदेन का निपटान कर सके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi tertunda. Sinkronisasi setelah blok Handshake baru sehingga Shakescape dapat menyelesaikan transaksi keluar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Transazione in sospeso. Sincronizzare dopo un nuovo blocco Handshake in modo che Shakescape possa liquidare la transazione in uscita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランザクションは保留中です。新しい Handshake ブロックの後に同期して、Shakescape が送信トランザクションを解決できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 보류 중입니다. Shakescape가 나가는 거래를 해결할 수 있도록 새로운 Handshake 블록 이후에 동기화합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactie in behandeling. Synchroniseer na een nieuw Handshake-blok zodat Shakescape de uitgaande transactie kan afrekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja oczekująca. Synchronizuj po nowym bloku Handshake, aby Shakescape mógł rozliczyć wychodzącą transakcję."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Transação pendente. Sincronize após um novo bloco Handshake para que Shakescape possa liquidar a transação de saída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидается транзакция. Синхронизируйте после нового блока Handshake, чтобы Shakescape мог выполнить исходящую транзакцию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem beklemede. Shakescape'nin giden işlemi tamamlayabilmesi için yeni bir Handshake bloğundan sonra senkronize edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансакція очікує на розгляд. Синхронізувати після нового блоку Handshake, щоб Shakescape міг розрахувати вихідну транзакцію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch đang chờ xử lý. Đồng bộ hóa sau khối Handshake mới để Shakescape có thể giải quyết giao dịch gửi đi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易待处理。在新的 Handshake 块之后同步，以便 Shakescape 可以结算传出交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易待處理。在新的 Handshake 區塊之後同步，以便 Shakescape 可以結算傳出交易。"
          }
        }
      }
    },
