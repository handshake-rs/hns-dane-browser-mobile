    "wallet_swap_no_executions_waiting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مقايضات ذرية نشطة. بعد قبول العرض، احتفظ بالمحفظتين مفتوحتين ومتصلتين أثناء تبادل الشروط الموقعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es sind keine Atom-Swaps aktiv. Nachdem Sie ein Angebot angenommen haben, lassen Sie beide Wallets entsperrt und verbunden, während die unterzeichneten Bedingungen ausgetauscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No atomic swaps are active. After accepting an offer, keep both wallets unlocked and connected while they exchange signed terms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay intercambios atómicos activos. Después de aceptar una oferta, mantenga ambas billeteras desbloqueadas y conectadas mientras intercambian los términos firmados."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ سوآپ اتمی فعال نیست. پس از پذیرش پیشنهاد، هر دو کیف پول را قفل و متصل نگه دارید تا زمانی که شرایط امضا شده را رد و بدل می کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun swap atomique n'est actif. Après avoir accepté une offre, gardez les deux portefeuilles déverrouillés et connectés pendant qu'ils échangent les conditions signées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין החלפות אטומיות פעילות. לאחר קבלת הצעה, השאר את שני הארנקים פתוחים ומחוברים בזמן שהם מחליפים תנאים חתומים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी परमाणु स्वैप सक्रिय नहीं है. किसी प्रस्ताव को स्वीकार करने के बाद, हस्ताक्षरित शर्तों का आदान-प्रदान करते समय दोनों वॉलेट को अनलॉक और कनेक्ट रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pertukaran atom yang aktif. Setelah menerima tawaran, biarkan kedua dompet tetap terbuka dan terhubung saat mereka bertukar persyaratan yang ditandatangani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono attivi atomic swap. Dopo aver accettato un'offerta, mantieni entrambi i portafogli sbloccati e connessi mentre si scambiano i termini firmati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなアトミック スワップはありません。オファーを受け入れた後、署名された条件を交換する間、両方のウォレットのロックを解除して接続したままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화된 원자 교환이 없습니다. 제안을 수락한 후 서명된 조건을 교환하는 동안 두 지갑을 모두 잠금 해제하고 연결된 상태로 유지하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er zijn geen atomaire swaps actief. Nadat u een aanbieding heeft geaccepteerd, houdt u beide portemonnees ontgrendeld en verbonden terwijl ze ondertekende voorwaarden uitwisselen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne wymiany atomowe nie są aktywne. Po zaakceptowaniu oferty pozostaw oba portfele odblokowane i połączone podczas wymiany podpisanych warunków."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma troca atômica está ativa. Depois de aceitar uma oferta, mantenha ambas as carteiras desbloqueadas e conectadas enquanto trocam os termos assinados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никакие атомарные свопы не активны. После принятия предложения оставьте оба кошелька разблокированными и подключенными, пока они обмениваются подписанными условиями."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir atomik takas etkin değil. Bir teklifi kabul ettikten sonra, imzalanan koşulları değiştirirken her iki cüzdanın kilidini açık ve bağlı tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає активних атомарних свопів. Прийнявши пропозицію, тримайте обидва гаманці розблокованими та підключеними, поки вони обміняються підписаними умовами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có giao dịch hoán đổi nguyên tử nào đang hoạt động. Sau khi chấp nhận lời đề nghị, hãy luôn mở khóa và kết nối cả hai ví trong khi họ trao đổi các điều khoản đã ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有活跃的原子交换。接受报价后，在交换签署的条款时保持两个钱包解锁并连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有活躍的原子交換。接受報價後，在交換簽署的條款時保持兩個錢包解鎖並連接。"
          }
        }
      }
    },
