    "wallet_value_warning_delayed_settlement": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحذير: قد تتطلب تسوية Shakedex خطوات لاحقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnung: Die Abwicklung des Shakedex kann spätere Schritte erfordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: Shakedex settlement can require later steps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Advertencia: La liquidación de Shakedex puede requerir pasos posteriores."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هشدار: تسویه حساب Shakedex ممکن است به مراحل بعدی نیاز داشته باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention : le règlement Shakedex peut nécessiter des étapes ultérieures."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אזהרה: הסדר Shakedex עשוי לדרוש שלבים מאוחרים יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चेतावनी: Shakedex निपटान के लिए बाद के चरणों की आवश्यकता हो सकती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan: Penyelesaian Shakedex memerlukan langkah selanjutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvertenza: la liquidazione Shakedex può richiedere passaggi successivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警告: Shakedex の決済には、後の手順が必要になる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경고: Shakedex 결제에는 이후 단계가 필요할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarschuwing: voor de Shakedex-afrekening kunnen latere stappen nodig zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostrzeżenie: Rozliczenie Shakedex może wymagać późniejszych kroków."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: a liquidação Shakedex pode exigir etapas posteriores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предупреждение: расчет Shakedex может потребовать более поздних шагов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyarı: Shakedex çözümü daha sonraki adımları gerektirebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
