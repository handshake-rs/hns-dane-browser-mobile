    "wallet_bitcoin_birthday_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح محفظة Bitcoin المباشرة وانتظر حتى انتهاء عملها الحالي قبل تحديد ارتفاع عيد الميلاد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren Sie die direkte Bitcoin-Wallet und warten Sie, bis der aktuelle Vorgang abgeschlossen ist, bevor Sie die Geburtstagshöhe festlegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the direct Bitcoin wallet and wait for its current operation to finish before setting the birthday height."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquee la billetera Bitcoin directa y espere a que finalice la operación actual antes de configurar la altura del cumpleaños."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پول مستقیم Bitcoin را باز کنید و قبل از تنظیم ارتفاع تولد منتظر بمانید تا عملیات فعلی آن به پایان برسد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez le portefeuille direct Bitcoin et attendez la fin de son opération en cours avant de définir la hauteur d'anniversaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את הנעילה של ארנק Bitcoin הישיר והמתן עד שהפעולה הנוכחית שלו תסתיים לפני קביעת גובה יום ההולדת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधे Bitcoin वॉलेट को अनलॉक करें और जन्मदिन की ऊंचाई निर्धारित करने से पहले इसके वर्तमान ऑपरेशन के समाप्त होने तक प्रतीक्षा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci dompet Bitcoin langsung dan tunggu hingga pengoperasiannya selesai sebelum mengatur ketinggian ulang tahun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca il portafoglio diretto Bitcoin e attendi il completamento dell'operazione corrente prima di impostare l'altezza del compleanno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイレクト Bitcoin ウォレットのロックを解除し、現在の操作が完了するまで待ってから、誕生日の高さを設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생일 키를 설정하기 전에 직접 Bitcoin 지갑을 잠금 해제하고 현재 작업이 완료될 때까지 기다립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel de directe Bitcoin-portemonnee en wacht tot de huidige bewerking is voltooid voordat u de verjaardagshoogte instelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj portfel bezpośredni Bitcoin i poczekaj na zakończenie jego bieżącej operacji przed ustawieniem wysokości urodzin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie a carteira direta Bitcoin e aguarde a conclusão da operação atual antes de definir a altura do aniversário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте прямой кошелек Bitcoin и дождитесь завершения его текущей операции, прежде чем устанавливать высоту дня рождения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan Bitcoin cüzdanının kilidini açın ve doğum günü yüksekliğini ayarlamadan önce mevcut işleminin bitmesini bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте прямий гаманець Bitcoin і зачекайте, поки завершиться поточна операція, перш ніж установлювати висоту дня народження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa ví Bitcoin trực tiếp và đợi hoạt động hiện tại của nó kết thúc trước khi đặt chiều cao ngày sinh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁直接Bitcoin钱包并等待其当前操作完成后再设置生日高度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖直接Bitcoin錢包並等待其當前作業完成後再設定生日高度。"
          }
        }
      }
    },
