    "wallet_recovery_quiz_failed_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختيار واحد على الأقل غير صحيح. راجع العبارة وحاول إدخال الكلمات الأربع والعشرين مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens eine Auswahl war falsch. Prüfe die Phrase und versuche alle 24 Wörter erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one choice was wrong. Review the phrase and try all 24 words again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos una selección fue incorrecta. Revisa la frase e inténtalo de nuevo con las 24 palabras."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حداقل یک انتخاب نادرست بود. عبارت را بررسی کنید و هر ۲۴ کلمه را دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au moins un choix est incorrect. Vérifiez la phrase et recommencez les 24 mots."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפחות בחירה אחת שגויה. בדקו את הביטוי ונסו שוב את כל 24 המילים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम एक चयन गलत था। वाक्यांश जाँचें और सभी 24 शब्द फिर से आज़माएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedikitnya satu pilihan salah. Periksa frasa dan coba lagi semua 24 kata."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno una scelta è errata. Controlla la frase e riprova tutte le 24 parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少なくとも1つの選択が間違っています。フレーズを確認し、24単語すべてをやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 이상의 선택이 잘못되었습니다. 문구를 확인하고 24개 단어를 모두 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minstens één keuze was fout. Controleer de zin en probeer alle 24 woorden opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co najmniej jeden wybór był błędny. Sprawdź frazę i ponów wszystkie 24 słowa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos uma escolha está errada. Reveja a frase e tente novamente as 24 palavras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотя бы один вариант неверен. Проверьте фразу и повторите все 24 слова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az bir seçim yanlıştı. İfadeyi kontrol edip 24 kelimenin tümünü yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щонайменше один вибір неправильний. Перевірте фразу й повторіть усі 24 слова."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có ít nhất một lựa chọn sai. Kiểm tra cụm từ và thử lại đủ 24 từ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少有一个选择错误。请检查短语并重新完成全部 24 个单词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少有一個選擇錯誤。請檢查短語並重新完成全部 24 個單字。"
          }
        }
      }
    },
