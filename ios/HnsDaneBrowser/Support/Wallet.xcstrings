        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS अभी खर्च करने योग्य\n%2$@ HNS लंबित आउटगोइंग\nलेनदेन लंबित, कृपया प्रतीक्षा करें।"
