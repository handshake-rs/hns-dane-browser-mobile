    "wallet_reads_names_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأسماء المتعقبة غير متوفرة حتى تكتمل المزامنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachverfolgte Namen sind erst verfügbar, wenn die Synchronisierung abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracked names are not available until synchronization completes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres rastreados no están disponibles hasta que se completa la sincronización."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام های ردیابی شده تا زمانی که همگام سازی کامل نشود در دسترس نیستند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms suivis ne sont pas disponibles tant que la synchronisation n'est pas terminée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמות במעקב אינם זמינים עד לסיום הסנכרון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक्रनाइज़ेशन पूरा होने तक ट्रैक किए गए नाम उपलब्ध नहीं होंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama yang dilacak tidak tersedia hingga sinkronisasi selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi rilevati non sono disponibili fino al completamento della sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡された名前は、同期が完了するまで使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화가 완료될 때까지 추적된 이름을 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bijgehouden namen zijn pas beschikbaar nadat de synchronisatie is voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledzone nazwy nie są dostępne do momentu zakończenia synchronizacji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes rastreados não estarão disponíveis até que a sincronização seja concluída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживаемые имена недоступны до завершения синхронизации."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkronizasyon tamamlanana kadar izlenen adlar kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відстежувані імена недоступні, доки не завершиться синхронізація."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên được theo dõi không có sẵn cho đến khi quá trình đồng bộ hóa hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在同步完成之前，跟踪的名称不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在同步完成之前，追蹤的名稱不可用。"
          }
        }
      }
    },
    "wallet_reads_outbound_12038_blocked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن هذه الشبكة تحظر أقران Handshake على منفذ TCP رقم 12038. جرب شبكة أخرى أو VPN، ثم قم بالمزامنة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Netzwerk scheint Handshake-Peers auf TCP-Port 12038 zu blockieren. Versuchen Sie es mit einem anderen Netzwerk oder VPN und synchronisieren Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This network appears to block Handshake peers on TCP port 12038. Try another network or VPN, then synchronize again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta red parece bloquear a los pares Handshake en el puerto TCP 12038. Pruebe con otra red o VPN, luego sincronice nuevamente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به نظر می رسد این شبکه همتایان Handshake را در درگاه TCP 12038 مسدود می کند. شبکه یا VPN دیگری را امتحان کنید، سپس دوباره همگام سازی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce réseau semble bloquer les homologues Handshake sur le port TCP 12038. Essayez un autre réseau ou VPN, puis synchronisez à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נראה שרשת זו חוסמת עמיתים של Handshake ביציאת TCP 12038. נסה רשת אחרת או VPN, ולאחר מכן סנכרן שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐसा प्रतीत होता है कि यह नेटवर्क TCP पोर्ट 12038 पर Handshake साथियों को ब्लॉक करता है। किसी अन्य नेटवर्क या वीपीएन का प्रयास करें, फिर फिर से सिंक्रोनाइज़ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaringan ini tampaknya memblokir rekan Handshake pada port TCP 12038. Coba jaringan atau VPN lain, lalu sinkronkan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa rete sembra bloccare i peer Handshake sulla porta TCP 12038. Prova un'altra rete o VPN, quindi sincronizza di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このネットワークは、TCP ポート 12038 上の Handshake ピアをブロックしているようです。別のネットワークまたは VPN を試してから、再度同期してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 네트워크는 TCP 포트 12038에서 Handshake 피어를 차단하는 것으로 보입니다. 다른 네트워크나 VPN을 시도한 후 다시 동기화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit netwerk lijkt Handshake-peers op TCP-poort 12038 te blokkeren. Probeer een ander netwerk of VPN en synchroniseer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląda na to, że ta sieć blokuje urządzenia równorzędne Handshake na porcie 12038 TCP. Spróbuj innej sieci lub VPN, a następnie zsynchronizuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta rede parece bloquear pares Handshake na porta 12038 TCP. Tente outra rede ou VPN e sincronize novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, что эта сеть блокирует узлы Handshake на порту 12038 TCP. Попробуйте другую сеть или VPN, затем выполните синхронизацию еще раз."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ağ, TCP bağlantı noktası 12038'deki Handshake eşlerini engelliyor gibi görünüyor. Başka bir ağ veya VPN deneyin ve ardından yeniden senkronize edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Здається, ця мережа блокує вузли Handshake на порту 12038 TCP. Спробуйте іншу мережу або VPN, а потім синхронізуйте знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mạng này dường như chặn các thiết bị ngang hàng Handshake trên cổng TCP 12038. Hãy thử một mạng hoặc VPN khác, sau đó đồng bộ hóa lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该网络似乎阻止了 TCP 端口 12038 上的 Handshake 对等点。请尝试其他网络或 VPN，然后再次同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該網路似乎阻止了 TCP 連接埠 12038 上的 Handshake 對等點。請嘗試其他網路或 VPN，然後再次同步。"
          }
        }
      }
    },
