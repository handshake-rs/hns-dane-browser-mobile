    "wallet_send_admission_unverified": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصفقة معلقة. سيقوم Shakescape بتحديث المحفظة تلقائيًا بعد اكتشاف كتلة Handshake جديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktion ausstehend. Shakescape aktualisiert die Brieftasche automatisch, nachdem ein neuer Handshake-Block erkannt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction pending. Shakescape will refresh the wallet automatically after it detects a new Handshake block."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacción pendiente. Shakescape actualizará la billetera automáticamente después de que detecte un nuevo bloque Handshake."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "معامله در انتظار Shakescape پس از شناسایی یک بلوک جدید Handshake کیف پول را به طور خودکار تازه می کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction en attente. Shakescape actualisera automatiquement le portefeuille après avoir détecté un nouveau bloc Handshake."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה בהמתנה. Shakescape ירענן את הארנק באופן אוטומטי לאחר שיזהה בלוק Handshake חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेन-देन लंबित है. Shakescape एक नए Handshake ब्लॉक का पता लगाने के बाद वॉलेट को स्वचालित रूप से रीफ्रेश कर देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi tertunda. Shakescape akan menyegarkan dompet secara otomatis setelah mendeteksi blok Handshake baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Transazione in sospeso. Shakescape aggiornerà automaticamente il portafoglio dopo aver rilevato un nuovo blocco Handshake."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランザクションは保留中です。 Shakescape は、新しい Handshake ブロックを検出した後、ウォレットを自動的に更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 보류 중입니다. Shakescape는 새로운 Handshake 블록을 감지한 후 자동으로 지갑을 새로 고칩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactie in behandeling. Shakescape vernieuwt de portemonnee automatisch nadat deze een nieuw Handshake-blok detecteert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja oczekująca. Shakescape automatycznie odświeży portfel po wykryciu nowego bloku Handshake."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Transação pendente. Shakescape atualizará a carteira automaticamente após detectar um novo bloco Handshake."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидается транзакция. Shakescape автоматически обновит кошелек после обнаружения нового блока Handshake."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem beklemede. Shakescape, yeni bir Handshake bloğu tespit ettikten sonra cüzdanı otomatik olarak yenileyecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансакція очікує на розгляд. Shakescape автоматично оновить гаманець після виявлення нового блоку Handshake."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch đang chờ xử lý. Shakescape sẽ tự động làm mới ví sau khi phát hiện khối Handshake mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易待处理。 Shakescape在检测到新的Handshake区块后会自动刷新钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易待處理。 Shakescape在偵測到新的Handshake區塊後會自動刷新錢包。"
          }
        }
      }
    },
    "wallet_send_admission_verified": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد تحققت المعاملة %1$@ من حالة الشبكة: %2$@. يمكنك إغلاق المحفظة؛ لا يزال التأكيد يتطلب التضمين في الكتلة التي تم التحقق منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transaktion %1$@ hat den Netzwerkstatus %2$@ überprüft. Sie können die Brieftasche schließen; Die Bestätigung erfordert weiterhin die Aufnahme in einen verifizierten Block."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction %1$@ has verified network status: %2$@. You may close the wallet; confirmation still requires inclusion in a verified block."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transacción %1$@ ha verificado el estado de la red: %2$@. Puedes cerrar la billetera; la confirmación aún requiere la inclusión en un bloque verificado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش %1$@ وضعیت شبکه را تأیید کرده است: %2$@. می توانید کیف پول را ببندید. تأیید همچنان نیاز به درج در یک بلوک تأیید شده دارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transaction %1$@ a vérifié l'état du réseau : %2$@. Vous pouvez fermer le portefeuille ; la confirmation nécessite toujours l’inclusion dans un bloc vérifié."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עסקת %1$@ אומתה את סטטוס הרשת: %2$@. אתה יכול לסגור את הארנק; אישור עדיין דורש הכללה בחסימה מאומתת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेन-देन %1$@ की सत्यापित नेटवर्क स्थिति है: %2$@। आप बटुआ बंद कर सकते हैं; पुष्टि के लिए अभी भी सत्यापित ब्लॉक में शामिल किए जाने की आवश्यकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi %1$@ telah terverifikasi status jaringan: %2$@. Anda dapat menutup dompet; konfirmasi masih memerlukan penyertaan dalam blok terverifikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La transazione %1$@ ha verificato lo stato della rete: %2$@. Puoi chiudere il portafoglio; la conferma richiede ancora l'inclusione in un blocco verificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランザクション %1$@ はネットワーク ステータスを検証しました: %2$@。ウォレットを閉じても構いません。確認するには、検証済みブロックに含める必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랜잭션 %1$@의 네트워크 상태가 확인되었습니다: %2$@. 지갑을 닫을 수도 있습니다. 확인을 위해서는 여전히 검증된 블록에 포함되어야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactie %1$@ heeft de netwerkstatus geverifieerd: %2$@. U kunt de portemonnee sluiten; bevestiging vereist nog steeds opname in een geverifieerd blok."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja %1$@ zweryfikowała status sieci: %2$@. Możesz zamknąć portfel; potwierdzenie nadal wymaga umieszczenia w zweryfikowanym bloku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A transação %1$@ verificou o status da rede: %2$@. Você pode fechar a carteira; a confirmação ainda requer inclusão em um bloco verificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакция %1$@ подтвердила статус сети: %2$@. Вы можете закрыть кошелек; подтверждение по-прежнему требует включения в проверенный блок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ işlemi ağ durumunu doğruladı: %2$@. Cüzdanı kapatabilirsiniz; onay yine de doğrulanmış bir bloğa dahil edilmeyi gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансакція %1$@ має перевірений статус мережі: %2$@. Ви можете закрити гаманець; підтвердження все ще вимагає включення в перевірений блок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch %1$@ đã xác minh trạng thái mạng: %2$@. Bạn có thể đóng ví; xác nhận vẫn yêu cầu đưa vào khối đã xác minh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易%1$@已验证网络状态：%2$@。您可以关闭钱包；确认仍然需要包含在已验证的块中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易%1$@已驗證網路狀態：%2$@。您可以關閉錢包；確認仍需要包含在已驗證的區塊中。"
          }
        }
      }
    },
