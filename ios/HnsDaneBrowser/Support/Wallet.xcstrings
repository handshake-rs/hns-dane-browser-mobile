    "wallet_auth_transaction_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتأكيد كلمة المرور أو رقم التعريف الشخصي أو النمط الخاص بجهازك قبل إعداد هذه المعاملة للموافقة عليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie Ihr Gerätepasswort, Ihre PIN oder Ihr Muster, bevor Sie diese Transaktion zur Genehmigung vorbereiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm your device password, PIN, or pattern before preparing this transaction for approval."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme la contraseña, el PIN o el patrón de su dispositivo antes de preparar esta transacción para su aprobación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل از آماده کردن این تراکنش برای تأیید، رمز عبور، پین یا الگوی دستگاه خود را تأیید کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez le mot de passe, le code PIN ou le modèle de votre appareil avant de préparer cette transaction pour approbation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשר את סיסמת המכשיר, ה-PIN או הדפוס שלך לפני הכנת עסקה זו לאישור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लेनदेन को अनुमोदन के लिए तैयार करने से पहले अपने डिवाइस पासवर्ड, पिन या पैटर्न की पुष्टि करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmasikan kata sandi, PIN, atau pola perangkat Anda sebelum mempersiapkan transaksi ini untuk disetujui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma la password, il PIN o la sequenza del tuo dispositivo prima di preparare questa transazione per l'approvazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このトランザクションの承認を準備する前に、デバイスのパスワード、PIN、またはパターンを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 거래 승인을 준비하기 전에 장치 비밀번호, PIN 또는 패턴을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig het wachtwoord, de pincode of het patroon van uw apparaat voordat u deze transactie ter goedkeuring voorbereidt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdź hasło urządzenia, PIN lub wzór przed przygotowaniem tej transakcji do zatwierdzenia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme a senha, PIN ou padrão do seu dispositivo antes de preparar esta transação para aprovação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите пароль, PIN-код или графический ключ вашего устройства, прежде чем готовить эту транзакцию к утверждению."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
