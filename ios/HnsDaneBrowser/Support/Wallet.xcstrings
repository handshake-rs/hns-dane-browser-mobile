          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאמת את נקודת הבידוק SXQPH002QXZ המסונכרנת ואת גבול הארגון מחדש... חלף %1$@."
          }
        },
        "hi": {
          "stringUnit": {
