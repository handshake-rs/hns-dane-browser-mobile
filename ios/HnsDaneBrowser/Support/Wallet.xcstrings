    "wallet_bitcoin_send_insufficient_confirmed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يغطي Bitcoin المبلغ والحد الأقصى للرسوم واحتياطيات العرض النشط. قم بتقليل المبلغ أو الرسم، أو انتظر التأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigt, dass Bitcoin den Betrag, die Höchstgebühr und die aktiven Angebotsreserven nicht abdeckt. Reduzieren Sie den Betrag oder die Gebühr oder warten Sie auf die Bestätigung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmed Bitcoin does not cover the amount, maximum fee, and active-offer reserves. Reduce the amount or fee, or wait for confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Bitcoin confirmado no cubre el monto, la tarifa máxima ni las reservas de oferta activa. Reduzca el importe o la tarifa, o espere la confirmación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin تایید شده مبلغ، حداکثر کارمزد و ذخایر فعال پیشنهادی را پوشش نمی‌دهد. مبلغ یا هزینه را کاهش دهید یا منتظر تایید باشید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Bitcoin confirmé ne couvre pas le montant, les frais maximum et les réserves d'offre active. Réduisez le montant ou les frais, ou attendez la confirmation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אושר Bitcoin אינו מכסה את הסכום, העמלה המקסימלית ועתודות המבצע הפעיל. הפחת את הסכום או העמלה, או המתן לאישור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि की गई Bitcoin में राशि, अधिकतम शुल्क और सक्रिय-ऑफर रिजर्व शामिल नहीं है। राशि या शुल्क कम करें, या पुष्टि की प्रतीक्षा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin yang dikonfirmasi tidak mencakup jumlah, biaya maksimum, dan cadangan penawaran aktif. Kurangi jumlah atau biaya, atau tunggu konfirmasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin confermato non copre l'importo, la commissione massima e le riserve dell'offerta attiva. Riduci l'importo o la tariffa oppure attendi la conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin は金額、最大料金、アクティブオファーのリザーブをカバーしていないことを確認しました。金額または手数料を減らすか、確認をお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인된 Bitcoin는 금액, 최대 수수료 및 활성 제안 준비금을 포함하지 않습니다. 금액이나 수수료를 줄이거나 확인을 기다리세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestigd dat Bitcoin het bedrag, de maximale vergoeding en de reserves voor actieve aanbiedingen niet dekt. Verlaag het bedrag of de vergoeding, of wacht op bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdzone Bitcoin nie obejmuje kwoty, maksymalnej opłaty i rezerw aktywnej oferty. Zmniejsz kwotę lub opłatę lub poczekaj na potwierdzenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Bitcoin confirmado não cobre o valor, a taxa máxima e as reservas de oferta ativa. Reduza o valor ou taxa ou aguarde a confirmação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвержденный Bitcoin не покрывает сумму, максимальную комиссию и резервы активного предложения. Уменьшите сумму или комиссию или дождитесь подтверждения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylanan Bitcoin tutarı, maksimum ücreti ve aktif teklif rezervlerini kapsamaz. Tutarı veya ücreti azaltın veya onay için bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтверджений Bitcoin не покриває суму, максимальну комісію та резерви активних пропозицій. Зменшіть суму або комісію або дочекайтеся підтвердження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin đã xác nhận không bao gồm số tiền, phí tối đa và dự trữ ưu đãi đang hoạt động. Giảm số tiền hoặc phí hoặc chờ xác nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已确认的Bitcoin不包括金额、最高费用和主动报价储备金。减少金额或费用，或等待确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已確認的Bitcoin不包括金額、最高費用和主動報價儲備金。減少金額或費用，或等待確認。"
          }
        }
      }
    },
