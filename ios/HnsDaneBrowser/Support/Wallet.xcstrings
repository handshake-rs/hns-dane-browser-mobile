    "wallet_direct_shakescape_connect_bridge_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من نتيجة اتصال المبادلة P2P. تظل المحفظة صالحة للاستعمال؛ قم بفحص حالة المضيف والنظير قبل إعادة المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis der P2P-Swap-Verbindung konnte nicht überprüft werden. Das Portemonnaie bleibt nutzbar; Überprüfen Sie den Host- und Peer-Status, bevor Sie es erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The P2P swap connection result could not be verified. The wallet remains usable; inspect the host and peer state before retrying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el resultado de la conexión de intercambio P2P. La billetera sigue siendo utilizable; Inspeccione el estado del host y del par antes de volver a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نتیجه اتصال تعویض P2P تأیید نشد. کیف پول قابل استفاده باقی می ماند. قبل از تلاش مجدد، حالت میزبان و همتا را بررسی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la connexion d'échange P2P n'a pas pu être vérifié. Le portefeuille reste utilisable ; inspectez l’état de l’hôte et du homologue avant de réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאמת את תוצאת חיבור ההחלפה של P2P. הארנק נשאר שמיש; בדוק את מצב המארח והעמית לפני ניסיון חוזר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P स्वैप कनेक्शन परिणाम सत्यापित नहीं किया जा सका। बटुआ प्रयोग योग्य रहता है; पुनः प्रयास करने से पहले मेजबान और सहकर्मी स्थिति का निरीक्षण करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil koneksi swap P2P tidak dapat diverifikasi. Dompet tetap dapat digunakan; periksa status host dan rekan sebelum mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare il risultato della connessione di scambio P2P. Il portafoglio rimane utilizzabile; controllare lo stato dell'host e del peer prima di riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P スワップ接続結果を確認できませんでした。ウォレットは引き続き使用可能です。再試行する前にホストとピアの状態を検査してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P 스왑 연결 결과를 확인할 수 없습니다. 지갑은 계속 사용할 수 있습니다. 다시 시도하기 전에 호스트 및 피어 상태를 검사하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het resultaat van de wisselverbinding P2P kan niet worden geverifieerd. De portemonnee blijft bruikbaar; inspecteer de host- en peer-status voordat u het opnieuw probeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zweryfikować wyniku połączenia wymiany P2P. Portfel pozostaje użyteczny; sprawdź stan hosta i partnera przed ponowną próbą."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado da conexão swap P2P não pôde ser verificado. A carteira permanece utilizável; inspecione o estado do host e do peer antes de tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат подключения подкачки P2P не удалось проверить. Кошелек остается пригодным для использования; проверьте состояние хоста и однорангового узла перед повторной попыткой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P takas bağlantısı sonucu doğrulanamadı. M-cüzdan kullanılabilir durumda kalır; yeniden denemeden önce ana bilgisayar ve eş durumunu inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат підключення підкачки P2P не вдалося перевірити. Гаманець залишається придатним для використання; перевірте стан хоста та однорангового вузла перед повторною спробою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh kết quả kết nối trao đổi P2P. Ví vẫn có thể sử dụng được; kiểm tra trạng thái máy chủ và ngang hàng trước khi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证 P2P 交换连接结果。钱包仍然可用；重试之前检查主机和对等方状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證 P2P 交換連線結果。錢包仍然可用；重試之前檢查主機和對等方狀態。"
          }
        }
      }
    },
    "wallet_direct_shakescape_connect_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كانت نقطة النهاية المباشرة الدقيقة غير متاحة أو غير متوافقة أو مرفوضة. تبقى المحفظة مفتوحة وقابلة للاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der genaue direkte Endpunkt war nicht verfügbar, inkompatibel oder abgelehnt. Das Wallet bleibt entsperrt und nutzbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exact direct endpoint was unavailable, incompatible, or rejected. The wallet remains unlocked and usable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El punto final directo exacto no estaba disponible, era incompatible o rechazado. La billetera permanece desbloqueada y utilizable."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نقطه پایان مستقیم دقیق در دسترس نبود، ناسازگار بود یا رد شد. کیف پول باز و قابل استفاده باقی می ماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le point de terminaison direct exact était indisponible, incompatible ou rejeté. Le portefeuille reste déverrouillé et utilisable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקודת הסיום הישירה המדויקת לא הייתה זמינה, לא תואמת או נדחתה. הארנק נשאר לא נעול ושמיש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सटीक प्रत्यक्ष समापन बिंदु अनुपलब्ध, असंगत या अस्वीकृत था। बटुआ खुला और उपयोग योग्य रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Titik akhir langsung yang sebenarnya tidak tersedia, tidak kompatibel, atau ditolak. Dompet tetap tidak terkunci dan dapat digunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'endpoint diretto esatto non era disponibile, era incompatibile o rifiutato. Il portafoglio rimane sbloccato e utilizzabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正確な直接エンドポイントは利用できないか、互換性がないか、拒否されました。ウォレットはロックが解除されたままで使用可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 직접 엔드포인트를 사용할 수 없거나 호환되지 않거나 거부되었습니다. 지갑은 잠금 해제되어 사용할 수 있는 상태로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het exacte directe eindpunt was niet beschikbaar, incompatibel of afgewezen. De portemonnee blijft ontgrendeld en bruikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dokładny bezpośredni punkt końcowy był niedostępny, niezgodny lub odrzucony. Portfel pozostaje odblokowany i nadaje się do użytku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O endpoint direto exato não estava disponível, era incompatível ou foi rejeitado. A carteira permanece desbloqueada e utilizável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точная прямая конечная точка была недоступна, несовместима или отклонена. Кошелек остается разблокированным и пригодным для использования."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesin doğrudan son nokta mevcut değildi, uyumsuzdu veya reddedildi. M-cüzdanın kilidi açık ve kullanılabilir durumda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Точна пряма кінцева точка була недоступна, несумісна або відхилена. Гаманець залишається розблокованим і придатним для використання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm cuối trực tiếp chính xác không có sẵn, không tương thích hoặc bị từ chối. Ví vẫn được mở khóa và có thể sử dụng được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确切的直接端点不可用、不兼容或被拒绝。钱包保持解锁状态并可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確切的直接端點不可用、不相容或被拒絕。錢包保持解鎖狀態並可用。"
          }
        }
      }
    },
    "wallet_direct_shakescape_connect_locked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم قفل المحفظة قبل أن يتم إقران نظير المبادلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wallet wurde gesperrt, bevor der Swap-Peer gekoppelt werden konnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wallet locked before the swap peer could be paired."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La billetera se bloqueó antes de que se pudiera emparejar el par de intercambio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پول قبل از جفت شدن همتای مبادله قفل شد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portefeuille est verrouillé avant que le homologue d'échange puisse être couplé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הארנק ננעל לפני שניתן היה לשייך את עמית ההחלפה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वैप पीयर को पेयर करने से पहले वॉलेट लॉक कर दिया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet terkunci sebelum rekan swap dapat dipasangkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il portafoglio è stato bloccato prima che il peer di scambio potesse essere accoppiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワップピアがペアリングされる前にウォレットがロックされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스왑 피어가 페어링되기 전에 지갑이 잠겼습니다."
          }
        },
        "nl": {
          "stringUnit": {
