    "wallet_bitcoin_sync_stop_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت مقاطعة مزامنة Bitcoin لأنه لم يتم العثور على مزامنة أصلية نشطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bitcoin-Synchronisierung konnte nicht unterbrochen werden, da keine aktive native Synchronisierung gefunden wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin synchronization could not be interrupted because no active native synchronization was found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización Bitcoin no se pudo interrumpir porque no se encontró ninguna sincronización nativa activa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همگام سازی Bitcoin نمی تواند قطع شود زیرا هیچ همگام سازی بومی فعالی پیدا نشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation Bitcoin n'a pas pu être interrompue car aucune synchronisation native active n'a été trouvée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להפריע לסינכרון Bitcoin מכיוון שלא נמצא סנכרון מקורי פעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin सिंक्रनाइज़ेशन बाधित नहीं किया जा सका क्योंकि कोई सक्रिय मूल सिंक्रनाइज़ेशन नहीं मिला।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronisasi Bitcoin tidak dapat diganggu karena tidak ditemukan sinkronisasi asli yang aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile interrompere la sincronizzazione Bitcoin perché non è stata trovata alcuna sincronizzazione nativa attiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなネイティブ同期が見つからなかったため、Bitcoin 同期を中断できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 기본 동기화가 없기 때문에 Bitcoin 동기화를 중단할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin-synchronisatie kan niet worden onderbroken omdat er geen actieve native synchronisatie is gevonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przerwać synchronizacji Bitcoin, ponieważ nie znaleziono aktywnej synchronizacji natywnej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização Bitcoin não pôde ser interrompida porque nenhuma sincronização nativa ativa foi localizada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизацию Bitcoin не удалось прервать, поскольку не найдена активная собственная синхронизация."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin etkin yerel senkronizasyon bulunamadığından senkronizasyon kesintiye uğratılamadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізацію Bitcoin не вдалося перервати, оскільки активну власну синхронізацію не знайдено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể gián đoạn quá trình đồng bộ hóa Bitcoin do không tìm thấy đồng bộ hóa gốc đang hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 同步无法中断，因为未找到活动的本机同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 同步無法中斷，因為找不到活動的本機同步。"
          }
        }
      }
    },
    "wallet_bitcoin_sync_stopped": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقفت مزامنة Bitcoin. تم الاحتفاظ بآخر نقطة تفتيش دائمة مكتملة؛ يمكنك استخلاص عنوان الاستلام أو المزامنة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin-Synchronisierung gestoppt. Der letzte fertiggestellte dauerhafte Kontrollpunkt wurde beibehalten; Sie können eine Empfangsadresse ableiten oder erneut synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin synchronization stopped. The last completed durable checkpoint was retained; you can derive a receive address or synchronize again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin se detuvo la sincronización. Se mantuvo el último puesto de control duradero terminado; puede derivar una dirección de recepción o sincronizar nuevamente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همگام سازی Bitcoin متوقف شد. آخرین پست بازرسی بادوام تکمیل شده حفظ شد. می توانید یک آدرس دریافت کنید یا دوباره همگام سازی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation Bitcoin s'est arrêtée. Le dernier point de contrôle durable réalisé a été retenu ; vous pouvez dériver une adresse de réception ou synchroniser à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סנכרון Bitcoin הופסק. המחסום העמיד האחרון שהושלם נשמר; אתה יכול לגזור כתובת קבלה או לסנכרן שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin सिंक्रोनाइज़ेशन बंद हो गया। अंतिम पूर्ण टिकाऊ चौकी को बरकरार रखा गया था; आप प्राप्त पता प्राप्त कर सकते हैं या फिर से सिंक्रनाइज़ कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronisasi Bitcoin terhenti. Pos pemeriksaan tahan lama terakhir yang diselesaikan dipertahankan; Anda dapat memperoleh alamat penerimaan atau melakukan sinkronisasi lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin sincronizzazione interrotta. L'ultimo checkpoint durevole completato è stato mantenuto; è possibile ricavare un indirizzo di ricezione o eseguire nuovamente la sincronizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 同期が停止しました。最後に完了した永続チェックポイントが保持されました。受信アドレスを取得したり、再度同期したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 동기화가 중지되었습니다. 마지막으로 완료된 지속성 체크포인트가 유지되었습니다. 수신 주소를 파생하거나 다시 동기화할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin-synchronisatie gestopt. Het laatst voltooide duurzame controlepunt bleef behouden; u kunt een ontvangstadres afleiden of opnieuw synchroniseren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja Bitcoin została zatrzymana. Ostatni ukończony trwały punkt kontrolny został zachowany; możesz uzyskać adres odbiorczy lub ponownie zsynchronizować."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização Bitcoin foi interrompida. O último ponto de verificação durável concluído foi mantido; você pode derivar um endereço de recebimento ou sincronizar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация Bitcoin остановлена. Последний завершенный контрольно-пропускной пункт длительного пользования был сохранен; вы можете получить адрес получения или снова выполнить синхронизацию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin senkronizasyonu durduruldu. Tamamlanan son dayanıklı kontrol noktası korundu; bir alma adresi alabilir veya yeniden senkronize edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізацію Bitcoin зупинено. Збережено останній завершений міцний КПП; ви можете отримати адресу отримання або синхронізувати знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ hóa Bitcoin đã dừng. Trạm kiểm tra bền vững đã hoàn thành cuối cùng được giữ lại; bạn có thể lấy được địa chỉ nhận hoặc đồng bộ hóa lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 同步已停止。保留最后完成的持久检查点；您可以导出接收地址或再次同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 同步已停止。保留最後完成的持久檢查點；您可以匯出接收位址或再次同步。"
          }
        }
      }
    },
