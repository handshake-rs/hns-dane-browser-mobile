        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال اعتبارسنجی نقطه بازرسی همگام Bitcoin و مرز سازماندهی مجدد… گذشت %1$@."
          }
        },
        "fr": {
