            "value": "Odrzucam oczekujące zatwierdzenie natywnego…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Descartando a aprovação nativa pendente…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена ожидающего внутреннего одобрения…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen yerel onay iptal ediliyor…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відхилення очікуваного нативного схвалення…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang hủy phê duyệt gốc đang chờ xử lý…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在放弃待处理的本机批准..."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在放棄待處理的本機批准..."
          }
        }
      }
    },
    "wallet_send_requires_sync": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب لقطة المحفظة الحالية التي تم التحقق منها قبل الإرسال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Senden ist ein aktueller verifizierter Wallet-Snapshot erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A current verified wallet snapshot is required before sending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere una instantánea de la billetera verificada actual antes de realizar el envío."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل از ارسال، یک عکس فوری تأیید شده کیف پول مورد نیاز است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un instantané du portefeuille vérifié à jour est requis avant l'envoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרשת תמונת מצב נוכחית של ארנק מאומת לפני השליחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजने से पहले एक वर्तमान सत्यापित वॉलेट स्नैपशॉट आवश्यक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Snapshot dompet terverifikasi saat ini diperlukan sebelum mengirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima dell'invio è necessaria un'istantanea del portafoglio verificata corrente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信する前に、現在検証済みのウォレットのスナップショットが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송하기 전에 현재 검증된 지갑 스냅샷이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is een actuele, geverifieerde momentopname van de portemonnee vereist voordat deze wordt verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed wysłaniem wymagana jest aktualna zweryfikowana migawka portfela."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um instantâneo de carteira verificado atual é necessário antes do envio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед отправкой необходим текущий подтвержденный снимок кошелька."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göndermeden önce geçerli, doğrulanmış bir cüzdan anlık görüntüsü gereklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед надсиланням потрібен поточний перевірений знімок гаманця."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần có ảnh chụp nhanh ví hiện tại đã được xác minh trước khi gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送之前需要当前经过验证的钱包快照。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發送之前需要當前經過驗證的錢包快照。"
          }
        }
      }
    },
    "wallet_send_submitted_sync_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصفقة معلقة. تعذر على Shakescape تحديث المحفظة على الفور وستتم إعادة المحاولة تلقائيًا بعد اكتشاف كتلة Handshake جديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktion ausstehend. Shakescape konnte die Brieftasche nicht sofort aktualisieren und wird es automatisch erneut versuchen, nachdem ein neuer Handshake-Block erkannt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction pending. Shakescape could not refresh the wallet immediately and will retry automatically after it detects a new Handshake block."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacción pendiente. Shakescape no pudo actualizar la billetera inmediatamente y lo volverá a intentar automáticamente después de detectar un nuevo bloque Handshake."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "معامله در انتظار Shakescape نمی‌تواند بلافاصله کیف پول را تازه‌سازی کند و پس از شناسایی بلوک Handshake، به‌طور خودکار دوباره امتحان می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction en attente. Shakescape n'a pas pu actualiser le portefeuille immédiatement et réessayera automatiquement après avoir détecté un nouveau bloc Handshake."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה בהמתנה. Shakescape לא הצליח לרענן את הארנק באופן מיידי וינסה שוב אוטומטית לאחר שיזהה בלוק Handshake חדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेन-देन लंबित है. Shakescape वॉलेट को तुरंत रीफ्रेश नहीं कर सका और एक नए Handshake ब्लॉक का पता लगाने के बाद स्वचालित रूप से पुनः प्रयास करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi tertunda. Shakescape tidak dapat segera menyegarkan dompet dan akan mencoba lagi secara otomatis setelah mendeteksi blok Handshake baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Transazione in sospeso. Shakescape non è riuscito ad aggiornare immediatamente il portafoglio e riproverà automaticamente dopo aver rilevato un nuovo blocco Handshake."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランザクションは保留中です。 Shakescape はウォレットをすぐに更新できず、新しい Handshake ブロックを検出した後、自動的に再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 보류 중입니다. Shakescape는 지갑을 즉시 새로 고칠 수 없으며 새로운 Handshake 블록을 감지한 후 자동으로 다시 시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactie in behandeling. Shakescape kan de portemonnee niet onmiddellijk vernieuwen en zal het automatisch opnieuw proberen nadat het een nieuw Handshake-blok heeft gedetecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja oczekująca. Shakescape nie mógł natychmiast odświeżyć portfela i spróbuje automatycznie ponowić próbę po wykryciu nowego bloku Handshake."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Transação pendente. Shakescape não conseguiu atualizar a carteira imediatamente e tentará novamente automaticamente após detectar um novo bloco Handshake."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидается транзакция. Shakescape не смог немедленно обновить кошелек и автоматически повторит попытку после обнаружения нового блока Handshake."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem beklemede. Shakescape, cüzdanı hemen yenileyemedi ve yeni bir Handshake bloğu algıladıktan sonra otomatik olarak yeniden deneyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансакція очікує на розгляд. Shakescape не зміг негайно оновити гаманець і автоматично повторить спробу після виявлення нового блоку Handshake."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch đang chờ xử lý. Shakescape không thể làm mới ví ngay lập tức và sẽ tự động thử lại sau khi phát hiện khối Handshake mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易待处理。 Shakescape 无法立即刷新钱包，检测到新的 Handshake 区块后会自动重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易待處理。 Shakescape 無法立即刷新錢包，偵測到新的 Handshake 區塊後會自動重試。"
          }
        }
      }
    },
    "wallet_send_sync_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتمكن المحفظة من الحصول على لقطة تم التحقق منها، لذلك لم يتم إعداد أي إرسال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wallet konnte keinen verifizierten Snapshot erhalten, daher wurde kein Versand vorbereitet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wallet could not obtain a verified snapshot, so no send was prepared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La billetera no pudo obtener una instantánea verificada, por lo que no se preparó ningún envío."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پول نتوانست یک عکس فوری تأیید شده دریافت کند، بنابراین هیچ ارسالی آماده نشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portefeuille n’a pas pu obtenir un instantané vérifié, aucun envoi n’a donc été préparé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הארנק לא הצליח להשיג תמונת מצב מאומתת, ולכן לא הוכנה שליחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट सत्यापित स्नैपशॉट प्राप्त नहीं कर सका, इसलिए कोई प्रेषण तैयार नहीं किया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet tidak dapat memperoleh snapshot terverifikasi, jadi tidak ada pengiriman yang disiapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il portafoglio non è riuscito a ottenere uno snapshot verificato, quindi non è stato preparato alcun invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットは検証済みのスナップショットを取得できなかったため、送信は準備されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑이 검증된 스냅샷을 얻을 수 없어 전송이 준비되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De portemonnee kon geen geverifieerde momentopname verkrijgen, dus er werd geen verzending voorbereid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfel nie mógł uzyskać zweryfikowanej migawki, więc nie przygotowano żadnej wysyłki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira não conseguiu obter um instantâneo verificado, portanto nenhum envio foi preparado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелек не смог получить проверенный снимок, поэтому отправка не была подготовлена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "M-cüzdan doğrulanmış bir anlık görüntü elde edemedi, bu nedenle herhangi bir gönderim hazırlanmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманцю не вдалося отримати перевірений знімок, тому надсилання не було підготовлено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví không thể lấy được ảnh chụp nhanh đã được xác minh nên chưa có lệnh gửi nào được chuẩn bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱包无法获取经过验证的快照，因此未准备发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錢包無法取得經過驗證的快照，因此未準備發送。"
          }
        }
      }
    },
    "wallet_send_syncing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المزامنة قيد التقدم. يتم فتح الإرسال عند الانتهاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung läuft. Das Senden wird entsperrt, wenn es abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronization is in progress. Sending unlocks when it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización está en curso. El envío se desbloquea cuando finaliza."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همگام سازی در حال انجام است. ارسال باز شدن قفل پس از اتمام آن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation est en cours. L'envoi se déverrouille une fois terminé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסנכרון מתבצע. שליחת נעילה כאשר היא מסתיימת."
