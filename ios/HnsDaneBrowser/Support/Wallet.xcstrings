    "wallet_reads_catching_up": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستمر مزامنة HNS من نقطة التفتيش الأخيرة. تحقيق التوازن وإرسال القفل عندما يصل المسح إلى آخر كتلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die HNS-Synchronisierung wird vom letzten Prüfpunkt aus fortgesetzt. Balance und Senden entsperren, wenn der Scan den neuesten Block erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS synchronization is continuing from its last checkpoint. Balance and sending unlock when the scan reaches the latest block."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización HNS continúa desde su último punto de control. Desbloqueo de saldo y envío cuando el escaneo llega al último bloque."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همگام سازی HNS از آخرین ایست بازرسی خود ادامه دارد. وقتی اسکن به آخرین بلوک رسید، قفل را متعادل کنید و ارسال کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation HNS continue depuis son dernier point de contrôle. Le solde et l'envoi sont déverrouillés lorsque l'analyse atteint le dernier bloc."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סנכרון HNS ממשיך מנקודת הבידוק האחרונה שלו. איזון ושליחה ביטול נעילה כאשר הסריקה מגיעה לחסימה האחרונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS सिंक्रोनाइज़ेशन अपने अंतिम चेकपॉइंट से जारी है। स्कैन नवीनतम ब्लॉक तक पहुंचने पर संतुलन और अनलॉक भेजना।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronisasi HNS berlanjut dari pos pemeriksaan terakhirnya. Saldo dan pengiriman terbuka ketika pemindaian mencapai blok terakhir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione HNS continua dall'ultimo checkpoint. Saldo e sblocco dell'invio quando la scansione raggiunge l'ultimo blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 同期は最後のチェックポイントから継続しています。スキャンが最新のブロックに達すると、バランスをとり、ロック解除を送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 동기화가 마지막 체크포인트부터 계속됩니다. 스캔이 최신 블록에 도달하면 잔액 및 전송 잠금이 해제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De HNS-synchronisatie gaat verder vanaf het laatste controlepunt. Saldo en verzending worden ontgrendeld wanneer de scan het laatste blok bereikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja HNS jest kontynuowana od ostatniego punktu kontrolnego. Saldo i wysyłanie odblokowują się, gdy skanowanie dotrze do najnowszego bloku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização do HNS continua desde seu último ponto de verificação. Equilíbrio e envio de desbloqueio quando a varredura atinge o bloco mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация HNS продолжается с последней контрольной точки. Баланс и отправка разблокируются, когда сканирование достигает последнего блока."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS senkronizasyonu son kontrol noktasından itibaren devam ediyor. Tarama en son bloğa ulaştığında denge ve gönderme kilidi açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізація HNS триває з останньої контрольної точки. Розблокування балансу та надсилання, коли сканування досягає останнього блоку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ hóa HNS đang tiếp tục từ điểm kiểm tra cuối cùng. Cân bằng và gửi mở khóa khi quét đến khối mới nhất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 同步从最后一个检查点继续。当扫描到达最新区块时平衡并发送解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 同步從最後一個檢查點繼續。當掃描到達最新區塊時平衡並發送解鎖。"
          }
        }
      }
    },
    "wallet_reads_catching_up_before_birthday": {
      "extractionState": "manual",
      "localizations": {
