            "value": "صفحه پیشنهاد احراز هویت شده دقیقاً با طرح پشتیبانی شده مطابقت نداشت و قابل انتخاب نبود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La page d'offre authentifiée ne correspondait pas exactement au schéma pris en charge et n'était pas sélectionnable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דף ההצעה המאומת לא תאם את הסכימה הנתמכת המדויקת ולא ניתן לבחירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रमाणित ऑफ़र पृष्ठ सटीक समर्थित स्कीमा से मेल नहीं खाता और चयन योग्य नहीं बनाया गया था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman penawaran yang diautentikasi tidak cocok dengan skema yang didukung dan tidak dapat dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pagina dell'offerta autenticata non corrispondeva esattamente allo schema supportato e non è stata resa selezionabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証されたオファー ページは、サポートされているスキーマと正確に一致しなかったため、選択可能になりませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증된 제안 페이지가 지원되는 스키마와 정확하게 일치하지 않아 선택할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geverifieerde aanbiedingspagina kwam niet exact overeen met het ondersteunde schema en was niet selecteerbaar gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwierzytelniona strona oferty nie odpowiadała dokładnie obsługiwanemu schematowi i nie można jej było wybrać."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A página de oferta autenticada não correspondia exatamente ao esquema suportado e não estava selecionável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страница аутентифицированного предложения не соответствовала точно поддерживаемой схеме и не была доступна для выбора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kimliği doğrulanmış teklif sayfası, desteklenen şemayla tam olarak eşleşmedi ve seçilebilir hale getirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автентифікована сторінка пропозиції не збігалася з точною підтримуваною схемою, тому її не можна було вибрати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trang ưu đãi đã xác thực không khớp chính xác với lược đồ được hỗ trợ và không thể chọn được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经过身份验证的优惠页面与受支持的确切架构不匹配，因此无法选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經過身份驗證的優惠頁面與受支援的確切架構不匹配，因此無法選擇。"
          }
        }
      }
    },
    "wallet_shakedex_offer_page_select": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد أحد عروض %1$d الموثقة من مراجعة اللوحة %2$d لإعداد مراجعة الشراء الأصلية الدقيقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eines der authentifizierten %1$d-Angebote der Platinenrevision %2$d aus, um eine genaue native Kaufbewertung zu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select one of %1$d authenticated offers from board revision %2$d to prepare its exact native purchase review."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione una de las ofertas autenticadas %1$d de la revisión de la placa %2$d para preparar su revisión de compra nativa exacta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یکی از پیشنهادات تأیید شده %1$d از نسخه هیئت مدیره %2$d را انتخاب کنید تا بررسی دقیق خرید بومی آن را آماده کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez l'une des offres authentifiées %1$d de la révision de la carte %2$d pour préparer son examen d'achat natif exact."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר אחת מההצעות המאומתות של %1$d מהגרסה של הלוח %2$d כדי להכין את סקירת הרכישה המקורית שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसकी सटीक मूल खरीद समीक्षा तैयार करने के लिए बोर्ड संशोधन %2$d से %1$d प्रमाणित प्रस्तावों में से एक का चयन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih salah satu penawaran terotentikasi %1$d dari revisi papan %2$d untuk menyiapkan ulasan pembelian aslinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona una delle offerte autenticate %1$d dalla revisione della scheda %2$d per preparare l'esatta revisione nativa dell'acquisto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボード リビジョン %2$d から %1$d 認証済みオファーの 1 つを選択して、正確なネイティブ購入レビューを準備します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 기본 구매 검토를 준비하려면 보드 개정판 %2$d에서 %1$d 인증 제안 중 하나를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een van de door %1$d geverifieerde aanbiedingen van bordrevisie %2$d om de exacte oorspronkelijke aankoopbeoordeling voor te bereiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz jedną z uwierzytelnionych ofert %1$d z wersji płyty %2$d, aby przygotować dokładną natywną recenzję zakupu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma das ofertas autenticadas %1$d da revisão da placa %2$d para preparar sua análise de compra nativa exata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите одно из проверенных предложений %1$d из версии платы %2$d, чтобы подготовить точный обзор покупки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam yerel satın alma incelemesini hazırlamak için %2$d anakart revizyonundan %1$d doğrulanmış tekliflerden birini seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть одну з автентифікованих пропозицій %1$d із версії плати %2$d, щоб підготувати її точний огляд покупки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một trong các ưu đãi đã được xác thực của %1$d từ bản sửa đổi bảng %2$d để chuẩn bị đánh giá mua hàng gốc chính xác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从主板版本 %2$d 中选择经过 %1$d 认证的报价之一，以准备其准确的本机购买审核。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從主機板版本 %2$d 中選擇經過 %1$d 認證的報價之一，以準備其精確的本機購買審核。"
          }
        }
      }
    },
