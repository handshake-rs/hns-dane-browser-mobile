          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrulanmış başlıklar ve cüzdan etkinliği %1$d yüksekliğinde günceldir. Salt okunur anlık görüntü sonlandırılıyor…"
