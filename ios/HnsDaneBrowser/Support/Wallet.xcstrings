    "wallet_status_locked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحفظة مقفلة. افتحها لتحديث الأرصدة والنشاط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet gesperrt. Entsperre sie, um Guthaben und Aktivitäten zu aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet locked. Unlock to update balances and activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartera bloqueada. Desbloquéala para actualizar saldos y actividad."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پول قفل است. برای به‌روزرسانی موجودی و فعالیت، قفل را باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portefeuille verrouillé. Déverrouillez-le pour actualiser le solde et l’activité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הארנק נעול. בטלו נעילה כדי לעדכן יתרות ופעילות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट लॉक है। शेष और गतिविधि अपडेट करने के लिए अनलॉक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet terkunci. Buka kunci untuk memperbarui saldo dan aktivitas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Portafoglio bloccato. Sbloccalo per aggiornare saldo e attività."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットはロックされています。残高と履歴を更新するには解除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑이 잠겼습니다. 잔액과 활동을 업데이트하려면 잠금을 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet vergrendeld. Ontgrendel om saldo en activiteit bij te werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfel zablokowany. Odblokuj, aby zaktualizować saldo i aktywność."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Carteira bloqueada. Desbloqueie para atualizar o saldo e a atividade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелёк заблокирован. Разблокируйте его, чтобы обновить баланс и операции."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdan kilitli. Bakiyeyi ve etkinliği güncellemek için kilidi açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманець заблоковано. Розблокуйте його, щоб оновити баланс і операції."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví đã khóa. Mở khóa để cập nhật số dư và hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱包已锁定。解锁以更新余额和活动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錢包已鎖定。解鎖以更新餘額和活動。"
          }
        }
      }
    },
    "wallet_status_ready_to_create": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاهز عند الكتلة %1$d. لن تفحص المحفظة الجديدة الكتل الأقدم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit bei Block %1$d. Eine neue Wallet scannt keine früheren Blöcke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready at block %1$d. A new wallet will not scan earlier blocks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista en el bloque %1$d. Una cartera nueva no examinará bloques anteriores."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در بلوک %1$d آماده است. کیف پول جدید بلوک‌های قدیمی‌تر را پویش نمی‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt au bloc %1$d. Un nouveau portefeuille n’analysera pas les blocs antérieurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוכן בבלוק %1$d. ארנק חדש לא יסרוק בלוקים קודמים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लॉक %1$d पर तैयार। नया वॉलेट पुराने ब्लॉक स्कैन नहीं करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siap pada blok %1$d. Dompet baru tidak akan memindai blok sebelumnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto al blocco %1$d. Un nuovo portafoglio non esaminerà i blocchi precedenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロック%1$dで準備完了。新しいウォレットは以前のブロックをスキャンしません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "블록 %1$d에서 준비됨. 새 지갑은 이전 블록을 스캔하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar op blok %1$d. Een nieuwe wallet scant geen eerdere blokken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowe na bloku %1$d. Nowy portfel nie będzie skanował wcześniejszych bloków."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronta no bloco %1$d. Uma carteira nova não analisará blocos anteriores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово на блоке %1$d. Новый кошелёк не будет сканировать более ранние блоки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d numaralı blokta hazır. Yeni cüzdan önceki blokları taramaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Готово на блоці %1$d. Новий гаманець не скануватиме попередні блоки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sẵn sàng tại khối %1$d. Ví mới sẽ không quét các khối trước đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在区块 %1$d 就绪。新钱包不会扫描更早的区块。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已在區塊 %1$d 就緒。新錢包不會掃描更早的區塊。"
          }
        }
      }
    },
    "wallet_status_recovery_required": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دوّن هذه الكلمات وأكدها. ستبقى الشاشة مضاءة. يؤدي قفل الهاتف أو المغادرة إلى إلغاء الإعداد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe diese Wörter auf und bestätige sie. Der Bildschirm bleibt eingeschaltet. Sperren oder Verlassen bricht die Einrichtung ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write down and confirm these words. This screen stays awake. Locking or leaving cancels setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota y confirma estas palabras. La pantalla permanecerá encendida. Bloquear el teléfono o salir cancela la configuración."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این کلمات را یادداشت و تأیید کنید. صفحه روشن می‌ماند. قفل کردن تلفن یا خروج، راه‌اندازی را لغو می‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez et confirmez ces mots. L’écran restera allumé. Verrouiller le téléphone ou quitter annule la configuration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתבו ואשרו את המילים האלה. המסך יישאר פעיל. נעילת הטלפון או יציאה מבטלות את ההגדרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन शब्दों को लिखें और पुष्टि करें। स्क्रीन चालू रहेगी। फ़ोन लॉक करने या बाहर जाने पर सेटअप रद्द हो जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat dan konfirmasi kata-kata ini. Layar tetap menyala. Mengunci ponsel atau keluar membatalkan penyiapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota e conferma queste parole. Lo schermo rimarrà acceso. Bloccare il telefono o uscire annulla la configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの単語を書き留めて確認してください。画面は点灯したままです。端末をロックするか離れると設定はキャンセルされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단어들을 적고 확인하세요. 화면이 계속 켜져 있습니다. 휴대전화를 잠그거나 나가면 설정이 취소됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf deze woorden op en bevestig ze. Het scherm blijft aan. Vergrendelen of weggaan annuleert de installatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz i potwierdź te słowa. Ekran pozostanie włączony. Zablokowanie telefonu lub wyjście anuluje konfigurację."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote e confirme estas palavras. O ecrã permanecerá ligado. Bloquear o telefone ou sair cancela a configuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите и подтвердите эти слова. Экран останется включённым. Блокировка телефона или выход отменят настройку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kelimeleri yazın ve doğrulayın. Ekran açık kalır. Telefonu kilitlemek veya ayrılmak kurulumu iptal eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть і підтвердьте ці слова. Екран залишатиметься ввімкненим. Блокування телефона або вихід скасують налаштування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại và xác nhận các từ này. Màn hình sẽ luôn sáng. Khóa điện thoại hoặc rời đi sẽ hủy thiết lập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请抄写并确认这些单词。屏幕会保持点亮。锁定手机或离开将取消设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請抄寫並確認這些單字。螢幕會保持亮起。鎖定手機或離開將取消設定。"
          }
        }
      }
    },
