        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אמת את היתרה, הפעילות והשמות העדכניים ביותר לפני השליחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजने से पहले नवीनतम शेष राशि, गतिविधि और नाम सत्यापित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifikasi saldo, aktivitas, dan nama terbaru sebelum mengirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica il saldo, l'attività e i nomi più recenti prima dell'invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信する前に、最新の残高、アクティビティ、および名前を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내기 전에 최신 잔액, 활동 및 이름을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer het laatste saldo, activiteit en namen voordat u verzendt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed wysłaniem sprawdź najnowsze saldo, aktywność i nazwy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o saldo, atividade e nomes mais recentes antes de enviar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед отправкой проверьте последний баланс, активность и имена."
