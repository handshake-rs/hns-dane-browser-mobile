    "wallet_direct_shakescape_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتوفر استضافة المبادلة P2P حتى يتم تثبيت وحدة التحكم HNS المباشرة المملوكة للمحفظة وإلغاء قفلها."
          }
