    "row_wallet_pair_direct_shakescape_summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصل بمنشئ العرض. ستفتح عروضه تلقائيًا. لن تُنقل أي أموال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Ersteller des Angebots verbinden. Seine Angebote werden automatisch geöffnet. Es werden keine Gelder übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to the offer creator. Their offers open automatically. No funds move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conéctate con el creador de la oferta. Sus ofertas se abrirán automáticamente. No se moverán fondos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به سازنده پیشنهاد متصل شوید. پیشنهادهای او خودکار باز می‌شوند. هیچ وجهی جابه‌جا نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous au créateur de l’offre. Ses offres s’ouvriront automatiquement. Aucun fonds ne sera déplacé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחברו ליוצר ההצעה. ההצעות שלו ייפתחו אוטומטית. לא יועברו כספים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़र बनाने वाले से जुड़ें। उसके ऑफ़र अपने आप खुलेंगे। कोई धन नहीं भेजा जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan ke pembuat penawaran. Penawarannya terbuka otomatis. Tidak ada dana yang dipindahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connettiti al creatore dell’offerta. Le sue offerte si apriranno automaticamente. Nessun fondo verrà spostato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オファー作成者に接続します。オファーは自動的に開きます。資金は移動しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안 생성자에게 연결합니다. 제안이 자동으로 열립니다. 자금은 이동하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak verbinding met de maker van de aanbieding. De aanbiedingen openen automatisch. Er wordt geen geld verplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połącz się z twórcą oferty. Jego oferty otworzą się automatycznie. Żadne środki nie zostaną przeniesione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue-se ao criador da oferta. As ofertas serão abertas automaticamente. Nenhum fundo será movido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к создателю предложения. Его предложения откроются автоматически. Средства не перемещаются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teklif sahibine bağlanın. Teklifleri otomatik açılır. Para taşınmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіться до автора пропозиції. Його пропозиції відкриються автоматично. Кошти не переміщуються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối với người tạo chào giá. Các chào giá sẽ tự động mở. Không có tiền nào được chuyển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接报价创建者。其报价会自动打开，不会转移任何资金。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線至報價建立者。其報價會自動開啟，不會移動任何資金。"
          }
        }
      }
    },
