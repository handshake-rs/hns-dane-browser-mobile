    "wallet_bitcoin_sync_validating_chain": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحقق من صحة نقطة تفتيش Bitcoin المتزامنة وحدود إعادة التنظيم... انقضى %1$@."
          }
        },
        "de": {
