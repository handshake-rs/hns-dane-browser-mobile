    "wallet_bitcoin_send_fee_cap_minimum": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الحد الأقصى للرسوم وهو 1000 ساتوشي على الأقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine Höchstgebühr von mindestens 1.000 Satoshis ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a maximum fee of at least 1,000 satoshis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese una tarifa máxima de al menos 1000 satoshis."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حداکثر هزینه حداقل 1000 ساتوشی را وارد کنید."
          }
        },
        "fr": {
