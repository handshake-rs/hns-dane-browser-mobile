        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همتایان در بلوک %1$d موافق نبودند. همگام سازی با سایر همتایان دوباره امتحان می شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pairs n’étaient pas d’accord sur le bloc %1$d. La synchronisation va réessayer avec d'autres pairs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עמיתים לא הסכימו בבלוק %1$d. הסנכרון ינסה שוב עם עמיתים אחרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लॉक %1$d पर सहकर्मी सहमत नहीं थे। अन्य साथियों के साथ सिंक्रोनाइज़ेशन पुनः प्रयास किया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekan-rekan tidak setuju di blok %1$d. Sinkronisasi akan dicoba lagi dengan rekan lainnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I peer non erano d'accordo sul blocco %1$d. La sincronizzazione riproverà con altri peer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピアはブロック %1$d で同意しませんでした。同期は他のピアと再試行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "피어들은 %1$d 블록에서 동의하지 않았습니다. 다른 피어와의 동기화가 다시 시도됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Peers waren het niet eens met blok %1$d. Synchronisatie wordt opnieuw geprobeerd met andere peers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uczestnicy nie zgodzili się w bloku %1$d. Synchronizacja zostanie ponowiona z innymi urządzeniami równorzędnymi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pares não concordaram no bloco %1$d. A sincronização tentará novamente com outros pares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коллеги не согласились с блоком %1$d. Синхронизация будет повторена с другими узлами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akranlar %1$d bloğunda aynı fikirde değildi. Senkronizasyon diğer eşlerle yeniden denenecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Піри не дійшли згоди щодо блоку %1$d. Повторна спроба синхронізації з іншими вузлами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đồng nghiệp không đồng ý ở khối %1$d. Đồng bộ hóa sẽ thử lại với các đồng nghiệp khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同行们在区块 %1$d 上没有达成一致。将重试与其他对等方的同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同行們在區塊 %1$d 上沒有達成協議。將重試與其他對等方的同步。"
          }
        }
      }
    },
