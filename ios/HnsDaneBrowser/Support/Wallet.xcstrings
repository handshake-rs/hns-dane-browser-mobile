    "wallet_value_actions_reject_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التخلص من الموافقة بشكل نظيف، لذلك تم قفل المحفظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
