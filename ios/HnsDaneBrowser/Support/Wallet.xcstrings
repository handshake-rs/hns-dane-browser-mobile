    "wallet_reads_live_connecting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العثور على أقران Handshake المستقلين. الارتفاع المحلي الذي تم التحقق منه %1$d؛ تستمر هذه المزامنة من نقطة التفتيش تلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche nach unabhängigen Handshake-Kollegen. Verifizierte lokale Höhe %1$d; Diese Synchronisierung wird ab diesem Prüfpunkt fortgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finding independent Handshake peers. Verified local height %1$d; this sync continues from that checkpoint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrar pares independientes Handshake. Altura local verificada %1$d; esta sincronización continúa desde ese punto de control."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یافتن همتایان مستقل Handshake. ارتفاع محلی تأیید شده %1$d؛ این همگام سازی از آن ایست بازرسی ادامه می یابد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche de pairs indépendants Handshake. Hauteur locale vérifiée %1$d ; cette synchronisation continue à partir de ce point de contrôle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציאת עמיתים עצמאיים של Handshake. גובה מקומי מאומת %1$d; הסנכרון הזה ממשיך מאותו מחסום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वतंत्र Handshake साथियों को ढूँढना। सत्यापित स्थानीय ऊंचाई %1$d; यह सिंक उस चेकपॉइंट से जारी रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menemukan rekan Handshake yang independen. Ketinggian lokal terverifikasi %1$d; sinkronisasi ini berlanjut dari pos pemeriksaan itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trovare peer Handshake indipendenti. Altezza locale verificata %1$d; questa sincronizzazione continua da quel checkpoint."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立した Handshake ピアを検索します。ローカル高さ %1$d を確認。この同期はそのチェックポイントから継続されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독립적인 Handshake 피어를 찾습니다. 확인된 로컬 높이 %1$d; 이 동기화는 해당 체크포인트에서 계속됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onafhankelijke Handshake-peers vinden. Geverifieerde lokale hoogte %1$d; deze synchronisatie gaat verder vanaf dat controlepunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znajdowanie niezależnych elementów równorzędnych Handshake. Zweryfikowana wysokość lokalna %1$d; ta synchronizacja jest kontynuowana od tego punktu kontrolnego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrar pares Handshake independentes. Altura local verificada %1$d; esta sincronização continua a partir desse ponto de verificação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск независимых пиров Handshake. Подтвержденная локальная высота %1$d; эта синхронизация продолжается с этой контрольной точки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağımsız Handshake eşlerini bulma. Doğrulanmış yerel yükseklik %1$d; bu senkronizasyon o kontrol noktasından devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук незалежних аналогів Handshake. Перевірена локальна висота %1$d; ця синхронізація продовжується з цієї контрольної точки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm các đồng nghiệp Handshake độc lập. Đã xác minh chiều cao cục bộ %1$d; quá trình đồng bộ hóa này tiếp tục từ điểm kiểm tra đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "寻找独立的Handshake同行。验证局部高度%1$d；此同步从该检查点继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找獨立的Handshake同行。驗證局部高度%1$d；此同步從該檢查點繼續。"
          }
        }
      }
    },
    "wallet_reads_live_finalizing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرؤوس ونشاط المحفظة الذي تم التحقق منه موجودان على ارتفاع %1$d. جارٍ إنهاء لقطة القراءة فقط..."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
