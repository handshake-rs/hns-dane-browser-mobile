          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra e desbloqueie uma carteira confirmada antes de enviar HNS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте и разблокируйте подтвержденный кошелек перед отправкой HNS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS'yi göndermeden önce onaylanmış bir cüzdanı açın ve kilidini açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
