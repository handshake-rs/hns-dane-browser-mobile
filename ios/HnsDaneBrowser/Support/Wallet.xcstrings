            "state": "translated",
            "value": "Vergrendel een gevolgde naam en publiceer een geverifieerde vermelding op het Swap Board."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokuj śledzoną nazwę i opublikuj uwierzytelnioną ofertę na tablicy wymiany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueie um nome rastreado e publique uma listagem autenticada no Swap Board."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокируйте отслеживаемое имя и опубликуйте подтвержденный листинг на Swap Board."
