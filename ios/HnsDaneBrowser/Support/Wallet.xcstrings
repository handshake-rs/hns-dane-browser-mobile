        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय स्वैप पीयर को %1$@ से बदल दिया गया। बोर्ड एक्सचेंज बिना रिले के स्थानीय स्तर पर चल रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengganti rekan swap aktif dengan %1$@. Pertukaran papan berjalan secara lokal tanpa relay."
          }
        },
        "it": {
          "stringUnit": {
