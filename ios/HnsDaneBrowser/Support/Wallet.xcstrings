    "wallet_shakedex_queries_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن إكمال استعلام Shakedex من حالة المحفظة والنظير المباشر الحالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Shakedex-Abfrage konnte vom aktuellen direkten Peer- und Wallet-Status aus nicht abgeschlossen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Shakedex query could not be completed from the current direct peer and wallet state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La consulta Shakedex no se pudo completar desde el estado actual de billetera y par directo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پرس و جو Shakedex از وضعیت همتا و کیف پول مستقیم فعلی تکمیل نشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête Shakedex n'a pas pu être exécutée à partir de l'état actuel du homologue direct et du portefeuille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להשלים את השאילתה Shakedex ממצב העמית והארנק הישיר הנוכחי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Shakedex क्वेरी वर्तमान प्रत्यक्ष सहकर्मी और वॉलेट स्थिति से पूरी नहीं की जा सकी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kueri Shakedex tidak dapat diselesaikan dari status rekan dan dompet langsung saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare la query Shakedex dallo stato attuale del peer diretto e del portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のダイレクトピアおよびウォレットの状態からは、Shakedex クエリを完了できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
