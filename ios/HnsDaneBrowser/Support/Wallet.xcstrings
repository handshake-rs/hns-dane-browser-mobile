    "wallet_send_invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل عنوان HNS صالحًا والمبلغ والحد الأقصى للرسوم. لا تستخدم أكثر من 6 منازل عشرية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine gültige HNS-Adresse, einen gültigen Betrag und eine maximale Gebühr ein. Verwenden Sie nicht mehr als 6 Dezimalstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid HNS address, amount, and maximum fee. Use no more than 6 decimal places."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese una dirección HNS válida, un monto y una tarifa máxima. No utilice más de 6 decimales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آدرس HNS معتبر، مبلغ و حداکثر کارمزد را وارد کنید. از 6 رقم اعشار بیشتر استفاده نکنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une adresse HNS valide, un montant et des frais maximum. N'utilisez pas plus de 6 décimales."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן כתובת HNS חוקית, סכום ותשלום מקסימלי. השתמש לא יותר מ-6 מקומות עשרוניים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैध HNS पता, राशि और अधिकतम शुल्क दर्ज करें। 6 दशमलव स्थानों से अधिक का प्रयोग न करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan alamat HNS yang valid, jumlah, dan biaya maksimum. Gunakan tidak lebih dari 6 tempat desimal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un indirizzo HNS valido, un importo e una tariffa massima. Utilizzare non più di 6 cifre decimali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な HNS アドレス、金額、および最大料金を入力してください。小数点以下 6 桁までを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효한 HNS 주소, 금액, 최대 수수료를 입력하세요. 소수점 이하 6자리 이하로 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een geldig HNS-adres, bedrag en maximumtarief in. Gebruik niet meer dan 6 decimalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź prawidłowy adres HNS, kwotę i maksymalną opłatę. Użyj nie więcej niż 6 miejsc po przecinku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um endereço HNS válido, valor e taxa máxima. Use no máximo 6 casas decimais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите действительный адрес HNS, сумму и максимальную комиссию. Используйте не более 6 десятичных знаков."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli bir HNS adresi, tutarı ve maksimum ücreti girin. 6'dan fazla ondalık basamak kullanmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть дійсну адресу HNS, суму та максимальну комісію. Використовуйте не більше 6 знаків після коми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập địa chỉ, số tiền và mức phí tối đa HNS hợp lệ. Sử dụng không quá 6 chữ số thập phân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入有效的 HNS 地址、金额和最高费用。使用不超过 6 位小数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入有效的 HNS 地址、金額和最高費用。使用不超過 6 位小數。"
          }
        }
      }
