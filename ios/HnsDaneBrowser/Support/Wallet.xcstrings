        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなスワップピアを %1$@ に置き換えました。ボード交換はリレーなしでローカルで実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 스왑 피어를 %1$@로 교체했습니다. 보드 교환은 릴레이 없이 로컬로 실행됩니다."
          }
        },
        "nl": {
