    "wallet_send_amount_invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مبلغ HNS موجبًا بما يصل إلى 6 منازل عشرية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen positiven HNS-Betrag mit bis zu 6 Dezimalstellen ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a positive HNS amount with up to 6 decimal places."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese un monto positivo HNS con hasta 6 decimales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقدار HNS مثبت را با حداکثر 6 رقم اعشار وارد کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un montant HNS positif avec jusqu'à 6 décimales."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן סכום HNS חיובי עם עד 6 מקומות עשרוניים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "6 दशमलव स्थानों तक एक सकारात्मक HNS राशि दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan jumlah HNS positif hingga 6 angka desimal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un importo HNS positivo con un massimo di 6 cifre decimali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS の正の金額を小数点以下 6 桁まで入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소수점 이하 6자리까지 양수 HNS 금액을 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een positief HNS-bedrag in met maximaal 6 decimalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź dodatnią kwotę HNS z dokładnością do 6 miejsc po przecinku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um valor HNS positivo com até 6 casas decimais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите положительную сумму HNS до 6 знаков после запятой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla 6 ondalık basamak içeren pozitif bir HNS tutarı girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть позитивну суму HNS із 6 знаками після коми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
