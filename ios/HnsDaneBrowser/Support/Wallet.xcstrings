    "wallet_bitcoin_sync_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُرجع مزامنة Bitcoin لقطة محلية تم التحقق منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bitcoin-Synchronisierung hat keinen verifizierten lokalen Snapshot zurückgegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin synchronization did not return a verified local snapshot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización Bitcoin no devolvió una instantánea local verificada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همگام سازی Bitcoin یک عکس فوری محلی تأیید شده را برگرداند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation Bitcoin n'a pas renvoyé d'instantané local vérifié."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סנכרון Bitcoin לא החזיר תמונת מצב מקומית מאומתת."
