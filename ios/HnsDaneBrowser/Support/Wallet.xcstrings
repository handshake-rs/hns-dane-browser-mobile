          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No names are tracked by this wallet yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta billetera aún no rastrea ningún nombre."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز هیچ نامی توسط این کیف پول ردیابی نشده است."
          }
        },
        "fr": {
          "stringUnit": {
