    "row_wallet_delete_summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح المحفظة، وتحقق من شبكتها وحسابها، ثم أكد مرتين. ولا تتأثر محافظ الشبكة الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren Sie das Wallet, überprüfen Sie sein Netzwerk und Konto und bestätigen Sie dann zweimal. Andere Netzwerk-Wallets sind nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock the wallet, verify its network and account, then confirm twice. Other network wallets are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquee la billetera, verifique su red y cuenta, luego confirme dos veces. Otras carteras de red no se ven afectadas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قفل کیف پول را باز کنید، شبکه و حساب آن را تأیید کنید، سپس دو بار تأیید کنید. سایر کیف پول های شبکه تحت تأثیر قرار نمی گیرند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez le portefeuille, vérifiez son réseau et son compte, puis confirmez deux fois. Les autres portefeuilles réseau ne sont pas affectés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטל את נעילת הארנק, אמת את הרשת והחשבון שלו ולאחר מכן אשר פעמיים. ארנקי רשת אחרים אינם מושפעים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट को अनलॉक करें, उसके नेटवर्क और खाते को सत्यापित करें, फिर दो बार पुष्टि करें। अन्य नेटवर्क वॉलेट प्रभावित नहीं होते हैं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci dompet, verifikasi jaringan dan akunnya, lalu konfirmasi dua kali. Dompet jaringan lain tidak terpengaruh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca il portafoglio, verifica la sua rete e il suo account, quindi conferma due volte. Gli altri portafogli di rete non sono interessati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットのロックを解除し、ネットワークとアカウントを確認してから 2 回確認します。他のネットワークウォレットは影響を受けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑을 잠금 해제하고 네트워크와 계정을 확인한 후 두 번 확인하세요. 다른 네트워크 지갑은 영향을 받지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel de portemonnee, verifieer het netwerk en account en bevestig vervolgens twee keer. Andere netwerkportefeuilles worden niet beïnvloed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj portfel, zweryfikuj jego sieć i konto, a następnie potwierdź dwukrotnie. Nie ma to wpływu na inne portfele sieciowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie a carteira, verifique sua rede e conta e confirme duas vezes. Outras carteiras de rede não são afetadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте кошелек, проверьте его сеть и учетную запись, затем подтвердите дважды. Другие сетевые кошельки не затрагиваются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "M-cüzdanın kilidini açın, ağını ve hesabını doğrulayın ve ardından iki kez onaylayın. Diğer ağ cüzdanları etkilenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте гаманець, перевірте його мережу та обліковий запис, а потім підтвердьте двічі. Інші гаманці мережі не впливають."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa ví, xác minh mạng và tài khoản của nó, sau đó xác nhận hai lần. Các ví mạng khác không bị ảnh hưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁钱包，验证其网络和帐户，然后确认两次。其他网络钱包不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解鎖錢包，驗證其網路和帳戶，然後確認兩次。其他網路錢包不受影響。"
