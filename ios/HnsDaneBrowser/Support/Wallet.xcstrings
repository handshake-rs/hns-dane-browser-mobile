    "wallet_send_reject_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن التخلص من الموافقة المعلقة بشكل نظيف، لذلك تم قفل المحفظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausstehende Genehmigung konnte nicht sauber verworfen werden, sodass das Wallet gesperrt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The pending approval could not be discarded cleanly, so the wallet was locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aprobación pendiente no se pudo descartar limpiamente, por lo que se bloqueó la billetera."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تأییدیه معلق را نمی‌توان به‌طور تمیز دور انداخت، بنابراین کیف پول قفل شد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’approbation en attente n’a pas pu être rejetée proprement, le portefeuille a donc été verrouillé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לזרוק בצורה נקייה את האישור הממתין, ולכן הארנק היה נעול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबित अनुमोदन को साफ-साफ खारिज नहीं किया जा सकता था, इसलिए वॉलेट लॉक कर दिया गया था।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persetujuan yang tertunda tidak dapat dibuang begitu saja, sehingga dompet terkunci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile eliminare l'approvazione in sospeso, quindi il portafoglio era bloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中の承認をきれいに破棄できなかったため、ウォレットがロックされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보류 중인 승인을 깔끔하게 폐기할 수 없어 지갑이 잠겼습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De hangende goedkeuring kon niet netjes worden weggegooid, dus de portemonnee was op slot."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekującego na zatwierdzenie nie można było odrzucić, więc portfel został zablokowany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aprovação pendente não pôde ser descartada de forma limpa, então a carteira foi bloqueada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидающее одобрение не могло быть полностью отброшено, поэтому кошелек был заблокирован."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen onay temiz bir şekilde atılamadığı için cüzdan kilitlendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Затвердження, яке очікує на підтвердження, не можна було повністю викинути, тому гаманець було заблоковано."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể loại bỏ hoàn toàn phê duyệt đang chờ xử lý nên ví đã bị khóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待批准的东西无法彻底丢弃，因此钱包被锁定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待批准的東西無法徹底丟棄，因此錢包被鎖定。"
          }
        }
      }
    },
    "wallet_send_rejected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
