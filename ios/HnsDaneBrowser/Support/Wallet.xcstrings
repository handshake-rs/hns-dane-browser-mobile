    "wallet_reads_balance_confirmed_with_pending": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تأكيد %1$@ HNS على السلسلة \n%2$@ HNS في انتظار المعاملات الصادرة \n المعلقة، يرجى الانتظار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS in der Kette bestätigt\n%2$@ HNS ausstehend\nTransaktion ausstehend, bitte warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS confirmed on chain\n%2$@ HNS pending outgoing\nTransaction Pending, please wait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS confirmado en cadena\n%2$@ HNS pendiente de salida\nTransacción pendiente, por favor espere."
