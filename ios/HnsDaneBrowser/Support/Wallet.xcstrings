    "wallet_bitcoin_syncing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المزامنة مع أقرانك في Bitcoin... يمكنك مغادرة هذه الشاشة؛ يظهر الإخطار التقدم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisierung mit Bitcoin-Peers… Sie können diesen Bildschirm verlassen; Die Benachrichtigung zeigt den Fortschritt an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncing with Bitcoin peers… You can leave this screen; the notification shows progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizando con pares Bitcoin... Puede salir de esta pantalla; la notificación muestra el progreso."
