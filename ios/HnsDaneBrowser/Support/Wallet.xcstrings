    "wallet_direct_shakescape_exchange_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم توصيل نقطة النهاية المباشرة ولكن تم رفض التبادل الأولي للوحة. لم يتم استبدال النظير المباشر النشط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der direkte Endpunkt wurde verbunden, aber der ursprüngliche Austausch der Platine wurde abgelehnt. Der aktive direkte Peer wurde nicht ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The direct endpoint connected but the initial board exchange was rejected. The active direct peer was not replaced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El punto final directo se conectó pero se rechazó el intercambio de placa inicial. El par directo activo no fue reemplazado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نقطه پایانی مستقیم متصل شد اما تبادل اولیه برد رد شد. همتای مستقیم فعال جایگزین نشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le point de terminaison direct s'est connecté mais l'échange initial de carte a été rejeté. L'homologue direct actif n'a pas été remplacé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נקודת הקצה הישירה התחברה אך החלפת הלוח הראשונית נדחתה. העמית הישיר הפעיל לא הוחלף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्यक्ष समापन बिंदु जुड़ा लेकिन प्रारंभिक बोर्ड एक्सचेंज अस्वीकार कर दिया गया। सक्रिय प्रत्यक्ष सहकर्मी को प्रतिस्थापित नहीं किया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Titik akhir langsung terhubung tetapi pertukaran papan awal ditolak. Rekan langsung yang aktif tidak diganti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'endpoint diretto si è connesso ma lo scambio iniziale della scheda è stato rifiutato. Il peer diretto attivo non è stato sostituito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接エンドポイントは接続されましたが、最初のボード交換は拒否されました。アクティブなダイレクト ピアは置き換えられませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 엔드포인트가 연결되었지만 초기 보드 교환이 거부되었습니다. 활성 직접 피어가 교체되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het directe eindpunt was verbonden, maar de initiële boarduitwisseling werd afgewezen. De actieve directe peer is niet vervangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpośredni punkt końcowy został podłączony, ale początkowa wymiana karty została odrzucona. Aktywny bezpośredni element równorzędny nie został zastąpiony."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O endpoint direto foi conectado, mas a troca inicial da placa foi rejeitada. O peer direto ativo não foi substituído."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямая конечная точка подключилась, но первоначальная замена платы была отклонена. Активный прямой одноранговый узел не был заменен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan uç nokta bağlandı ancak ilk kart değişimi reddedildi. Etkin doğrudan eş değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пряма кінцева точка підключилася, але початковий обмін платою було відхилено. Активний прямий одноранговий пристрій не було замінено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Điểm cuối trực tiếp được kết nối nhưng việc trao đổi bảng ban đầu bị từ chối. Đồng nghiệp trực tiếp đang hoạt động không được thay thế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接端点已连接，但初始板交换被拒绝。未替换活动的直接对等方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接端點已連接，但初始板交換被拒絕。未替換活動的直接對等方。"
          }
        }
      }
    },
    "wallet_direct_shakescape_host_listening": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\n اتصل بمنشئ العرض لتصفح العروض. الاستضافة اختيارية. \n\nمتقدم: الاستماع على منفذ TCP %1$d. %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nStellen Sie eine Verbindung zu einem Angebotsersteller her, um Angebote zu durchsuchen. Hosting ist optional.\n\nAFortgeschritten: Abhören am TCP-Port %1$d. %3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nConnect to an offer creator to browse offers. Hosting is optional.\n\nAdvanced: listening on TCP port %1$d. %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nConéctese a un creador de ofertas para buscar ofertas. El alojamiento es opcional.\n\nAdvanzado: escuchando en el puerto TCP %1$d. %3$@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\n برای مرور پیشنهادات به ایجادکننده پیشنهاد وصل شوید. میزبانی اختیاری است.\n\nAپیشرفته: گوش دادن به درگاه TCP %1$d. %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nConnectez-vous à un créateur d'offres pour parcourir les offres. L'hébergement est optionnel.\n\nAvancé : écoute sur le port TCP %1$d. %3$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\n התחבר ליוצר הצעה כדי לעיין בהצעות. אירוח הוא אופציונלי.\n\nAמתקדם: האזנה ביציאת TCP %1$d. %3$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nऑफर ब्राउज़ करने के लिए ऑफर निर्माता से जुड़ें। होस्टिंग वैकल्पिक है।\n\nउन्नत: TCP पोर्ट %1$d पर सुनना। %3$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nHubungkan ke pembuat penawaran untuk menelusuri penawaran. Hosting bersifat opsional.\n\nALanjutan: mendengarkan pada port TCP %1$d. %3$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nConnettiti a un creatore di offerte per sfogliare le offerte. L'hosting è opzionale.\n\nAvanzato: ascolto sulla porta TCP %1$d. %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nオファー作成者に接続してオファーを参照します。ホスティングはオプションです。\n\n詳細: TCP ポート %1$d でリッスンします。%3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\n오퍼 작성자에게 연결하여 오퍼를 찾아보세요. 호스팅은 선택 사항입니다.\n\nAdvanced: TCP 포트 %1$d에서 수신 대기합니다. %3$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nMaak verbinding met een maker van aanbiedingen om door aanbiedingen te bladeren. Hosting is optioneel.\n\nGeavanceerd: luisteren op TCP-poort %1$d. %3$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nPołącz się z kreatorem ofert, aby przeglądać oferty. Hosting jest opcjonalny.\n\nAzaawansowane: nasłuchiwanie na porcie TCP %1$d. %3$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nConecte-se a um criador de ofertas para navegar pelas ofertas. A hospedagem é opcional.\n\nAvançado: escuta na porta TCP %1$d. %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nПодключитесь к создателю предложений, чтобы просмотреть предложения. Хостинг не является обязательным. \n\nДополнительно: прослушивание порта TCP %1$d. %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nTekliflere göz atmak için bir teklif oluşturucuya bağlanın. Barındırma isteğe bağlıdır.\n\nAGelişmiş: TCP bağlantı noktası %1$d üzerinde dinleme. %3$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nПідключіться до творця пропозицій, щоб переглядати пропозиції. Хостинг необов’язковий.\n\nAAdvanced: прослуховування на порту TCP %1$d. %3$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\nKết nối với người tạo ưu đãi để duyệt các ưu đãi. Lưu trữ là tùy chọn.\n\nNâng cao: nghe trên cổng TCP %1$d. %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\n连接到报价创建者以浏览报价。托管是可选的。\n\n高级：侦听 TCP 端口 %1$d。 %3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@\n\n連接到報價建立者以瀏覽報價。託管是可選的。 \n\n進階：偵聽 TCP 連接埠 %1$d。 %3$@"
          }
        }
      }
    },
    "wallet_direct_shakescape_host_retry_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال استضافة المبادلة P2P غير متاحة. لم تتغير المحفظة وحالة HNS التي تم التحقق منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P Swap-Hosting ist immer noch nicht verfügbar. Das Wallet und der verifizierte HNS-Status bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P swap hosting is still unavailable. The wallet and verified HNS state are unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El alojamiento de intercambio P2P aún no está disponible. La billetera y el estado verificado de HNS no cambian."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "میزبانی تعویض P2P هنوز در دسترس نیست. کیف پول و وضعیت تأیید شده HNS بدون تغییر هستند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hébergement swap P2P n'est toujours pas disponible. Le portefeuille et l’état HNS vérifié sont inchangés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אירוח חילופי P2P עדיין לא זמין. הארנק ומצב HNS המאומת אינם משתנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P स्वैप होस्टिंग अभी भी उपलब्ध नहीं है। वॉलेट और सत्यापित HNS स्थिति अपरिवर्तित हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosting pertukaran P2P masih belum tersedia. Dompet dan status HNS terverifikasi tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hosting di scambio P2P non è ancora disponibile. Il portafoglio e lo stato HNS verificato rimangono invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P スワップ ホスティングはまだ利用できません。ウォレットと検証済みの HNS の状態は変化しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P 스왑 호스팅은 아직 사용할 수 없습니다. 지갑과 검증된 HNS 상태는 변경되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P-swaphosting is nog steeds niet beschikbaar. De portemonnee en de geverifieerde status HNS zijn ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hosting wymiany P2P jest nadal niedostępny. Portfel i zweryfikowany stan HNS pozostają niezmienione."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A hospedagem swap P2P ainda não está disponível. A carteira e o estado HNS verificado permanecem inalterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хостинг подкачки P2P по-прежнему недоступен. Кошелек и подтвержденное состояние HNS не изменились."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P takas barındırma hâlâ kullanılamıyor. M-cüzdan ve doğrulanmış HNS durumu değişmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P своп-хостинг все ще недоступний. Гаманець і підтверджений стан HNS не змінені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu trữ trao đổi P2P vẫn không khả dụng. Ví và trạng thái HNS đã được xác minh không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P 交换托管仍然不可用。钱包和已验证的HNS状态不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P 交換託管仍然不可用。錢包和已驗證的HNS狀態不變。"
          }
        }
      }
    },
    "wallet_direct_shakescape_host_retry_ready": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استضافة المبادلة P2P تستمع مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P Swap-Hosting lauscht wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "P2P swap hosting is listening again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El alojamiento de intercambio P2P está escuchando nuevamente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "میزبانی تعویض P2P دوباره در حال گوش دادن است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hébergement swap P2P est à nouveau à l'écoute."
          }
        },
        "he": {
          "stringUnit": {
