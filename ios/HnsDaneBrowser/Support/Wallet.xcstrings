    "wallet_direct_shakescape_connected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مبادلة الأقران %1$@ متصلة. يتم تشغيل تبادل المجلس محليا دون التتابع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap-Peer %1$@ verbunden. Der Board-Austausch läuft lokal ohne Relay."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swap peer %1$@ connected. Board exchange is running locally without a relay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intercambie el par %1$@ conectado. El intercambio de tarjetas se realiza localmente sin relé."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تبادل همتای %1$@ متصل است. تبادل برد به صورت محلی بدون رله در حال اجرا است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échangez le homologue %1$@ connecté. L'échange de cartes fonctionne localement sans relais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלף עמית %1$@ מחובר. החלפת לוח פועלת באופן מקומי ללא ממסר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वैप पियर %1$@ कनेक्ट हुआ। बोर्ड एक्सचेंज बिना रिले के स्थानीय स्तर पर चल रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tukar rekan %1$@ yang terhubung. Pertukaran papan berjalan secara lokal tanpa relay."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scambia peer %1$@ connesso. Lo scambio della scheda è in esecuzione localmente senza relè."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワップピア %1$@ が接続されました。ボード交換はリレーなしでローカルで実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스왑 피어 %1$@가 연결되었습니다. 보드 교환은 릴레이 없이 로컬로 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisselpeer %1$@ aangesloten. Borduitwisseling vindt lokaal plaats zonder relais."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłączony element równorzędny %1$@. Wymiana płytek odbywa się lokalnie bez przekaźnika."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponto de troca %1$@ conectado. A troca de placas está funcionando localmente sem relé."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узел обмена %1$@ подключен. Обмен платами осуществляется локально, без реле."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşi değiştir %1$@ bağlı. Kart değişimi yerel olarak röle olmadan çalışıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключено обмінний вузол %1$@. Обмін платою працює локально без реле."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoán đổi ngang hàng %1$@ được kết nối. Trao đổi bảng đang chạy cục bộ mà không cần chuyển tiếp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交换对等点 %1$@ 已连接。板交换在本地运行，无需中继。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交換對等點 %1$@ 已連線。板交換在本地運行，無需中繼。"
          }
        }
      }
    },
