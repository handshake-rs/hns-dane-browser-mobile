            "value": "Синхронізація прямого стану HNS перед підготовкою точної рідної дії…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang đồng bộ hóa trạng thái HNS trực tiếp trước khi chuẩn bị hành động gốc chính xác…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在准备确切的本机操作之前同步直接 HNS 状态..."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在準備確切的本機操作之前同步直接 HNS 狀態..."
          }
        }
      }
    },
    "wallet_value_actions_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظل الاسم الأصلي وإجراءات Shakedex غير متاحة حتى تصبح تدفقات الأقران التي تم التحقق منها والمملوكة للمحفظة جاهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktionen „Nativer Name“ und „Shakedex“ bleiben solange nicht verfügbar, bis ihre verifizierten Peer-Flows im Besitz der Wallet bereit sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native name and Shakedex actions remain unavailable until their wallet-owned verified peer flows are ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las acciones de nombre nativo y Shakedex no están disponibles hasta que los flujos de pares verificados de propiedad de su billetera estén listos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام اصلی و عملکردهای Shakedex تا زمانی که جریان‌های همتای تأیید شده متعلق به کیف پول آن‌ها آماده نشود، در دسترس نیستند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nom natif et les actions Shakedex restent indisponibles jusqu'à ce que les flux homologues vérifiés appartenant au portefeuille soient prêts."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולות השם המקורי ו-Shakedex נשארות לא זמינות עד שתזרימי העמיתים המאומתים בבעלות הארנק יהיו מוכנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल नाम और Shakedex क्रियाएं तब तक अनुपलब्ध रहती हैं जब तक कि उनके वॉलेट-स्वामित्व वाले सत्यापित सहकर्मी प्रवाह तैयार नहीं हो जाते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama asli dan tindakan Shakedex tetap tidak tersedia hingga aliran rekan terverifikasi milik dompet mereka siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il nome nativo e le azioni Shakedex rimangono non disponibili finché i flussi peer verificati di proprietà del portafoglio non saranno pronti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ名および Shakedex アクションは、ウォレットが所有する検証済みピア フローの準備が整うまで使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑 소유의 검증된 피어 흐름이 준비될 때까지 기본 이름 및 Shakedex 작업을 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Native naam- en Shakedex-acties blijven niet beschikbaar totdat de geverifieerde peer-stromen in de portemonnee gereed zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa natywna i akcje Shakedex pozostają niedostępne, dopóki ich zweryfikowane przepływy równorzędne należące do portfela nie będą gotowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome nativo e as ações Shakedex permanecem indisponíveis até que seus fluxos de pares verificados de propriedade da carteira estejam prontos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собственное имя и действия Shakedex остаются недоступными до тех пор, пока не будут готовы их проверенные одноранговые потоки, принадлежащие кошельку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel ad ve Shakedex eylemleri, cüzdanın sahip olduğu doğrulanmış eş akışları hazır olana kadar kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Власне ім’я та дії Shakedex залишаються недоступними, доки не будуть готові перевірені однорангові потоки, що належать гаманцю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên gốc và hành động Shakedex vẫn không khả dụng cho đến khi các luồng ngang hàng được xác minh thuộc sở hữu ví của chúng sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在钱包拥有的经过验证的对等流准备就绪之前，本机名称和 Shakedex 操作将保持不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在錢包擁有的經過驗證的對等流準備就緒之前，本機名稱和 Shakedex 操作將保持不可用。"
          }
        }
      }
    },
