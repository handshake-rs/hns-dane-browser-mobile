        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את נעילת הארנק כדי לארח או להתאים בין עמית להחלפה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वैप पीयर को होस्ट या पेयर करने के लिए वॉलेट को अनलॉक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci dompet untuk menghosting atau memasangkan rekan swap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca il portafoglio per ospitare o accoppiare un peer di scambio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットのロックを解除して、スワップピアをホストまたはペアリングします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스왑 피어를 호스팅하거나 페어링하려면 지갑을 잠금 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel de portemonnee om een swap-peer te hosten of te koppelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj portfel, aby hostować lub sparować partnera wymiany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie a carteira para hospedar ou emparelhar um ponto de troca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте кошелек, чтобы разместить или подключить узел обмена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir takas eşini barındırmak veya eşleştirmek için cüzdanın kilidini açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
