          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן עמלה מקסימלית של לפחות 1,000 סאטושי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम 1,000 सातोशी की अधिकतम फीस दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
