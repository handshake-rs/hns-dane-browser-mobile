        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronisasi Bitcoin tidak menghasilkan snapshot lokal terverifikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione Bitcoin non ha restituito uno snapshot locale verificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 同期は検証済みのローカル スナップショットを返しませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 동기화가 확인된 로컬 스냅샷을 반환하지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin-synchronisatie heeft geen geverifieerde lokale momentopname geretourneerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja Bitcoin nie zwróciła zweryfikowanej lokalnej migawki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização Bitcoin não retornou um instantâneo local verificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация Bitcoin не вернула проверенный локальный снимок."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin senkronizasyonu doğrulanmış bir yerel anlık görüntü döndürmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізація Bitcoin не повернула перевірений локальний знімок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ hóa Bitcoin không trả về ảnh chụp nhanh cục bộ đã được xác minh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 同步未返回经过验证的本地快照。"
