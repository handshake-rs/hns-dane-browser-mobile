    "wallet_value_actions_invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حقول العمل ليست أساسية. HNS يصل الدعم إلى 6 منازل عشرية على الأكثر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktionsfelder sind nicht kanonisch. HNS Beträge unterstützen maximal 6 Dezimalstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action fields are not canonical. HNS amounts support at most 6 decimal places."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los campos de acción no son canónicos. Los importes HNS admiten como máximo 6 decimales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زمینه های عمل متعارف نیستند. مقادیر HNS حداکثر از 6 رقم اعشار پشتیبانی می کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les champs d'action ne sont pas canoniques. Les montants HNS prennent en charge au maximum 6 décimales."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שדות הפעולה אינם קנוניים. HNS תומך ב-6 מקומות עשרוניים לכל היותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रिया क्षेत्र विहित नहीं हैं. HNS अधिकतम 6 दशमलव स्थानों पर समर्थन प्रदान करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bidang tindakan tidak kanonik. Jumlah HNS mendukung paling banyak 6 tempat desimal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I campi di azione non sono canonici. Gli importi HNS supportano al massimo 6 cifre decimali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクションフィールドは正規ではありません。 HNS の金額は、小数点以下 6 桁までサポートされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업 필드는 표준이 아닙니다. HNS 금액은 소수점 이하 6자리까지 지원됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De actievelden zijn niet canoniek. HNS-bedragen ondersteunen maximaal 6 decimalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pola akcji nie są kanoniczne. HNS obsługuje kwoty z dokładnością do 6 miejsc po przecinku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os campos de ação não são canônicos. Os valores HNS suportam no máximo 6 casas decimais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поля действий не каноничны. Суммы HNS поддерживают не более 6 знаков после запятой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eylem alanları kanonik değildir. HNS miktarları en fazla 6 ondalık basamağı destekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поля дії не є канонічними. Суми HNS підтримують не більше 6 знаків після коми."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trường hành động không chuẩn. Số lượng HNS hỗ trợ tối đa 6 chữ số thập phân."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作字段不规范。 HNS 金额最多支持 6 位小数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作字段不規範。 HNS 金額最多支援 6 位小數。"
          }
        }
      }
    },
    "wallet_value_actions_locked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بفتح القفل والمزامنة قبل إعداد اسم أو إجراء Shakedex."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren und synchronisieren Sie, bevor Sie einen Namen oder eine Shakedex-Aktion vorbereiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock and synchronize before preparing a name or Shakedex action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquee y sincronice antes de preparar un nombre o acción Shakedex."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل از تهیه نام یا اقدام Shakedex قفل را باز کرده و همگام کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déverrouillez et synchronisez avant de préparer un nom ou une action Shakedex."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטל את הנעילה וסנכרן לפני הכנת שם או פעולת Shakedex."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम या Shakedex क्रिया तैयार करने से पहले अनलॉक और सिंक्रोनाइज़ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci dan sinkronkan sebelum menyiapkan nama atau tindakan Shakedex."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca e sincronizza prima di preparare un nome o un'azione Shakedex."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前または Shakedex アクションを準備する前に、ロックを解除して同期してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름 또는 Shakedex 작업을 준비하기 전에 잠금을 해제하고 동기화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel en synchroniseer voordat u een naam of Shakedex-actie voorbereidt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj i zsynchronizuj przed przygotowaniem nazwy lub akcji Shakedex."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie e sincronize antes de preparar um nome ou ação Shakedex."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте и синхронизируйте перед подготовкой имени или действия Shakedex."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ad veya Shakedex eylemi hazırlamadan önce kilidi açın ve senkronize edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте та синхронізуйте перед підготовкою імені або дії Shakedex."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa và đồng bộ hóa trước khi chuẩn bị tên hoặc hành động Shakedex."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在准备名称或 Shakedex 操作之前解锁并同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在準備名稱或 Shakedex 操作之前解鎖並同步。"
          }
        }
      }
    },
    "wallet_value_actions_prepare_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تحضير الإجراء من حالة المزامنة الحالية. لم تتم الموافقة على أي معاملة أو بثها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktion konnte im aktuellen Synchronisierungsstatus nicht vorbereitet werden. Es wurde keine Transaktion genehmigt oder veröffentlicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action could not be prepared from the current synchronized state. No transaction was approved or broadcast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción no se pudo preparar desde el estado sincronizado actual. No se aprobó ni transmitió ninguna transacción."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کنش از حالت همگام‌سازی کنونی آماده نشد. هیچ تراکنشی تایید یا پخش نشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'action n'a pas pu être préparée à partir de l'état synchronisé actuel. Aucune transaction n'a été approuvée ou diffusée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להכין את הפעולה מהמצב המסונכרן הנוכחי. שום עסקה לא אושרה או שודרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्रवाई वर्तमान सिंक्रनाइज़ स्थिति से तैयार नहीं की जा सकी. किसी भी लेन-देन को मंजूरी या प्रसारण नहीं किया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan tidak dapat dipersiapkan dari keadaan tersinkronisasi saat ini. Tidak ada transaksi yang disetujui atau disiarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile preparare l'azione dallo stato sincronizzato corrente. Nessuna transazione è stata approvata o trasmessa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の同期状態からアクションを準備できませんでした。トランザクションは承認またはブロードキャストされませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 동기화된 상태에서는 작업을 준비할 수 없습니다. 거래가 승인되거나 공개되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De actie kon niet worden voorbereid vanuit de huidige gesynchroniseerde status. Er is geen transactie goedgekeurd of uitgezonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przygotować akcji na podstawie bieżącego stanu synchronizacji. Żadna transakcja nie została zatwierdzona ani opublikowana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A ação não pôde ser preparada a partir do estado sincronizado atual. Nenhuma transação foi aprovada ou transmitida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подготовить действие из текущего синхронизированного состояния. Ни одна транзакция не была одобрена или передана в эфир."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eylem mevcut senkronize durumdan hazırlanamadı. Hiçbir işlem onaylanmadı veya yayınlanmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підготувати дію з поточного синхронізованого стану. Жодна трансакція не була схвалена чи трансльована."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể chuẩn bị hành động từ trạng thái đồng bộ hóa hiện tại. Không có giao dịch nào được phê duyệt hoặc phát sóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从当前同步状态准备操作。没有交易被批准或广播。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法從目前同步狀態準備操作。沒有交易被批准或廣播。"
          }
        }
      }
    },
