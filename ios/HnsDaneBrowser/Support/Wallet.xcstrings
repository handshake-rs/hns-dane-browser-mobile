        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS श्रृंखला पर पुष्टि की गई\n%2$@ HNS लंबित आउटगोइंग\n लेनदेन लंबित, कृपया प्रतीक्षा करें।"
