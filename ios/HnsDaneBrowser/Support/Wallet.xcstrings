    "wallet_swap_execution_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الجلسة: %1$@\nالحالة: %2$@\n الدور المحلي: %3$@\n أمر التمويل: %4$@، ثم %5$@\n تأكيد التمويل الأول: %6$@\n تأكيد التمويل الثاني: %7$@\n الموعد النهائي للتمويل الجديد: Unix %8$d\n وقت استرداد السلسلة الأولى: Unix %9$d\n وقت استرداد السلسلة الثانية: Unix %10$d\n سبب الفشل: %11$@\n\n فقط أدلة السلسلة التي تم التحقق منها محليًا تعمل على تقدم هذه الحالة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sitzung: %1$@\nStatus: %2$@\nLokale Rolle: %3$@\nFinanzierungsauftrag: %4$@, dann %5$@\nErste Finanzierung bestätigt: %6$@\nZweite Finanzierung bestätigt: %7$@\nNeue Finanzierungsfrist: Unix %8$d\nRückerstattungszeit der ersten Kette: Unix %9$d\nRückerstattungszeit der zweiten Kette: Unix %10$d\nFehlergrund: %11$@\n\nNur lokal überprüfte Kettennachweise erhöhen diesen Status."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Session: %1$@\nState: %2$@\nLocal role: %3$@\nFunding order: %4$@, then %5$@\nFirst funding confirmed: %6$@\nSecond funding confirmed: %7$@\nNew-funding deadline: Unix %8$d\nFirst-chain refund time: Unix %9$d\nSecond-chain refund time: Unix %10$d\nFailure reason: %11$@\n\nOnly locally verified chain evidence advances this status."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesión: %1$@\nEstado: %2$@\nRol local: %3$@\nOrden de financiación: %4$@, luego %5$@\nPrimera financiación confirmada: %6$@\nSegundo financiamiento confirmado: %7$@\nFecha límite para nuevo financiamiento: Unix %8$d\nTiempo de reembolso de la primera cadena: Unix %9$d\nTiempo de reembolso de la segunda cadena: Unix %10$d\nMotivo del error: %11$@\n\nSolo la evidencia de cadena verificada localmente avanza en este estado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسه: %1$@\nوضعیت: %2$@\nنقش محلی: %3$@\nسفارش تأمین مالی: %4$@، سپس %5$@\nاولین تأمین مالی تأیید شد: %6$@\nاعتبار دوم تأیید شد: %7$@\nمهلت تامین مالی جدید: Unix %8$d\nزمان بازپرداخت زنجیره اول: Unix %9$d\nزمان بازپرداخت زنجیره دوم: Unix %10$d\nدلیل خرابی: %11$@\n\nفقط شواهد زنجیره ای تایید شده محلی این وضعیت را ارتقا می دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Session : %1$@\nÉtat : %2$@\nRôle local : %3$@\nOrdre de financement : %4$@, puis %5$@\nPremier financement confirmé : %6$@\nDeuxième financement confirmé : %7$@\nNouvelle date limite de financement : Unix %8$d\nDélai de remboursement de la première chaîne : Unix %9$d\nDélai de remboursement de la deuxième chaîne : Unix %10$d\nRaison de l'échec : %11$@\n\nSeules les preuves de chaîne vérifiées localement font progresser ce statut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעלה: %1$@\nמצב: %2$@\nתפקיד מקומי: %3$@\nהזמנת מימון: %4$@ ולאחר מכן %5$@\nמימון ראשון אושר: %6$@\nמימון שני אושר: %7$@\nמועד אחרון למימון חדש: Unix %8$d\nזמן החזר בשרשרת ראשונה: Unix %9$d\nזמן החזר בשרשרת שנייה: Unix %10$d\nסיבת כשל: %11$@\n\nרק ראיות שרשרת מאומתות מקומיות מקדמות את הסטטוס הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सत्र: %1$@\nराज्य: %2$@\nस्थानीय भूमिका: %3$@\nफंडिंग ऑर्डर: %4$@, फिर %5$@\nपहली फंडिंग की पुष्टि: %6$@\nदूसरी फंडिंग की पुष्टि: %7$@\nनई-फंडिंग की समय सीमा: Unix %8$d\n पहली-चेन रिफंड समय: Unix %9$d\nदूसरी-श्रृंखला धनवापसी समय: Unix %10$d\nविफलता का कारण: %11$@\n\nकेवल स्थानीय रूप से सत्यापित श्रृंखला साक्ष्य इस स्थिति को आगे बढ़ाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesi: %1$@\nNegara: %2$@\nPeran lokal: %3$@\nUrutan pendanaan: %4$@, lalu %5$@\nPendanaan pertama dikonfirmasi: %6$@\nPendanaan kedua dikonfirmasi: %7$@\nBatas waktu pendanaan baru: Unix %8$d\nWaktu pengembalian dana rantai pertama: Unix %9$d\nWaktu pengembalian dana rantai kedua: Unix %10$d\nAlasan kegagalan: %11$@\n\nHanya bukti rantai yang diverifikasi secara lokal yang dapat meningkatkan status ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessione: %1$@\nStato: %2$@\nRuolo locale: %3$@\nOrdine di finanziamento: %4$@, quindi %5$@\nPrimo finanziamento confermato: %6$@\nSecondo finanziamento confermato: %7$@\nScadenza nuovo finanziamento: Unix %8$d\nTempo di rimborso della prima catena: Unix %9$d\nTempo di rimborso della seconda catena: Unix %10$d\nMotivo dell'errore: %11$@\n\nSolo le prove della catena verificate localmente fanno avanzare questo stato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッション: %1$@\n状態: %2$@\nローカル役割: %3$@\n資金調達注文: %4$@ 、次に %5$@\n最初の資金調達が確認されました: %6$@\n2 回目の資金調達が確認されました: %7$@\n新規資金調達期限: Unix %8$d\n最初のチェーンの払い戻し時間: Unix %9$d\nセカンドチェーンの返金時間: Unix %10$d\n失敗の理由: %11$@\n\nローカルで検証されたチェーン証拠のみがこのステータスを前進させます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션: %1$@\n상태: %2$@\n로컬 역할: %3$@\n펀딩 순서: %4$@, 이후 %5$@\n첫 번째 펀딩 확인: %6$@\n두 번째 펀딩 확정: %7$@\n신규 펀딩 마감일: Unix %8$d\n첫 번째 체인 환불 시간: Unix %9$d\n두 번째 체인 환불 시간: Unix %10$d\n실패 이유: %11$@\n\n로컬에서 검증된 체인 증거만이 이 상태를 발전시킵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessie: %1$@\nState: %2$@\nLokale rol: %3$@\nFinancieringsvolgorde: %4$@, daarna %5$@\nEerste financiering bevestigd: %6$@\nTweede financiering bevestigd: %7$@\n Deadline voor nieuwe financiering: Unix %8$d\n Terugbetalingstijd eerste keten: Unix %9$d\nRestitutietijd tweede keten: Unix %10$d\n Reden van fout: %11$@\n\nO Alleen lokaal geverifieerd ketenbewijs bevordert deze status."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja: %1$@\nStan: %2$@\nRola lokalna: %3$@\nZlecenie finansowania: %4$@, następnie %5$@\nPierwsze finansowanie potwierdzone: %6$@\nPotwierdzono drugie finansowanie: %7$@\nTermin nowego finansowania: Unix %8$d\nCzas zwrotu pierwszego łańcucha: Unix %9$d\nCzas zwrotu kosztów w drugim łańcuchu: Unix %10$d\nPrzyczyna niepowodzenia: %11$@\n\nTylko zweryfikowane lokalnie dowody łańcucha zwiększają ten status."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessão: %1$@\nEstado: %2$@\nFunção local: %3$@\nOrdem de financiamento: %4$@, depois %5$@\nPrimeiro financiamento confirmado: %6$@\nSegundo financiamento confirmado: %7$@\nNovo prazo de financiamento: Unix %8$d\nTempo de reembolso da primeira cadeia: Unix %9$d\nTempo de reembolso da segunda cadeia: Unix %10$d\nMotivo da falha: %11$@\n\nApenas evidências de cadeia verificadas localmente avançam esse status."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сессия: %1$@\nСостояние: %2$@\nЛокальная роль: %3$@\nПоручение на финансирование: %4$@, затем %5$@\nПервое финансирование подтверждено: %6$@\nВторое финансирование подтверждено: %7$@\nСрок нового финансирования: Unix %8$d\nВремя возврата первой цепочки: Unix %9$d\nВремя возврата второй цепочки: Unix %10$d\nПричина сбоя: %11$@\n\nТолько локально проверенные доказательства цепочки повышают этот статус."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum: %1$@\nDevlet: %2$@\nYerel rol: %3$@\nFonlama sırası: %4$@, ardından %5$@\nİlk finansman onaylandı: %6$@\nİkinci finansman onaylandı: %7$@\nYeni finansman son tarihi: Unix %8$d\nİlk zincir geri ödeme süresi: Unix %9$d\nİkinci zincir geri ödeme süresi: Unix %10$d\nArıza nedeni: %11$@\n\nYalnızca yerel olarak doğrulanmış zincir kanıtı bu durumu ilerletir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сесія: %1$@\nСтан: %2$@\nЛокальна роль: %3$@\nПорядок фінансування: %4$@, потім %5$@\nПерше фінансування підтверджено: %6$@\nПідтверджено друге фінансування: %7$@\nКрайній термін фінансування: Unix %8$d\nЧас повернення коштів у першому ланцюжку: Unix %9$d\nЧас повернення коштів у другому ланцюзі: Unix %10$d\nПричина збою: %11$@\n\nOЦей статус підтверджується лише локально перевіреним доказом ланцюга."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên: %1$@\nTrạng thái: %2$@\nVai trò địa phương: %3$@\n Lệnh cấp vốn: %4$@, sau đó là %5$@\nSố tiền đầu tiên được xác nhận: %6$@\nĐã xác nhận khoản tài trợ thứ hai: %7$@\nThời hạn cấp vốn mới: Unix %8$d\nThời gian hoàn trả chuỗi đầu tiên: Unix %9$d\nThời gian hoàn tiền chuỗi thứ hai: Unix %10$d\nLý do thất bại: %11$@\n\nChỉ bằng chứng chuỗi được xác minh cục bộ mới nâng cao trạng thái này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会话：%1$@\n状态：%2$@\n本地角色：%3$@\n资金订单：%4$@，则%5$@\n首次资金确认： %6$@\n第二笔资金确认：%7$@\n新增资金截止时间：Unix %8$d\n首链退款时间：Unix %9$d\n第二链退款时间：Unix %10$d\n失败原因：%11$@\n\n只有本地验证的链证据才会推进此状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會話： %1$@\n狀態： %2$@\n本地角色： %3$@\n資金順序： %4$@ ，然後%5$@\n確認第一筆資金： %6$@\n第二筆資金已確認： %7$@\n新資金截止日期： Unix %8$d\n第一鏈退款時間： Unix %9$d\n第二鏈退款時間： Unix %10$d\n失敗原因： %11$@\n\n只有本地驗證的鏈證據才能提升此地位。"
          }
        }
      }
    },
