    "wallet_bitcoin_birthday_set": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كتلة عيد ميلاد استرداد Bitcoin %1$d في انتظار التحقق من الصحة. قم بمزامنة Bitcoin لمصادقة سابقتها وبدء عملية الاسترداد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin Wiederherstellungs-Geburtstagsblock %1$d wartet auf Validierung. Synchronisieren Sie Bitcoin, um seinen Vorgänger zu authentifizieren und mit der Wiederherstellung zu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin recovery birthday block %1$d is pending validation. Synchronize Bitcoin to authenticate its predecessor and begin recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloque de cumpleaños de recuperación Bitcoin %1$d está pendiente de validación. Sincronice Bitcoin para autenticar su predecesor y comenzar la recuperación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بلوک تولد بازیابی Bitcoin %1$d در انتظار تأیید اعتبار است. Bitcoin را برای احراز هویت نسخه قبلی و شروع بازیابی همگام کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le bloc d'anniversaire de récupération Bitcoin %1$d est en attente de validation. Synchronisez Bitcoin pour authentifier son prédécesseur et commencer la récupération."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלוק יום ההולדת לשחזור Bitcoin %1$d ממתין לאימות. סנכרן את Bitcoin כדי לאמת את קודמו ולהתחיל בשחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin पुनर्प्राप्ति जन्मदिन ब्लॉक %1$d का सत्यापन लंबित है। अपने पूर्ववर्ती को प्रमाणित करने और पुनर्प्राप्ति शुरू करने के लिए Bitcoin को सिंक्रनाइज़ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Blok ulang tahun pemulihan Bitcoin %1$d menunggu validasi. Sinkronkan Bitcoin untuk mengautentikasi pendahulunya dan memulai pemulihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il blocco compleanno di ripristino Bitcoin %1$d è in attesa di convalida. Sincronizza Bitcoin per autenticare il suo predecessore e iniziare il ripristino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin リカバリ誕生日ブロック %1$d は検証待ちです。 Bitcoin を同期して、前任者を認証し、回復を開始します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 복구 생일 블록 %1$d가 검증 보류 중입니다. Bitcoin를 동기화하여 이전 버전을 인증하고 복구를 시작합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin herstelverjaardagsblok %1$d wacht op validatie. Synchroniseer Bitcoin om zijn voorganger te authenticeren en met herstel te beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blok urodzinowy odzyskiwania Bitcoin %1$d oczekuje na zatwierdzenie. Zsynchronizuj Bitcoin, aby uwierzytelnić swojego poprzednika i rozpocząć odzyskiwanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloco de aniversário de recuperação Bitcoin %1$d está com validação pendente. Sincronize Bitcoin para autenticar seu antecessor e iniciar a recuperação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блок дня рождения восстановления Bitcoin %1$d ожидает проверки. Синхронизируйте Bitcoin, чтобы аутентифицировать его предшественника и начать восстановление."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin kurtarma doğum günü bloğu %1$d doğrulamayı bekliyor. Önceki sürümün kimliğini doğrulamak ve kurtarmaya başlamak için Bitcoin'yi senkronize edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin блок дня народження відновлення %1$d очікує перевірки. Синхронізуйте Bitcoin, щоб автентифікувати його попередника та почати відновлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khối sinh nhật khôi phục Bitcoin %1$d đang chờ xác thực. Đồng bộ hóa Bitcoin để xác thực thiết bị tiền nhiệm và bắt đầu khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 恢复生日区块 %1$d 正在等待验证。同步 Bitcoin 以验证其前身并开始恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 恢復生日區塊 %1$d 正在等待驗證。同步 Bitcoin 以驗證其前身並開始復原。"
          }
        }
      }
    },
    "wallet_bitcoin_birthday_setting": {
