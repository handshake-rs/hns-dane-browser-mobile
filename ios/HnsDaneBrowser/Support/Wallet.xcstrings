    "wallet_swap_take_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إرسال القبول الموقع. ربما تم قطع اتصال النظير أو ربما انتهت صلاحية العرض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die unterschriebene Annahmeerklärung wurde nicht verschickt. Der Peer hat möglicherweise die Verbindung getrennt oder das Angebot ist abgelaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signed acceptance was not sent. The peer may have disconnected or the offer may have expired."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aceptación firmada no fue enviada. Es posible que el par se haya desconectado o que la oferta haya caducado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پذیرش امضا شده ارسال نشد. ممکن است ارتباط همتا قطع شده باشد یا پیشنهاد منقضی شده باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acceptation signée n'a pas été envoyée. L'homologue s'est peut-être déconnecté ou l'offre a peut-être expiré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבלה החתומה לא נשלחה. ייתכן שהעמית התנתק או שההצעה פג."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हस्ताक्षरित स्वीकृति नहीं भेजी गई. हो सकता है कि सहकर्मी ने डिस्कनेक्ट कर दिया हो या ऑफ़र समाप्त हो गया हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerimaan yang ditandatangani tidak dikirim. Rekan tersebut mungkin telah terputus atau penawarannya mungkin telah kedaluwarsa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accettazione firmata non è stata inviata. Il peer potrebbe essersi disconnesso o l'offerta potrebbe essere scaduta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名された承諾書は送信されませんでした。ピアが切断されたか、オファーの有効期限が切れた可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명된 수락이 전송되지 않았습니다. 피어의 연결이 끊어졌거나 제안이 만료되었을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ondertekende aanvaarding is niet verzonden. Mogelijk is de verbinding met de peer verbroken of is de aanbieding verlopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpisana akceptacja nie została wysłana. Partner mógł się rozłączyć lub oferta mogła wygasnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aceitação assinada não foi enviada. O peer pode ter se desconectado ou a oferta pode ter expirado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписанный акцепт не был отправлен. Возможно, одноранговый узел отключился или срок действия предложения истек."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmzalı kabul gönderilmedi. Eşin bağlantısı kesilmiş olabilir veya teklifin süresi dolmuş olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підписане прийняття не було надіслано. Можливо, вузол від’єднався або термін дії пропозиції закінчився."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sự chấp nhận đã ký không được gửi. Thiết bị ngang hàng có thể đã bị ngắt kết nối hoặc ưu đãi có thể đã hết hạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签署的接受书未发送。对等方可能已断开连接或优惠可能已过期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽署的接受書未發送。對等方可能已斷線或優惠可能已過期。"
          }
        }
      }
    },
