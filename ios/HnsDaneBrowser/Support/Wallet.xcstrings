          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie die Wiederherstellungssicherung, bevor ein vertrauenswürdiges Namens-Backend installiert werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the recovery backup before a trusted name backend can be installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme la copia de seguridad de recuperación antes de que se pueda instalar un servidor de nombre confiable."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل از نصب پشتیبان نام قابل اعتماد، پشتیبان بازیابی را تأیید کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez la sauvegarde de récupération avant qu'un backend de nom de confiance puisse être installé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשר את גיבוי השחזור לפני שניתן יהיה להתקין קצה אחורי בשם מהימן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी विश्वसनीय नाम बैकएंड को स्थापित करने से पहले पुनर्प्राप्ति बैकअप की पुष्टि करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmasikan cadangan pemulihan sebelum backend nama tepercaya dapat diinstal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confermare il backup di ripristino prima di poter installare un backend con nome attendibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できる名前のバックエンドをインストールする前に、回復バックアップを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰할 수 있는 이름 백엔드를 설치하기 전에 복구 백업을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig de herstelback-up voordat een backend met een vertrouwde naam kan worden geïnstalleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdź kopię zapasową odzyskiwania, zanim będzie można zainstalować backend o zaufanej nazwie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme o backup de recuperação antes que um back-end de nome confiável possa ser instalado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите резервную копию для восстановления, прежде чем можно будет установить серверную часть с доверенным именем."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenilir bir ad arka ucu kurulmadan önce kurtarma yedeğini onaylayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердьте резервну копію для відновлення, перш ніж можна буде інсталювати довірений іменний сервер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận bản sao lưu khôi phục trước khi có thể cài đặt chương trình phụ trợ tên đáng tin cậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在安装可信名称后端之前确认恢复备份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在安裝可信任名稱後端之前確認恢復備份。"
          }
        }
      }
    },
