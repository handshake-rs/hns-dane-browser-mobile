    "row_wallet_read_sync_summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من آخر رصيد ونشاط وأسماء قبل الإرسال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie vor dem Senden den aktuellen Kontostand, die aktuelle Aktivität und die Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify the latest balance, activity, and names before sending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique el saldo, la actividad y los nombres más recientes antes de enviar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل از ارسال، آخرین موجودی، فعالیت و نام‌ها را بررسی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le dernier solde, l'activité et les noms avant l'envoi."
