    "wallet_reads_balance_syncing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الرصيد في انتظار انتهاء عملية التحقق المباشر من النظير وفحص المحفظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance wartet auf den Abschluss der aktiven Direct-Peer-Verifizierung und des Wallet-Scans."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance is waiting for the active direct-peer verification and wallet scan to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El saldo está esperando a que finalicen la verificación activa de pares directos y el escaneo de billetera."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موجودی منتظر است تا تأیید مستقیم فعال و اسکن کیف پول به پایان برسد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le solde attend la fin de la vérification active par les pairs directs et de l’analyse du portefeuille."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היתרה ממתינה לסיום האימות הישיר הפעיל וסריקת הארנק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैलेंस सक्रिय डायरेक्ट-पीयर सत्यापन और वॉलेट स्कैन समाप्त होने की प्रतीक्षा कर रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo menunggu verifikasi rekan langsung aktif dan pemindaian dompet selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il saldo è in attesa del completamento della verifica attiva del peer diretto e della scansione del portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高は、アクティブなダイレクトピア検証とウォレットスキャンが完了するのを待っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액은 활성 직접 피어 확인 및 지갑 스캔이 완료되기를 기다리고 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het saldo wacht tot de actieve directe peer-verificatie en portefeuillescan zijn voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo oczekuje na zakończenie aktywnej weryfikacji bezpośredniej i skanowania portfela."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O saldo está aguardando a conclusão da verificação ativa de pares diretos e da verificação da carteira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс ожидает завершения активной прямой одноранговой проверки и сканирования кошелька."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakiye, etkin doğrudan eş doğrulamanın ve cüzdan taramasının tamamlanmasını bekliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс очікує на завершення активної прямої перевірки та сканування гаманця."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số dư đang chờ quá trình xác minh ngang hàng trực tiếp và quét ví hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "余额正在等待主动直接对等验证和钱包扫描完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘額正在等待主動直接對等驗證和錢包掃描完成。"
          }
