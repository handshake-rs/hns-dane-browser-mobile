          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS がチェーン上で確認されました\n%2$@ HNS 送信保留中\nトランザクションは保留中です。お待​​ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS는 체인\n%2$@ HNS 보류 중인 발신\n거래 보류 중으로 확인되었습니다. 기다려 주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS bevestigd in keten\n%2$@ HNS in behandeling voor uitgaand\nTransactie in behandeling, even geduld alstublieft."
