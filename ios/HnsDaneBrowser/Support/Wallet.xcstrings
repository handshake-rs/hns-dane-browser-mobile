            "value": "Envio rejeitado. Nenhuma transação foi transmitida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправка отклонена. Ни одна транзакция не транслировалась."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderme reddedildi. Hiçbir işlem yayınlanmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надіслати відхилено. Жодна трансакція не транслювалася."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
