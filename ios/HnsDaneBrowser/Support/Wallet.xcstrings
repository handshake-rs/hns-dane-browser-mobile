      }
    },
    "wallet_send_syncing_before_review": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحقق من حالة محفظة النظير المباشر الحالية قبل مراجعة هذا الإرسال..."
          }
        },
        "de": {
          "stringUnit": {
