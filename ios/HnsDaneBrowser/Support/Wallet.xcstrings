          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci una commissione massima di almeno 1.000 satoshi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少なくとも 1,000 サトシの最大料金を入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 수수료를 최소 1,000사토시로 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een maximumbedrag in van minimaal 1.000 satoshi's."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź maksymalną opłatę w wysokości co najmniej 1000 satoshi."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira uma taxa máxima de pelo menos 1.000 satoshis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите максимальную комиссию в размере не менее 1000 сатоши."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az 1.000 satoshi tutarında maksimum ücret girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть максимальну комісію не менше 1000 сатоші."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập mức phí tối đa ít nhất là 1.000 satoshi."
          }
        },
        "zh-Hans": {
