    "wallet_direct_shakescape_disconnected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم قطع اتصال نظير المبادلة النشط. يظل المستمع المملوك للمحفظة متاحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktive Swap-Peer wurde getrennt. Der Wallet-eigene Listener bleibt verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The active swap peer was disconnected. The wallet-owned listener remains available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El par de intercambio activo estaba desconectado. El oyente propiedad de la billetera permanece disponible."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همتا مبادله فعال قطع شد. شنونده متعلق به کیف پول در دسترس است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le homologue de swap actif a été déconnecté. L'auditeur appartenant au portefeuille reste disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עמית ההחלפה הפעיל נותק. המאזין שבבעלות הארנק נשאר זמין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय स्वैप पियर डिस्कनेक्ट हो गया था। वॉलेट के स्वामित्व वाला श्रोता उपलब्ध रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekan swap aktif terputus. Pendengar milik dompet tetap tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peer di scambio attivo è stato disconnesso. L'ascoltatore di proprietà del portafoglio rimane disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなスワップピアが切断されました。ウォレットが所有するリスナーは引き続き使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 스왑 피어의 연결이 끊어졌습니다. 지갑 소유 리스너는 계속 사용 가능합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De actieve swap-peer is ontkoppeld. De luisteraar die eigendom is van de portemonnee blijft beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywny uczestnik wymiany został odłączony. Odbiornik należący do portfela pozostaje dostępny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O ponto de troca ativo foi desconectado. O ouvinte da carteira permanece disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активный узел подкачки был отключен. Прослушиватель, принадлежащий кошельку, остается доступным."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin takas eşinin bağlantısı kesildi. Cüzdanın sahip olduğu dinleyici kullanılabilir durumda kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активний вузол підкачки було відключено. Прослуховувач гаманця залишається доступним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trao đổi ngang hàng đang hoạt động đã bị ngắt kết nối. Trình nghe thuộc sở hữu của ví vẫn có sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "活动交换对等点已断开连接。钱包拥有的监听器仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "活動交換對等點已斷開連線。錢包擁有的監聽器仍然可用。"
          }
        }
      }
