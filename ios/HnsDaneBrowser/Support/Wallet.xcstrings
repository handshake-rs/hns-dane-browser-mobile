        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta oferta requiere un candado sat %1$d que incluye una reserva de tarifa %2$d sat Bitcoin (%3$d sats en total), pero esta billetera tiene %4$d confirmado sats."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پیشنهاد به %1$d قفل مستلزم شامل %2$d ذخیره کارمزد بیت کوین (%3$d در مجموع) نیاز دارد، اما این کیف دارای %4$d نشست تأیید شده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette offre nécessite un verrou sat %1$d comprenant une réserve de frais sat %2$d Bitcoin (total %3$d sats), mais ce portefeuille a %4$d confirmé sats."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצעה זו מחייבת מנעול לשבת %1$d כולל רזרבת עמלה %2$d sat Bitcoin (סה\"כ %3$d sats), אך לארנק הזה יש %4$d מאושרת sats."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ऑफ़र के लिए %2$d sat Bitcoin शुल्क आरक्षित (%3$d sats कुल) सहित %1$d sat लॉक की आवश्यकता है, लेकिन इस वॉलेट में %4$d की पुष्टि sats है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penawaran ini memerlukan kunci sat %1$d termasuk cadangan biaya %2$d sat Bitcoin (total %3$d sats), tetapi dompet ini memiliki %4$d yang dikonfirmasi sats."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa offerta richiede un blocco satellitare %1$d che includa una riserva tariffaria %2$d sat Bitcoin (%3$d sats totale), ma questo portafoglio ha %4$d confermato sats."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオファーには、%2$d sat Bitcoin 手数料準備金 (%3$d sats 合計) を含む %1$d sat ロックが必要ですが、このウォレットには %4$d 確認済み sats があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제안에는 %2$d sat Bitcoin 수수료 예비금(%3$d sats 총계)을 포함한 %1$d sat 잠금 장치가 필요하지만 이 지갑에는 %4$d에서 sats가 확인되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze aanbieding is een %1$d satellietslot inclusief een %2$d sat Bitcoin kostenreserve vereist (%3$d sats totaal), maar deze portemonnee heeft een %4$d bevestigde sats."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta oferta wymaga blokady sat %1$d, w tym rezerwy opłat %2$d sat Bitcoin (łącznie %3$d sats), ale ten portfel ma potwierdzone %4$d sats."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta oferta requer um bloqueio de satélite %1$d incluindo uma reserva de taxa de satélite %2$d Bitcoin (total %3$d sats), mas esta carteira tem %4$d sats confirmado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этого предложения требуется спутниковый замок %1$d, включая резерв комиссии %2$d sat Bitcoin (всего %3$d sats), но в этом кошельке есть подтвержденный %4$d sats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu teklif, %2$d uydu Bitcoin ücret rezervi (toplam %3$d sats toplam) içeren bir %1$d uydu kilidi gerektirir, ancak bu cüzdanda %4$d onaylı sats vardır."
