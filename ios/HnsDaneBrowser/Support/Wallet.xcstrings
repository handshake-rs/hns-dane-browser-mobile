    "wallet_swap_take_approval_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العرض: %1$@\n\nالقفل: %2$@\nالحد الأقصى للرسوم: %3$@\nالإجمالي: %4$@\n\nيبدأ القبول التفاوض. تتم الموافقة على التمويل بشكل منفصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Angebot: %1$@\n\nSperrbetrag: %2$@\nMaximale Gebühr: %3$@\nGesamt: %4$@\n\nDie Annahme startet die Verhandlung. Die Finanzierung wird separat bestätigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offer: %1$@\n\nLock: %2$@\nMaximum fee: %3$@\nTotal: %4$@\n\nAccepting starts negotiation. Funding is approved separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferta: %1$@\n\nBloqueo: %2$@\nComisión máxima: %3$@\nTotal: %4$@\n\nAceptar inicia la negociación. La financiación se aprueba por separado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیشنهاد: %1$@\n\nقفل: %2$@\nحداکثر کارمزد: %3$@\nمجموع: %4$@\n\nپذیرش، مذاکره را آغاز می‌کند. تأمین وجه جداگانه تأیید می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Offre : %1$@\n\nVerrouillage : %2$@\nFrais maximum : %3$@\nTotal : %4$@\n\nL’acceptation lance la négociation. Le financement est approuvé séparément."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצעה: %1$@\n\nנעילה: %2$@\nעמלה מרבית: %3$@\nסה״כ: %4$@\n\nהקבלה מתחילה משא ומתן. המימון מאושר בנפרד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़र: %1$@\n\nलॉक: %2$@\nअधिकतम शुल्क: %3$@\nकुल: %4$@\n\nस्वीकार करने पर बातचीत शुरू होती है। फंडिंग की मंज़ूरी अलग से दी जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penawaran: %1$@\n\nKunci: %2$@\nBiaya maksimum: %3$@\nTotal: %4$@\n\nPenerimaan memulai negosiasi. Pendanaan disetujui secara terpisah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Offerta: %1$@\n\nBlocco: %2$@\nCommissione massima: %3$@\nTotale: %4$@\n\nL’accettazione avvia la negoziazione. Il finanziamento viene approvato separatamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オファー：%1$@\n\nロック：%2$@\n最大手数料：%3$@\n合計：%4$@\n\n承認すると交渉が始まります。資金供給は別途承認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안: %1$@\n\n잠금: %2$@\n최대 수수료: %3$@\n합계: %4$@\n\n수락하면 협상이 시작됩니다. 자금 공급은 별도로 승인합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aanbieding: %1$@\n\nVergrendeling: %2$@\nMaximale kosten: %3$@\nTotaal: %4$@\n\nAcceptatie start de onderhandeling. Financiering wordt apart goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferta: %1$@\n\nBlokada: %2$@\nMaksymalna opłata: %3$@\nRazem: %4$@\n\nPrzyjęcie rozpoczyna negocjacje. Finansowanie zatwierdza się osobno."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferta: %1$@\n\nBloqueio: %2$@\nTaxa máxima: %3$@\nTotal: %4$@\n\nA aceitação inicia a negociação. O financiamento é aprovado separadamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложение: %1$@\n\nБлокировка: %2$@\nМаксимальная комиссия: %3$@\nИтого: %4$@\n\nПринятие запускает переговоры. Финансирование подтверждается отдельно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teklif: %1$@\n\nKilit: %2$@\nAzami ücret: %3$@\nToplam: %4$@\n\nKabul, görüşmeyi başlatır. Fonlama ayrıca onaylanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пропозиція: %1$@\n\nБлокування: %2$@\nМаксимальна комісія: %3$@\nРазом: %4$@\n\nПрийняття починає переговори. Фінансування підтверджується окремо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào giá: %1$@\n\nKhóa: %2$@\nPhí tối đa: %3$@\nTổng: %4$@\n\nChấp nhận sẽ bắt đầu thương lượng. Việc cấp vốn được phê duyệt riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报价：%1$@\n\n锁定：%2$@\n最高费用：%3$@\n总计：%4$@\n\n接受后开始协商。资金操作需另行批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "報價：%1$@\n\n鎖定：%2$@\n最高費用：%3$@\n總計：%4$@\n\n接受後開始協商。資金操作需另行核准。"
          }
        }
      }
    },
