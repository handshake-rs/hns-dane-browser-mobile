    "wallet_delete_typed_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشبكة: %1$@ (%2$@) \n معرف الحساب: %3$@\n\n يؤدي هذا الإجراء الذي لا رجعة فيه إلى حذف محفظة الشبكة/الحساب هذه فقط. اكتب DELETE بالضبط للمتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Netzwerk: %1$@ (%2$@)\nKonto-ID: %3$@\n\nDiese unumkehrbare Aktion löscht nur genau dieses Netzwerk/Konto-Wallet. Geben Sie DELETE genau ein, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Network: %1$@ (%2$@)\nAccount ID: %3$@\n\nThis irreversible action deletes only this exact network/account wallet. Type DELETE exactly to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Red: %1$@ (%2$@)\nID de cuenta: %3$@\n\nEsta acción irreversible elimina solo esta billetera de red/cuenta exacta. Escriba DELETE exactamente para continuar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شبکه: %1$@ (%2$@)\nشناسه حساب: %3$@\n\nاین اقدام غیرقابل برگشت فقط همین کیف پول شبکه/حساب را حذف می‌کند. برای ادامه، دقیقاً DELETE را تایپ کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réseau : %1$@ (%2$@)\nID de compte : %3$@\n\nCette action irréversible supprime uniquement ce portefeuille de réseau/compte exact. Tapez DELETE exactement pour continuer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשת: %1$@ (%2$@)\nA מזהה חשבון: %3$@\n\n פעולה בלתי הפיכה זו מוחקת רק את ארנק הרשת/חשבון המדויק הזה. Type DELETE exactly to continue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटवर्क: %1$@ (%2$@)\nखाता आईडी: %3$@\n\nयह अपरिवर्तनीय कार्रवाई केवल इस सटीक नेटवर्क/खाता वॉलेट को हटाती है। जारी रखने के लिए बिल्कुल DELETE टाइप करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaringan: %1$@ (%2$@)\nAID Akun: %3$@\n\nTindakan yang tidak dapat diubah ini hanya menghapus dompet jaringan/akun ini saja. Ketik DELETE persis untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rete: %1$@ (%2$@)\nAID account: %3$@\n\nQuesta azione irreversibile elimina solo questo esatto portafoglio di rete/account. Digita DELETE esattamente per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク: %1$@ ( %2$@ )\nアカウント ID: %3$@\n\nこの不可逆的なアクションでは、この正確なネットワーク/アカウント ウォレットのみが削除されます。続行するには、DELETE を正確に入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크: %1$@ (%2$@)\n계정 ID: %3$@\n\n이 취소할 수 없는 작업은 바로 이 네트워크/계정 지갑만 삭제합니다. 계속하려면 DELETE를 정확하게 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Netwerk: %1$@ (%2$@)\nAccount-ID: %3$@\n\nDeze onomkeerbare actie verwijdert alleen deze exacte netwerk-/accountportemonnee. Typ DELETE precies om door te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieć: %1$@ (%2$@)\nAID konta: %3$@\n\nTa nieodwracalna akcja powoduje usunięcie tylko tej konkretnej sieci/portfela konta. Aby kontynuować, wpisz dokładnie DELETE."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Rede: %1$@ (%2$@)\nID da conta: %3$@\n\nEsta ação irreversível exclui apenas esta rede/carteira de conta exata. Digite DELETE exatamente para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеть: %1$@ (%2$@)\nИдентификатор учетной записи: %3$@\n\nЭто необратимое действие удаляет только эту конкретную сеть/кошелек учетной записи. Введите DELETE, чтобы продолжить."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağ: %1$@ (%2$@)\nHesap Kimliği: %3$@\n\nBu geri alınamaz işlem yalnızca bu tam ağ/hesap cüzdanını siler. Devam etmek için tam olarak DELETE yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мережа: %1$@ (%2$@)\nAІдентифікатор облікового запису: %3$@\n\nЦя незворотна дія видаляє лише цей гаманець мережі/облікового запису. Щоб продовжити, введіть DELETE."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mạng: %1$@ (%2$@)\nAID tài khoản: %3$@\n\n. Hành động không thể thay đổi này chỉ xóa mạng/ví tài khoản chính xác này. Nhập chính xác DELETE để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络：%1$@ (%2$@)\n账户 ID：%3$@\n\n此不可逆操作仅删除此确切的网络/账户钱包。准确输入 DELETE 以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "網路：%1$@ (%2$@)\n帳號 ID：%3$@\n\n此不可逆操作僅刪除此確切的網路/帳號錢包。準確輸入 DELETE 以繼續。"
          }
        }
      }
    },
