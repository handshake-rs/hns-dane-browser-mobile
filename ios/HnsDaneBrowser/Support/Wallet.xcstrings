    "wallet_swap_funding_approval_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقفل %1$d سات. رسوم الشبكة: %2$d سات (الحد الأقصى %3$d).\n\nالمعاملة: %4$@\nالجلسة: %5$@\n\nالبث غير قابل للتراجع. تتقدم المبادلة بعد تأكيد قفل Bitcoin."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d Sats sperren. Netzwerkgebühr: %2$d Sats (maximal %3$d).\n\nTransaktion: %4$@\nSitzung: %5$@\n\nDas Senden ist unumkehrbar. Der Tausch wird nach Bestätigung der Bitcoin-Sperre fortgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock %1$d sats. Network fee: %2$d sats (maximum %3$d).\n\nTransaction: %4$@\nSession: %5$@\n\nBroadcast is irreversible. The swap advances after the Bitcoin lock is confirmed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear %1$d sats. Comisión de red: %2$d sats (máximo %3$d).\n\nTransacción: %4$@\nSesión: %5$@\n\nLa transmisión es irreversible. El intercambio avanza después de confirmar el bloqueo de Bitcoin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d سات قفل شود. کارمزد شبکه: %2$d سات (حداکثر %3$d).\n\nتراکنش: %4$@\nجلسه: %5$@\n\nپخش برگشت‌ناپذیر است. مبادله پس از تأیید قفل Bitcoin ادامه می‌یابد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouiller %1$d sats. Frais réseau : %2$d sats (maximum %3$d).\n\nTransaction : %4$@\nSession : %5$@\n\nLa diffusion est irréversible. L’échange avance après confirmation du verrouillage Bitcoin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נעילת %1$d סאט. עמלת רשת: %2$d סאט (מקסימום %3$d).\n\nעסקה: %4$@\nהפעלה: %5$@\n\nהשידור בלתי הפיך. ההחלפה מתקדמת לאחר אישור נעילת Bitcoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d सैट लॉक करें। नेटवर्क शुल्क: %2$d सैट (अधिकतम %3$d)।\n\nलेन-देन: %4$@\nसत्र: %5$@\n\nप्रसारण अपरिवर्तनीय है। Bitcoin लॉक पुष्ट होने के बाद स्वैप आगे बढ़ता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci %1$d sat. Biaya jaringan: %2$d sat (maksimum %3$d).\n\nTransaksi: %4$@\nSesi: %5$@\n\nPenyiaran tidak dapat dibatalkan. Pertukaran berlanjut setelah kunci Bitcoin dikonfirmasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca %1$d sat. Commissione di rete: %2$d sat (massimo %3$d).\n\nTransazione: %4$@\nSessione: %5$@\n\nLa trasmissione è irreversibile. Lo scambio avanza dopo la conferma del blocco Bitcoin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d satsをロックします。ネットワーク手数料：%2$d sats（最大%3$d）。\n\nトランザクション：%4$@\nセッション：%5$@\n\nブロードキャストは取り消せません。Bitcoinロックの確定後にスワップが進みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d sats를 잠급니다. 네트워크 수수료: %2$d sats(최대 %3$d).\n\n트랜잭션: %4$@\n세션: %5$@\n\n브로드캐스트는 되돌릴 수 없습니다. Bitcoin 잠금 확인 후 스왑이 진행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d sats vergrendelen. Netwerkkosten: %2$d sats (maximaal %3$d).\n\nTransactie: %4$@\nSessie: %5$@\n\nUitzenden is onomkeerbaar. De ruil gaat verder nadat de Bitcoin-vergrendeling is bevestigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokuj %1$d sats. Opłata sieciowa: %2$d sats (maksymalnie %3$d).\n\nTransakcja: %4$@\nSesja: %5$@\n\nRozgłoszenie jest nieodwracalne. Wymiana postępuje po potwierdzeniu blokady Bitcoin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueie %1$d sats. Taxa de rede: %2$d sats (máximo %3$d).\n\nTransação: %4$@\nSessão: %5$@\n\nA transmissão é irreversível. A troca avança após a confirmação do bloqueio Bitcoin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокировать %1$d sats. Комиссия сети: %2$d sats (максимум %3$d).\n\nТранзакция: %4$@\nСессия: %5$@\n\nОтправка необратима. Обмен продолжится после подтверждения блокировки Bitcoin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d sats kilitleyin. Ağ ücreti: %2$d sats (azami %3$d).\n\nİşlem: %4$@\nOturum: %5$@\n\nYayın geri alınamaz. Takas, Bitcoin kilidi onaylandıktan sonra ilerler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокувати %1$d sats. Комісія мережі: %2$d sats (максимум %3$d).\n\nТранзакція: %4$@\nСесія: %5$@\n\nНадсилання незворотне. Обмін продовжиться після підтвердження блокування Bitcoin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa %1$d sats. Phí mạng: %2$d sats (tối đa %3$d).\n\nGiao dịch: %4$@\nPhiên: %5$@\n\nViệc phát là không thể đảo ngược. Hoán đổi tiếp tục sau khi khóa Bitcoin được xác nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定 %1$d 聪。网络费用：%2$d 聪（最高 %3$d）。\n\n交易：%4$@\n会话：%5$@\n\n广播不可撤销。确认 Bitcoin 锁定后，兑换才会继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定 %1$d 聰。網路費用：%2$d 聰（最高 %3$d）。\n\n交易：%4$@\n工作階段：%5$@\n\n廣播無法撤銷。確認 Bitcoin 鎖定後，兌換才會繼續。"
          }
        }
      }
    },
