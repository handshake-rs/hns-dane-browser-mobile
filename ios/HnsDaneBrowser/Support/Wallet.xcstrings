    "wallet_name_card_no_names": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تعقب أي أسماء حتى الآن. افتح إجراءات الاسم لاستيراد اسم واحد أو قائمة مفصولة بمسافات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden noch keine Namen erfasst. Öffnen Sie Namensaktionen, um einen Namen oder eine durch Leerzeichen getrennte Liste zu importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No names are tracked yet. Open Name actions to import one name or a space-separated list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se ha rastreado ningún nombre. Abra acciones de Nombre para importar un nombre o una lista separada por espacios."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز هیچ نامی پیگیری نشده است. برای وارد کردن یک نام یا یک لیست جدا شده از فاصله، اقدامات نام را باز کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun nom n'est encore suivi. Ouvrir les actions Nom pour importer un nom ou une liste séparée par des espaces."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין מעקב אחר שמות. פתח את פעולות השם כדי לייבא שם אחד או רשימה מופרדת ברווחים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई नाम ट्रैक नहीं किया गया है. एक नाम या रिक्त स्थान से अलग की गई सूची आयात करने के लिए नाम क्रियाएँ खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada nama yang dilacak. Buka tindakan Nama untuk mengimpor satu nama atau daftar yang dipisahkan spasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun nome è ancora tracciato. Apri azioni Nome per importare un nome o un elenco separato da spazi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ名前は追跡されていません。 [名前] アクションを開いて、1 つの名前またはスペース区切りのリストをインポートします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 추적된 이름이 없습니다. 이름 작업을 열어 하나의 이름이나 공백으로 구분된 목록을 가져옵니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er worden nog geen namen bijgehouden. Open Naamacties om één naam of een door spaties gescheiden lijst te importeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadne nazwiska nie są jeszcze śledzone. Otwórz akcje nazw, aby zaimportować jedną nazwę lub listę oddzieloną spacjami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum nome foi rastreado ainda. Abra ações de Nome para importar um nome ou uma lista separada por espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена пока не отслеживаются. Действия «Открыть имя» для импорта одного имени или списка, разделенного пробелами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz takip edilen bir isim yok. Bir adı veya boşlukla ayrılmış bir listeyi içe aktarmak için Ad eylemlerini açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імена ще не відстежуються. Відкрийте дії з іменами, щоб імпортувати одне ім’я або список, розділений пробілами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có tên nào được theo dõi. Mở tác vụ Tên để nhập một tên hoặc danh sách được phân tách bằng dấu cách."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未追踪到姓名。打开“名称”操作以导入一个名称或一个以空格分隔的列表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未追蹤到姓名。開啟「名稱」操作以匯入一個名稱或一個以空格分隔的清單。"
          }
        }
      }
    },
