    "wallet_action_busy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال المحفظة تكمل المزامنة أو عملية أخرى. قد يستمر في الخلفية. انتظر حتى ينتهي، ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wallet führt immer noch die Synchronisierung oder einen anderen Vorgang durch. Es kann im Hintergrund weitergehen. Warten Sie, bis der Vorgang abgeschlossen ist, und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wallet is still completing synchronization or another operation. It may continue in the background. Wait for it to finish, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La billetera aún está completando la sincronización u otra operación. Puede que continúe en segundo plano. Espere a que termine y vuelva a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پول هنوز در حال تکمیل همگام سازی یا عملیات دیگری است. ممکن است در پس زمینه ادامه یابد. صبر کنید تا تمام شود، سپس دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portefeuille est toujours en train de terminer la synchronisation ou une autre opération. Cela peut continuer en arrière-plan. Attendez qu'il se termine, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הארנק עדיין משלים סנכרון או פעולה אחרת. זה עשוי להמשיך ברקע. המתן עד שזה יסתיים ואז נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट अभी भी सिंक्रोनाइज़ेशन या कोई अन्य ऑपरेशन पूरा कर रहा है। यह पृष्ठभूमि में जारी रह सकता है. इसके ख़त्म होने तक प्रतीक्षा करें, फिर पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet masih menyelesaikan sinkronisasi atau operasi lainnya. Ini mungkin berlanjut di latar belakang. Tunggu hingga selesai, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il portafoglio sta ancora completando la sincronizzazione o un'altra operazione. Potrebbe continuare in background. Attendi che finisca, quindi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットはまだ同期または別の操作を完了中です。バックグラウンドで継続する可能性があります。完了するまで待ってから、もう一度試してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑이 아직 동기화나 다른 작업을 완료하는 중입니다. 백그라운드에서 계속될 수도 있습니다. 완료될 때까지 기다린 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De portemonnee is nog bezig met het voltooien van de synchronisatie of een andere bewerking. Het kan op de achtergrond doorgaan. Wacht tot het klaar is en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfel nadal kończy synchronizację lub inną operację. Może działać w tle. Poczekaj, aż się zakończy, a następnie spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira ainda está concluindo a sincronização ou outra operação. Pode continuar em segundo plano. Espere terminar e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелек все еще завершает синхронизацию или другую операцию. Это может продолжаться в фоновом режиме. Подождите, пока он закончится, затем повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "M-cüzdan hâlâ senkronizasyonu veya başka bir işlemi tamamlıyor. Arka planda devam edebilir. Bitmesini bekleyin, ardından tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманець все ще завершує синхронізацію або іншу операцію. Це може тривати у фоновому режимі. Зачекайте, поки це закінчиться, а потім повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví vẫn đang hoàn tất đồng bộ hóa hoặc một hoạt động khác. Nó có thể tiếp tục ở chế độ nền. Đợi nó chạy xong rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱包仍在完成同步或其他操作。它可能会在后台继续。等待它完成，然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錢包仍在完成同步或其他操作。它可能會在後台繼續。等待它完成，然後再試一次。"
          }
        }
      }
    },
