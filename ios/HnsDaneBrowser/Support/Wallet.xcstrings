            "state": "translated",
            "value": "Ingrese una dirección de pago HNS exacta y visible sin espacios ni saltos de línea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آدرس پرداخت دقیق HNS قابل مشاهده را بدون فاصله یا وقفه خط وارد کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une adresse de paiement HNS exacte et visible, sans espaces ni sauts de ligne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן כתובת תשלום גלויה במדויק HNS ללא רווחים או מעברי שורות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिक्त स्थान या लाइन ब्रेक के बिना सटीक दृश्यमान HNS भुगतान पता दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan alamat pembayaran HNS yang terlihat jelas tanpa spasi atau jeda baris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un indirizzo di pagamento HNS visibile esatto senza spazi o interruzioni di riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スペースや改行を入れずに、表示される正確な HNS 支払い住所を入力します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공백이나 줄 바꿈 없이 눈에 보이는 정확한 HNS 지불 주소를 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een exact zichtbaar HNS-betalingsadres in, zonder spaties of regeleinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź dokładny widoczny adres płatności HNS bez spacji i łamania wierszy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um endereço de pagamento HNS exato e visível, sem espaços ou quebras de linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите точный видимый платежный адрес HNS без пробелов и разрывов строк."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluk veya satır sonu olmadan tam olarak görünen HNS ödeme adresini girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть точну видиму платіжну адресу HNS без пробілів і розривів рядків."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập địa chỉ thanh toán HNS hiển thị chính xác, không có dấu cách hoặc ngắt dòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入准确可见的 HNS 付款地址，不得有空格或换行符。"
