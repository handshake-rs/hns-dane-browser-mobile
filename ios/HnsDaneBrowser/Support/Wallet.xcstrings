    "wallet_reads_live_retrying": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أقرانهم المباشرون لم يوافقوا بعد. استبدال النظراء وإعادة محاولة %1$d لـ %2$d من الارتفاع المحلي الذي تم التحقق منه %3$d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkte Kollegen waren sich noch nicht einig. Peers ersetzen und %1$d von %2$d von der verifizierten lokalen Höhe %3$d aus erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct peers did not agree yet. Replacing peers and retrying %1$d of %2$d from verified local height %3$d."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los compañeros directos aún no se pusieron de acuerdo. Reemplazo de pares y reintento de %1$d de %2$d desde la altura local verificada %3$d."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همتایان مستقیم هنوز موافقت نکردند. جایگزینی همتایان و امتحان مجدد %1$d از %2$d از ارتفاع محلی تأیید شده %3$d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pairs directs ne sont pas encore d’accord. Remplacement des pairs et nouvelle tentative de %1$d de %2$d à partir de la hauteur locale vérifiée %3$d."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עמיתים ישירים עדיין לא הסכימו. החלפת עמיתים וניסיון חוזר של %1$d של %2$d מגובה מקומי מאומת %3$d."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्यक्ष सहकर्मी अभी तक सहमत नहीं थे। समकक्षों को प्रतिस्थापित करना और सत्यापित स्थानीय ऊंचाई %3$d से %2$d के %1$d को पुनः प्रयास करना।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekan langsung belum setuju. Mengganti rekan dan mencoba kembali %1$d dari %2$d dari ketinggian lokal terverifikasi %3$d."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I colleghi diretti non erano ancora d'accordo. Sostituzione dei peer e nuovo tentativo %1$d di %2$d dall'altezza locale verificata %3$d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直接の同僚はまだ同意していません。ピアを交換し、検証されたローカル高さ %3$d から %1$d または %2$d を再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접적인 동료들은 아직 동의하지 않았습니다. 피어를 교체하고 확인된 로컬 높이 %3$d에서 %2$d의 %1$d를 다시 시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Directe collega's waren het er nog niet over eens. Vervangende peers en probeer %1$d van %2$d opnieuw vanaf geverifieerde lokale hoogte %3$d."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpośredni współpracownicy jeszcze się nie zgodzili. Wymiana elementów równorzędnych i ponowienie próby %1$d %2$d ze zweryfikowanej wysokości lokalnej %3$d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pares diretos ainda não concordaram. Substituindo pares e tentando novamente %1$d de %2$d da altura local verificada %3$d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямые коллеги пока не согласились. Замена одноранговых узлов и повторная попытка %1$d из %2$d с проверенной локальной высоты %3$d."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğrudan akranları henüz aynı fikirde değildi. Eşler değiştiriliyor ve doğrulanmış yerel yükseklik %3$d'den %2$d'nin %1$d'si yeniden deneniyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прямі однолітки ще не дійшли згоди. Заміна вузлів і повторна спроба %1$d з %2$d з перевіреної локальної висоти %3$d."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các đồng nghiệp trực tiếp vẫn chưa đồng ý. Thay thế các thiết bị ngang hàng và thử lại %1$d của %2$d từ độ cao cục bộ đã được xác minh %3$d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接同行尚未同意。替换同级并从验证的本地高度 %3$d 重试 %2$d 的 %1$d。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接同行尚未同意。取代同級並從驗證的本地高度 %3$d 重試 %2$d 的 %1$d。"
          }
        }
      }
    },
