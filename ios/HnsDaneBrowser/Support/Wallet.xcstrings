    "row_wallet_bitcoin_sync_summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بالتحديث مباشرة من أقران Bitcoin بدون عقدة أو مفهرس RPC."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualisieren Sie direkt von Bitcoin-Peers ohne einen RPC-Knoten oder Indexer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update directly from Bitcoin peers without an RPC node or indexer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualice directamente desde pares Bitcoin sin un nodo o indexador RPC."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌روزرسانی مستقیم از همتایان Bitcoin بدون گره یا نمایه‌ساز RPC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez à jour directement à partir des homologues Bitcoin sans nœud ni indexeur RPC."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכן ישירות מעמיתים של Bitcoin ללא צומת RPC או אינדקס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "RPC नोड या इंडेक्सर के बिना सीधे Bitcoin साथियों से अपडेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbarui langsung dari rekan Bitcoin tanpa node atau pengindeks RPC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna direttamente dai peer Bitcoin senza un nodo o indicizzatore RPC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RPC ノードやインデクサーを使用せずに、Bitcoin ピアから直接更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "RPC 노드나 인덱서 없이 Bitcoin 피어에서 직접 업데이트합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Update rechtstreeks vanaf Bitcoin-peers zonder een RPC-knooppunt of indexer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizuj bezpośrednio z urządzeń równorzędnych Bitcoin bez węzła RPC lub indeksatora."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualize diretamente dos pares Bitcoin sem um nó ou indexador RPC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление напрямую с узлов Bitcoin без узла или индексатора RPC."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "RPC düğümü veya dizinleyici olmadan doğrudan Bitcoin eşlerinden güncelleme yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлення безпосередньо з вузлів Bitcoin без вузла RPC або індексатора."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật trực tiếp từ các đồng nghiệp Bitcoin mà không cần nút hoặc bộ chỉ mục RPC."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接从 Bitcoin 对等点更新，无需 RPC 节点或索引器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "直接從 Bitcoin 對等點更新，無需 RPC 節點或索引器。"
          }
        }
      }
    },
