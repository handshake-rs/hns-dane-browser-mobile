    "wallet_name_multiple_import_review_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم مصادقة أسماء %1$d وإضافتها ذريًا. قم بمراجعة القائمة الكاملة قبل الاستيراد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d-Namen werden authentifiziert und atomar hinzugefügt. Überprüfen Sie vor dem Import die vollständige Liste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d names will be authenticated and added atomically. Review the complete list before importing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres %1$d se autenticarán y agregarán atómicamente. Revise la lista completa antes de importar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام های %1$d احراز هویت می شوند و به صورت اتمی اضافه می شوند. قبل از وارد کردن، فهرست کامل را مرور کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms %1$d seront authentifiés et ajoutés de manière atomique. Consultez la liste complète avant d’importer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמות %1$d יאומתו ויתווספו בצורה אטומית. Review the complete list before importing."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d नामों को प्रमाणित किया जाएगा और परमाणु रूप से जोड़ा जाएगा। आयात करने से पहले पूरी सूची की समीक्षा करें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama %1$d akan diautentikasi dan ditambahkan secara atom. Tinjau daftar lengkap sebelum mengimpor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi %1$d verranno autenticati e aggiunti atomicamente. Esaminare l'elenco completo prima dell'importazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d 名は認証され、アトミックに追加されます。インポートする前に完全なリストを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d 이름은 인증되고 원자적으로 추가됩니다. 가져오기 전에 전체 목록을 검토하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d-namen worden geverifieerd en atomair toegevoegd. Bekijk de volledige lijst voordat u importeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwy %1$d zostaną uwierzytelnione i dodane atomowo. Przed zaimportowaniem przejrzyj całą listę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os nomes %1$d serão autenticados e adicionados atomicamente. Revise a lista completa antes de importar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена %1$d будут аутентифицированы и добавлены атомарно. Просмотрите полный список перед импортом."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d adlarının kimliği doğrulanacak ve atomik olarak eklenecektir. İçe aktarmadan önce tam listeyi inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імена %1$d буде автентифіковано та додано атомарно. Перегляньте повний список перед імпортом."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên %1$d sẽ được xác thực và thêm vào một cách nguyên tử. Xem lại danh sách đầy đủ trước khi nhập."
