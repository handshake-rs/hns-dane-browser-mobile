            "state": "translated",
            "value": "Soumis à ses pairs ; pas encore observé dans la vue de la chaîne locale"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוגש לעמיתים; עדיין לא נצפה בתצוגת השרשרת המקומית"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साथियों को प्रस्तुत; स्थानीय श्रृंखला दृश्य में अभी तक नहीं देखा गया है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diserahkan ke rekan-rekan; belum diamati dalam tampilan rantai lokal"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Presentato ai pari; non ancora osservato nella visione a catena locale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピアに提出。ローカルチェーンビューではまだ観察されていません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동료에게 제출됨 로컬 체인 뷰에서는 아직 관찰되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorgelegd aan collega's; nog niet waargenomen in het lokale ketenbeeld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesłane do rówieśników; jeszcze nie zaobserwowane w widoku łańcucha lokalnego"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado aos pares; ainda não observado na visão da cadeia local"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Представлен сверстникам; еще не наблюдается в просмотре локальной цепочки"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akranlara gönderildi; henüz yerel zincir görünümünde gözlemlenmedi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Представлений одноліткам; ще не спостерігається в локальному ланцюжку"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã gửi cho đồng nghiệp; chưa được quan sát trong chế độ xem chuỗi địa phương"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提交给同行；尚未在本地链视图中观察到"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提交給同行；尚未在本地鏈視圖中觀察到"
          }
        }
      }
    },
