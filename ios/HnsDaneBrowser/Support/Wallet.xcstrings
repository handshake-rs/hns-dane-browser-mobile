    "wallet_direct_shakescape_host_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاتصالات الواردة غير متاحة على المنفذ %1$d. لا يزال بإمكانك الاتصال بمنشئ العرض.\n%2$@\n\nمتقدم: %3$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eingehende Verbindungen sind am Port %1$d nicht verfügbar. Sie können weiterhin eine Verbindung zu einem Angebotsersteller herstellen.\n%2$@\n\nAdvanced: %3$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbound connections are unavailable on port %1$d. You can still connect to an offer creator.\n%2$@\n\nAdvanced: %3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las conexiones entrantes no están disponibles en el puerto %1$d. Aún puedes conectarte con un creador de ofertas.\n%2$@\n\nAdvanzado: %3$@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصالات ورودی در پورت %1$d در دسترس نیست. همچنان می‌توانید به ایجادکننده پیشنهاد متصل شوید.\n%2$@\n\nAپیشرفته: %3$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les connexions entrantes ne sont pas disponibles sur le port %1$d. Vous pouvez toujours vous connecter à un créateur d'offre.\n%2$@\n\nAvancé : %3$@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיבורים נכנסים אינם זמינים ביציאה %1$d. אתה עדיין יכול להתחבר ליוצר הצעה.\n%2$@\n\nAמתקדם: %3$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोर्ट %1$d पर इनबाउंड कनेक्शन उपलब्ध नहीं हैं।आप अभी भी किसी ऑफ़र निर्माता से जुड़ सकते हैं.\n%2$@\n\nउन्नत: %3$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi masuk tidak tersedia pada port %1$d. Anda masih dapat terhubung ke pembuat penawaran.\n%2$@\n\nALanjutan: %3$@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le connessioni in entrata non sono disponibili sulla porta %1$d. Puoi comunque connetterti a un creatore di offerte.\n%2$@\n\nAvanzato: %3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インバウンド接続はポート %1$d では使用できません。オファー作成者には引き続き接続できます。\n%2$@\n\n上級: %3$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포트 %1$d에서는 인바운드 연결을 사용할 수 없습니다. 제안 작성자에게 계속 연결할 수 있습니다.\n%2$@\n\n고급: %3$@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inkomende verbindingen zijn niet beschikbaar op poort %1$d. U kunt nog steeds verbinding maken met een maker van een aanbieding.\n%2$@\n\nGeavanceerd: %3$@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenia przychodzące są niedostępne na porcie %1$d. Nadal możesz połączyć się z kreatorem ofert.\n%2$@\n\nAzaawansowane: %3$@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As conexões de entrada não estão disponíveis na porta %1$d. Você ainda pode se conectar a um criador de oferta.\n%2$@\n\nAdvanced: %3$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Входящие соединения недоступны через порт %1$d. Вы по-прежнему можете подключиться к создателю предложения. \n%2$@\n\nДополнительно: %3$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d bağlantı noktasında gelen bağlantılar kullanılamıyor. Yine de bir teklif oluşturucuya bağlanabilirsiniz.\n%2$@\n\nAGelişmiş: %3$@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхідні з’єднання недоступні на порту %1$d. Ви все ще можете підключитися до творця пропозицій.\n%2$@\n\nAdvanced: %3$@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối gửi đến không khả dụng trên cổng %1$d. Bạn vẫn có thể kết nối với người tạo ưu đãi.\n%2$@\n\nNâng cao: %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口 %1$d 上的入站连接不可用。您仍然可以连接到报价创建者。\n%2$@\n\n高级：%3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接埠 %1$d 上的入站連線不可用。您仍然可以連接到報價建立者。 \n%2$@\n\n高階：%3$@"
          }
        }
      }
    },
    "wallet_direct_shakescape_locked": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح المحفظة لاستضافة أو إقران نظير مبادلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren Sie die Wallet, um einen Swap-Peer zu hosten oder zu koppeln."
          }
