    "wallet_bitcoin_send_prepare_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إعداد إرسال Bitcoin. قم بمزامنة محفظة Bitcoin وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Bitcoin-Versand konnte nicht vorbereitet werden. Synchronisieren Sie die Bitcoin-Wallet und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Bitcoin send could not be prepared. Synchronize the Bitcoin wallet and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo preparar el envío Bitcoin. Sincronice la billetera Bitcoin y vuelva a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسال Bitcoin آماده نشد. کیف پول Bitcoin را همگام کنید و دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'envoi Bitcoin n'a pas pu être préparé. Synchronisez le portefeuille Bitcoin et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להכין את השליחה Bitcoin. סנכרן את הארנק Bitcoin ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin प्रेषण तैयार नहीं किया जा सका. Bitcoin वॉलेट को सिंक्रोनाइज़ करें और पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengiriman Bitcoin tidak dapat disiapkan. Sinkronkan dompet Bitcoin dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile preparare l'invio Bitcoin. Sincronizza il portafoglio Bitcoin e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 送信を準備できませんでした。 Bitcoin ウォレットを同期して、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 전송을 준비할 수 없습니다. Bitcoin 지갑을 동기화하고 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Bitcoin-verzending kon niet worden voorbereid. Synchroniseer de Bitcoin-portemonnee en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można przygotować wysyłki Bitcoin. Zsynchronizuj portfel Bitcoin i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio Bitcoin não pôde ser preparado. Sincronize a carteira Bitcoin e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подготовить отправку Bitcoin. Синхронизируйте кошелек Bitcoin и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
