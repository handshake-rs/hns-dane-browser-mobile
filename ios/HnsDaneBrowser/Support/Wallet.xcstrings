            "value": "最高費用上限（HNS）"
          }
        }
      }
    },
    "wallet_send_pre_broadcast_syncing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم توقيع الصفقة أو بثها. جارٍ تحديث سجل المحفظة الذي تم التحقق منه قبل إجراء مراجعة جديدة..."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transaktion wurde weder unterzeichnet noch gesendet. Aktualisierung des verifizierten Wallet-Verlaufs vor einer neuen Überprüfung…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transaction was not signed or broadcast. Refreshing verified wallet history before a new review…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transacción no fue firmada ni transmitida. Actualizando el historial de billetera verificada antes de una nueva revisión..."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "معامله امضا یا پخش نشد. در حال بازخوانی سابقه کیف پول تأیید شده قبل از بررسی جدید…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transaction n'a été ni signée ni diffusée. Actualisation de l'historique vérifié du portefeuille avant un nouvel examen…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה לא נחתמה ולא שודרה. מרענן היסטוריית ארנק מאומת לפני סקירה חדשה..."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेन-देन पर हस्ताक्षर या प्रसारण नहीं किया गया था। नई समीक्षा से पहले सत्यापित वॉलेट इतिहास को ताज़ा किया जा रहा है..."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi tersebut tidak ditandatangani atau disiarkan. Menyegarkan riwayat dompet terverifikasi sebelum peninjauan baru…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La transazione non è stata firmata né trasmessa. Aggiornamento della cronologia del portafoglio verificata prima di una nuova revisione…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランザクションは署名またはブロードキャストされませんでした。新しいレビューの前に検証済みのウォレット履歴を更新しています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래가 서명되거나 브로드캐스트되지 않았습니다. 새로운 검토 전에 확인된 지갑 기록을 새로 고치는 중…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transactie is niet ondertekend of uitgezonden. Geverifieerde portefeuillegeschiedenis vernieuwen vóór een nieuwe beoordeling..."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja nie została podpisana ani wyemitowana. Odświeżam zweryfikowaną historię portfela przed nową recenzją…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A transação não foi assinada ou transmitida. Atualizando o histórico verificado da carteira antes de uma nova revisão…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакция не была подписана или транслирована. Обновление проверенной истории кошелька перед новым отзывом…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem imzalanmadı veya yayınlanmadı. Yeni bir incelemeden önce doğrulanmış cüzdan geçmişi yenileniyor…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Угода не була підписана чи трансльована. Оновлення перевіреної історії гаманця перед новим переглядом…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch không được ký hoặc phát sóng. Đang làm mới lịch sử ví đã được xác minh trước khi đánh giá mới…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该交易未签署或广播。在新的评论之前刷新已验证的钱包历史记录......"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該交易未簽署或廣播。在新的評論之前刷新已驗證的錢包歷史記錄..."
          }
        }
      }
    },
    "wallet_send_prepare_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم التوقيع على أي معاملة. تحقق من العنوان والرصيد المؤكد والرسوم، ثم قم بالمزامنة وأعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde keine Transaktion unterzeichnet. Überprüfen Sie die Adresse, den bestätigten Kontostand und die Gebühr, synchronisieren Sie dann und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No transaction was signed. Check the address, confirmed balance, and fee, then synchronize and retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se firmó ninguna transacción. Verifique la dirección, el saldo confirmado y la tarifa, luego sincronice y vuelva a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "معامله ای امضا نشد آدرس، موجودی تایید شده و هزینه را بررسی کنید، سپس همگام سازی کنید و دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune transaction n'a été signée. Vérifiez l'adresse, le solde confirmé et les frais, puis synchronisez et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נחתמה עסקה. בדוק את הכתובת, היתרה המאושרת והעמלה, ולאחר מכן סנכרן ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी लेन-देन पर हस्ताक्षर नहीं किया गया. पता, पुष्टिकृत शेष राशि और शुल्क की जाँच करें, फिर सिंक्रनाइज़ करें और पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada transaksi yang ditandatangani. Periksa alamat, saldo terkonfirmasi, dan biaya, lalu sinkronkan dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna transazione è stata firmata. Controlla l'indirizzo, il saldo confermato e la tariffa, quindi sincronizza e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランザクションは署名されていません。アドレス、確認残高、手数料を確認し、同期して再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명된 거래가 없습니다. 주소, 확인잔액, 수수료를 확인하신 후 동기화 후 재시도해주세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen transactie ondertekend. Controleer het adres, het bevestigde saldo en de kosten, synchroniseer vervolgens en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna transakcja nie została podpisana. Sprawdź adres, potwierdzone saldo i opłatę, a następnie zsynchronizuj i spróbuj ponownie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma transação foi assinada. Verifique o endereço, o saldo confirmado e a taxa, sincronize e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никакая сделка не была подписана. Проверьте адрес, подтвержденный баланс и комиссию, затем синхронизируйте и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir işlem imzalanmadı. Adresi, onaylanmış bakiyeyi ve ücreti kontrol edin, ardından senkronize edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодної транзакції не було підписано. Перевірте адресу, підтверджений баланс і комісію, потім синхронізуйте та повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có giao dịch nào được ký kết. Kiểm tra địa chỉ, số dư được xác nhận và phí, sau đó đồng bộ hóa và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有签署任何交易。检查地址、确认的余额和费用，然后同步并重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有簽署任何交易。檢查地址、確認的餘額和費用，然後同步並重試。"
          }
        }
      }
    },
