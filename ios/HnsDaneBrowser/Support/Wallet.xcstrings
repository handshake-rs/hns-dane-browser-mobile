    "wallet_bitcoin_birthday_recovery_unknown": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتفاع الاسترداد غير معروف؛ ستقوم المزامنة بإجراء فحص تاريخي كامل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erholungshöhe unbekannt; Durch die Synchronisierung wird ein vollständiger historischer Scan durchgeführt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "recovery height unknown; synchronization will perform a full historical scan"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "altura de recuperación desconocida; la sincronización realizará un escaneo histórico completo"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ارتفاع بازیابی نامشخص همگام سازی یک اسکن کامل تاریخی را انجام می دهد"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "hauteur de récupération inconnue ; la synchronisation effectuera une analyse historique complète"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גובה התאוששות לא ידוע; סנכרון יבצע סריקה היסטורית מלאה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्प्राप्ति ऊँचाई अज्ञात; सिंक्रनाइज़ेशन पूर्ण ऐतिहासिक स्कैन निष्पादित करेगा"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tinggi pemulihan tidak diketahui; sinkronisasi akan melakukan pemindaian riwayat penuh"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "altezza di recupero sconosciuta; la sincronizzazione eseguirà una scansione cronologica completa"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回復高さは不明。同期では完全な履歴スキャンが実行されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회복 높이를 알 수 없음; 동기화는 전체 기록 검색을 수행합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "herstelhoogte onbekend; synchronisatie voert een volledige historische scan uit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "wysokość powrotu nieznana; synchronizacja wykona pełne skanowanie historii"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "altura de recuperação desconhecida; a sincronização realizará uma verificação histórica completa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "высота подъема неизвестна; синхронизация выполнит полное историческое сканирование"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
