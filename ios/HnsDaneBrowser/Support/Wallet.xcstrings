    "wallet_swap_hns_prepare_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إعداد قائمة HNS-for-BTC. يجب أن تغطي HNS المتزامنة القوائم النشطة وهذا المبلغ المقفل بالكامل، والذي يتضمن احتياطي الرسوم الخاص بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auflistung HNS-for-BTC wurde nicht erstellt. Der synchronisierte HNS muss die aktiven Einträge und diesen gesamten gesperrten Betrag einschließlich der Gebührenreserve abdecken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The HNS-for-BTC listing was not prepared. Synchronized HNS must cover active listings and this complete locked amount, which includes its fee reserve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El listado HNS-for-BTC no se preparó. El HNS sincronizado debe cubrir los listados activos y este monto bloqueado completo, que incluye su reserva de tarifas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرست HNS-for-BTC آماده نشده است. HNS همگام‌سازی شده باید فهرست‌های فعال و این مبلغ قفل شده کامل را که شامل ذخیره هزینه آن می‌شود، پوشش دهد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste HNS-for-BTC n’a pas été préparée. Le HNS synchronisé doit couvrir les annonces actives et ce montant bloqué complet, qui inclut sa réserve de frais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרישום HNS-for-BTC לא הוכן. HNS המסונכרן חייב לכסות את הרישומים הפעילים ואת הסכום הנעול המלא הזה, הכולל את עתודת העמלות שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS-for-BTC सूची तैयार नहीं की गई थी। सिंक्रोनाइज़्ड HNS में सक्रिय लिस्टिंग और यह पूरी लॉक की गई राशि शामिल होनी चाहिए, जिसमें इसका शुल्क आरक्षित भी शामिल है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar HNS-untuk-BTC belum disiapkan. HNS yang disinkronkan harus mencakup listing aktif dan jumlah terkunci lengkap ini, termasuk cadangan biayanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco HNS-for-BTC non è stato preparato. HNS sincronizzato deve coprire le inserzioni attive e l'intero importo bloccato, che include la riserva di commissione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS の BTC リストは準備されていませんでした。同期された HNS は、アクティブなリストと、手数料準備金を含むこの完全なロック金額をカバーする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS-for-BTC 목록이 준비되지 않았습니다. 동기화된 HNS는 활성 목록과 수수료 준비금을 포함하여 전체 잠긴 금액을 포함해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vermelding HNS-voor-BTC is niet opgesteld. Gesynchroniseerde HNS moet actieve vermeldingen en dit volledige vergrendelde bedrag dekken, inclusief de kostenreservering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista HNS-for-BTC nie została przygotowana. Zsynchronizowane HNS musi obejmować aktywne oferty i całą zablokowaną kwotę, która obejmuje rezerwę opłat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A listagem HNS-for-BTC não foi preparada. O HNS sincronizado deve cobrir as listagens ativas e todo esse valor bloqueado, que inclui sua reserva de taxa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Листинг HNS для BTC не был подготовлен. Синхронизированный HNS должен покрывать активные листинги и всю заблокированную сумму, включая резерв комиссии."
          }
