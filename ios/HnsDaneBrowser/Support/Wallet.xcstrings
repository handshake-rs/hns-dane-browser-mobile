    "wallet_reads_catching_up_degraded": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتفق الزملاء على الكتلة %1$d. ستتم إعادة محاولة المزامنة مع أقرانهم الآخرين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kollegen waren sich im Block %1$d nicht einig. Die Synchronisierung wird mit anderen Peers erneut versucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Peers did not agree at block %1$d. Synchronization will retry with other peers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
