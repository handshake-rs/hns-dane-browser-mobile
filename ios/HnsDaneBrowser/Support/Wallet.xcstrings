            "state": "translated",
            "value": "Portfel zablokowany przed sparowaniem partnera wymiany."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira foi bloqueada antes que o ponto de troca pudesse ser emparelhado."
          }
