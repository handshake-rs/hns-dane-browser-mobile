            "value": "A new Bitcoin receive address could not be derived and persisted locally."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo derivar ni conservar localmente una nueva dirección de recepción Bitcoin."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک آدرس دریافت جدید Bitcoin نمی تواند مشتق شود و به صورت محلی ادامه یابد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle adresse de réception Bitcoin n'a pas pu être dérivée et conservée localement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לגזור כתובת חדשה לקבלה Bitcoin והיא נמשכת באופן מקומי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक नया Bitcoin प्राप्त पता प्राप्त नहीं किया जा सका और स्थानीय रूप से जारी रखा जा सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat penerimaan Bitcoin baru tidak dapat diperoleh dan disimpan secara lokal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile derivare un nuovo indirizzo di ricezione Bitcoin e renderlo persistente localmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい Bitcoin 受信アドレスをローカルに導出および保持できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 Bitcoin 수신 주소를 로컬에서 파생 및 유지할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nieuw Bitcoin-ontvangstadres kon niet worden afgeleid en lokaal worden gehandhaafd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można uzyskać i utrwalić nowego adresu odbiorczego Bitcoin lokalnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um novo endereço de recebimento Bitcoin não pôde ser derivado e persistido localmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый адрес получения Bitcoin не удалось получить и сохранить локально."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni bir Bitcoin alma adresi türetilemedi ve yerel olarak sürdürülemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нову адресу отримання Bitcoin не вдалося отримати та зберегти локально."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lấy địa chỉ nhận Bitcoin mới và tồn tại cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法在本地派生并保留新的 Bitcoin 接收地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法在本地派生並保留新的 Bitcoin 接收位址。"
          }
        }
      }
    },
