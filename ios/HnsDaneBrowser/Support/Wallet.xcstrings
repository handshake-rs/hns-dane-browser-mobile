    "wallet_bitcoin_send_action_pending": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاملة Bitcoin تنتظر المراجعة أو البث بالفعل. قم بإنهائه أو أعد فتحه وقم بمزامنته قبل إعداد ملف آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Bitcoin-Transaktion wartet bereits auf Überprüfung oder Übertragung. Beenden Sie es oder öffnen Sie es erneut und synchronisieren Sie es, bevor Sie ein anderes vorbereiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A Bitcoin transaction is already awaiting review or broadcast. Finish it or reopen and synchronize before preparing another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una transacción Bitcoin ya está pendiente de revisión o transmisión. Termínalo o vuelve a abrirlo y sincronízalo antes de preparar otro."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش Bitcoin در حال حاضر در انتظار بررسی یا پخش است. آن را تمام کنید یا دوباره باز کنید و قبل از تهیه دیگری همگام کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une transaction Bitcoin est déjà en attente de révision ou de diffusion. Terminez-le ou rouvrez-le et synchronisez-le avant d'en préparer un autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עסקת Bitcoin כבר ממתינה לבדיקה או לשידור. סיים אותו או פתח מחדש וסנכרן לפני הכנת עוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक Bitcoin लेनदेन पहले से ही समीक्षा या प्रसारण की प्रतीक्षा कर रहा है। दूसरा तैयार करने से पहले इसे ख़त्म करें या फिर से खोलें और सिंक्रोनाइज़ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi Bitcoin sedang menunggu peninjauan atau siaran. Selesaikan atau buka kembali dan sinkronkan sebelum menyiapkan yang lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una transazione Bitcoin è già in attesa di revisione o trasmissione. Terminalo o riaprilo e sincronizzalo prima di prepararne un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin トランザクションはすでにレビューまたはブロードキャストを待っています。それを終了するか、別の準備をする前に再度開いて同期してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 거래가 이미 검토 또는 브로드캐스트 대기 중입니다. 다른 작업을 준비하기 전에 완료하거나 다시 열고 동기화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een Bitcoin-transactie wacht al op beoordeling of uitzending. Maak het af of open het opnieuw en synchroniseer voordat u een ander voorbereidt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja Bitcoin już oczekuje na sprawdzenie lub transmisję. Zakończ lub otwórz ponownie i zsynchronizuj przed przygotowaniem kolejnego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma transação Bitcoin já está aguardando revisão ou transmissão. Conclua ou reabra e sincronize antes de preparar outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакция Bitcoin уже ожидает рассмотрения или трансляции. Завершите его или снова откройте и синхронизируйте, прежде чем готовить следующий."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Bitcoin işlemi zaten incelenmeyi veya yayınlanmayı bekliyor. Başka bir tane hazırlamadan önce bitirin veya yeniden açın ve senkronize edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансакція Bitcoin вже очікує на перегляд або трансляцію. Завершіть його або знову відкрийте та синхронізуйте, перш ніж готувати інший."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch Bitcoin đang chờ xem xét hoặc phát sóng. Hoàn thành nó hoặc mở lại và đồng bộ hóa trước khi chuẩn bị cái khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 交易已在等待审核或广播。完成它或在准备另一个之前重新打开并同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 交易已在等待審核或廣播。完成它或在準備另一個之前重新打開並同步。"
          }
        }
      }
    },
    "wallet_bitcoin_send_ambiguous": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حفظ معاملة Bitcoin هذه ولكن لم يتم إرسالها بعد. قم بإلغاء القفل والمزامنة لإعادة المحاولة. لا تقم بإنشاء إرسال آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bitcoin-Transaktion wurde gespeichert, aber noch nicht übermittelt. Entsperren und synchronisieren, um es erneut zu versuchen. Erstellen Sie keinen weiteren Versand."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Bitcoin transaction is saved but not yet submitted. Unlock and synchronize to retry it. Do not create another send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transacción Bitcoin se guardó pero aún no se envió. Desbloquee y sincronice para volver a intentarlo. No crees otro envío."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این تراکنش Bitcoin ذخیره شده است اما هنوز ارسال نشده است. برای امتحان مجدد، قفل را باز کرده و همگام کنید. ارسال دیگری ایجاد نکنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette transaction Bitcoin est enregistrée mais pas encore soumise. Déverrouillez et synchronisez pour réessayer. Ne créez pas un autre envoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עסקת Bitcoin זו נשמרה אך טרם הוגשה. בטל את הנעילה וסנכרן כדי לנסות שוב. אל תיצור עוד שליחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Bitcoin लेनदेन सहेजा गया है लेकिन अभी तक सबमिट नहीं किया गया है। इसे पुनः प्रयास करने के लिए अनलॉक और सिंक्रोनाइज़ करें। दूसरा सेंड न बनाएं."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi Bitcoin ini telah disimpan tetapi belum dikirimkan. Buka kunci dan sinkronkan untuk mencobanya lagi. Jangan membuat pengiriman lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa transazione Bitcoin è salvata ma non ancora inviata. Sblocca e sincronizza per riprovare. Non creare un altro invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Bitcoin トランザクションは保存されていますが、まだ送信されていません。ロックを解除して同期し、再試行してください。別の送信を作成しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Bitcoin 거래는 저장되었지만 아직 제출되지 않았습니다. 다시 시도하려면 잠금을 해제하고 동기화하세요. 다른 전송을 생성하지 마십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Bitcoin-transactie is opgeslagen maar nog niet verzonden. Ontgrendel en synchroniseer om het opnieuw te proberen. Maak geen nieuwe verzending aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta transakcja Bitcoin została zapisana, ale nie została jeszcze przesłana. Odblokuj i zsynchronizuj, aby spróbować ponownie. Nie twórz kolejnej wysyłki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transação Bitcoin foi salva, mas ainda não foi enviada. Desbloqueie e sincronize para tentar novamente. Não crie outro envio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта транзакция Bitcoin сохранена, но еще не отправлена. Разблокируйте и синхронизируйте, чтобы повторить попытку. Не создавайте еще одну отправку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Bitcoin işlemi kaydedildi ancak henüz gönderilmedi. Yeniden denemek için kilidi açın ve senkronize edin. Başka bir gönderim oluşturmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю трансакцію Bitcoin збережено, але ще не надіслано. Розблокуйте та синхронізуйте, щоб повторити спробу. Не створюйте іншу відправку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch Bitcoin này đã được lưu nhưng chưa được gửi. Mở khóa và đồng bộ hóa để thử lại. Không tạo một lần gửi khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Bitcoin 交易已保存但尚未提交。解锁并同步以重试。不要创建另一个发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Bitcoin 交易已儲存但尚未提交。解鎖並同步以重試。不要創建另一個發送。"
          }
        }
      }
    },
