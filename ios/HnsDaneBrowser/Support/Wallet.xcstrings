    "wallet_swap_recovery_detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمليات البث المحفوظة Bitcoin - في انتظار: %1$d؛ النتيجة معلقة: %2$d؛ المقدم: %3$d؛ لاحظ: %4$d؛ معظم المحاولات: %5$d؛ التغيير الأخير: Unix %6$d. يقوم الاسترداد بإعادة محاولة نفس المعاملة الموقعة ولا يقوم أبدًا بإنشاء بديل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Bitcoin-Sendungen – warten: %1$d; Ergebnis steht noch aus: %2$d; eingereicht: %3$d; beobachtet: %4$d; die meisten Versuche: %5$d; letzte Änderung: Unix %6$d. Die Wiederherstellung versucht dieselbe signierte Transaktion erneut und erstellt niemals einen Ersatz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved Bitcoin broadcasts — waiting: %1$d; result pending: %2$d; submitted: %3$d; observed: %4$d; most attempts: %5$d; last change: Unix %6$d. Recovery retries the same signed transaction and never creates a replacement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmisiones Bitcoin guardadas - en espera: %1$d; resultado pendiente: %2$d; enviado: %3$d; observado: %4$d; la mayoría de los intentos: %5$d; último cambio: Unix %6$d. La recuperación vuelve a intentar la misma transacción firmada y nunca crea un reemplazo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پخش های ذخیره شده Bitcoin — در انتظار: %1$d; نتیجه در انتظار: %2$d; ارسال شده: %3$d; مشاهده شده: %4$d; بیشترین تلاش: %5$d; آخرین تغییر: Unix %6$d. بازیابی همان تراکنش امضا شده را دوباره امتحان می کند و هرگز جایگزینی ایجاد نمی کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffusions Bitcoin enregistrées — en attente : %1$d ; résultat en attente : %2$d ; soumis : %3$d ; observé : %4$d ; la plupart des tentatives : %5$d ; dernière modification : Unix %6$d. La récupération réessaye la même transaction signée et ne crée jamais de remplacement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שידורי Bitcoin שמורים - ממתינים: %1$d; תוצאה בהמתנה: %2$d; הוגשה: %3$d; נצפה: %4$d; רוב הניסיונות: %5$d; שינוי אחרון: Unix %6$d. Recovery מנסה שוב את אותה עסקה חתומה ולעולם לא יוצרת תחליף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजे गए Bitcoin प्रसारण - प्रतीक्षा: %1$d; परिणाम लंबित: %2$d; सबमिट किया गया: %3$d; अवलोकन किया गया: %4$d; सर्वाधिक प्रयास: %5$d; अंतिम परिवर्तन: Unix %6$d। पुनर्प्राप्ति उसी हस्ताक्षरित लेनदेन का पुनः प्रयास करती है और कभी भी कोई प्रतिस्थापन नहीं बनाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran Bitcoin yang disimpan — menunggu: %1$d; hasil tertunda: %2$d; diserahkan: %3$d; diamati: %4$d; upaya terbanyak: %5$d; perubahan terakhir: Unix %6$d. Pemulihan mencoba kembali transaksi yang ditandatangani sama dan tidak pernah membuat penggantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasmissioni Bitcoin salvate: in attesa: %1$d; risultato in attesa: %2$d; presentato: %3$d; osservato: %4$d; maggior numero di tentativi: %5$d; ultima modifica: Unix %6$d. Il ripristino ritenta la stessa transazione firmata e non crea mai una sostituzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された Bitcoin ブロードキャスト — 待機中: %1$d;結果保留中: %2$d;提出済み: %3$d;観察された: %4$d;ほとんどの試行: %5$d;最終変更: Unix %6$d。リカバリでは同じ署名済みトランザクションが再試行され、置換は作成されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 Bitcoin 방송 — 대기 중: %1$d; 결과 보류 중: %2$d; 제출됨: %3$d; 관찰됨: %4$d; 대부분의 시도: %5$d; 마지막 변경: Unix %6$d. 복구에서는 동일한 서명된 트랜잭션을 다시 시도하고 대체 트랜잭션을 생성하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen Bitcoin-uitzendingen — wachtend: %1$d; resultaat in behandeling: %2$d; ingediend: %3$d; waargenomen: %4$d; meeste pogingen: %5$d; laatste wijziging: Unix %6$d. Recovery voert dezelfde ondertekende transactie opnieuw uit en creëert nooit een vervanging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane transmisje Bitcoin — oczekiwanie: %1$d; wynik w oczekiwaniu: %2$d; przesłano: %3$d; zaobserwowano: %4$d; większość prób: %5$d; ostatnia zmiana: Unix %6$d. Odzyskiwanie ponawia tę samą podpisaną transakcję i nigdy nie tworzy zamiennika."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmissões Bitcoin salvas — aguardando: %1$d; resultado pendente: %2$d; enviado: %3$d; observado: %4$d; maioria das tentativas: %5$d; última alteração: Unix %6$d. A recuperação tenta novamente a mesma transação assinada e nunca cria uma substituição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраненные трансляции Bitcoin — ожидание: %1$d; ожидается результат: %2$d; отправлено: %3$d; замечено: %4$d; наибольшее количество попыток: %5$d; последнее изменение: Unix %6$d. Восстановление повторяет ту же подписанную транзакцию и никогда не создает замену."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen Bitcoin yayınları — bekliyor: %1$d; sonuç bekleniyor: %2$d; gönderilen: %3$d; gözlenen: %4$d; çoğu deneme: %5$d; son değişiklik: Unix %6$d. Kurtarma aynı imzalı işlemi yeniden dener ve hiçbir zaman yeni bir işlem oluşturmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережені трансляції Bitcoin — очікують: %1$d; результат очікується: %2$d; подано: %3$d; спостерігається: %4$d; найбільше спроб: %5$d; остання зміна: Unix %6$d. Відновлення повторює ту саму підписану транзакцію та ніколи не створює заміну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các chương trình phát sóng Bitcoin đã lưu - đang chờ: %1$d; kết quả đang chờ xử lý: %2$d; đã gửi: %3$d; quan sát thấy: %4$d; số lần thử nhiều nhất: %5$d; thay đổi cuối cùng: Unix %6$d. Khôi phục thử lại giao dịch đã ký tương tự và không bao giờ tạo giao dịch thay thế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的 Bitcoin 广播 — 等待：%1$d；结果待定：%2$d；提交：%3$d；观察到：%4$d；尝试次数最多：%5$d；最后更改：Unix %6$d。恢复重试相同的签名事务并且永远不会创建替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的比特幣廣播 — 等待： %1$d ；結果待定： %2$d ；已提交： %3$d ；觀察到： %4$d ；大多數嘗試： %5$d ；最後更改： Unix %6$d 。恢復重試相同的簽章交易並且永遠不會建立替換。"
          }
        }
      }
    },
    "wallet_swap_recovery_none": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد معاملة Bitcoin معتمدة في انتظار استرداد البث الدائم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine genehmigte Bitcoin-Transaktion wartet auf eine dauerhafte Broadcast-Wiederherstellung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No approved Bitcoin transaction is awaiting durable broadcast recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna transacción Bitcoin aprobada está a la espera de una recuperación de transmisión duradera."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ تراکنش تایید شده Bitcoin در انتظار بازیابی پخش بادوام نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune transaction Bitcoin approuvée n’est en attente de récupération de diffusion durable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום עסקה מאושרת של Bitcoin לא ממתינה לשחזור שידור עמיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई स्वीकृत Bitcoin लेनदेन टिकाऊ प्रसारण पुनर्प्राप्ति की प्रतीक्षा नहीं कर रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada transaksi Bitcoin yang disetujui yang menunggu pemulihan siaran yang tahan lama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna transazione Bitcoin approvata è in attesa di un ripristino duraturo della trasmissione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "永続的なブロードキャスト リカバリを待っている承認済みの Bitcoin トランザクションはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인된 Bitcoin 거래가 내구성 있는 브로드캐스트 복구를 기다리고 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen enkele goedgekeurde Bitcoin-transactie wacht op duurzaam herstel van de uitzending."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna zatwierdzona transakcja Bitcoin nie oczekuje na trwałe przywrócenie transmisji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma transação Bitcoin aprovada aguarda recuperação de transmissão durável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни одна одобренная транзакция Bitcoin не ожидает долговременного восстановления широковещательной рассылки."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dayanıklı yayın kurtarmayı bekleyen onaylanmış Bitcoin işlemi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Жодна схвалена транзакція Bitcoin не очікує тривалого відновлення трансляції."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có giao dịch Bitcoin nào được phê duyệt đang chờ khôi phục phát sóng lâu dài."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有已批准的 Bitcoin 交易正在等待持久广播恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有已批准的 Bitcoin 交易正在等待持久廣播恢復。"
          }
        }
      }
    },
    "wallet_swap_recovery_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالة استرداد البث Bitcoin غير متاحة مؤقتًا عندما تكون وحدة التحكم Bitcoin مشغولة أو غير نشطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Broadcast-Wiederherstellungsstatus Bitcoin ist vorübergehend nicht verfügbar, während der Bitcoin-Controller ausgelastet oder inaktiv ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin broadcast recovery status is temporarily unavailable while the Bitcoin controller is busy or inactive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado de recuperación de transmisión Bitcoin no está disponible temporalmente mientras el controlador Bitcoin está ocupado o inactivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وضعیت بازیابی پخش Bitcoin به طور موقت در دسترس نیست در حالی که کنترلر Bitcoin مشغول یا غیرفعال است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'état de récupération de diffusion du Bitcoin est temporairement indisponible lorsque le contrôleur Bitcoin est occupé ou inactif."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצב שחזור שידור Bitcoin אינו זמין באופן זמני כאשר הבקר Bitcoin תפוס או לא פעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin प्रसारण पुनर्प्राप्ति स्थिति अस्थायी रूप से अनुपलब्ध है जबकि Bitcoin नियंत्रक व्यस्त या निष्क्रिय है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status pemulihan siaran Bitcoin untuk sementara tidak tersedia saat pengontrol Bitcoin sibuk atau tidak aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato di ripristino della trasmissione Bitcoin è temporaneamente non disponibile mentre il controller Bitcoin è occupato o inattivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin ブロードキャスト リカバリ ステータスは、Bitcoin コントローラがビジーまたは非アクティブの間、一時的に利用できなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin 브로드캐스트 복구 상태는 Bitcoin 컨트롤러가 사용 중이거나 비활성 상태인 동안 일시적으로 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herstelstatus van de Bitcoin-uitzending is tijdelijk niet beschikbaar terwijl de Bitcoin-controller bezet of inactief is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stan odzyskiwania transmisji Bitcoin jest tymczasowo niedostępny, gdy kontroler Bitcoin jest zajęty lub nieaktywny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O status de recuperação de transmissão Bitcoin fica temporariamente indisponível enquanto o controlador Bitcoin está ocupado ou inativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Статус восстановления широковещательной рассылки Bitcoin временно недоступен, пока контроллер Bitcoin занят или неактивен."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin yayın kurtarma durumu, Bitcoin denetleyici meşgul veya etkin değilken geçici olarak kullanılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Статус відновлення трансляції Bitcoin тимчасово недоступний, поки контролер Bitcoin зайнятий або неактивний."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái khôi phục phát sóng Bitcoin tạm thời không khả dụng trong khi bộ điều khiển Bitcoin bận hoặc không hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Bitcoin 控制器繁忙或不活动时，Bitcoin 广播恢复状态暂时不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Bitcoin 控制器繁忙或不活動時，Bitcoin 廣播恢復狀態暫時無法使用。"
          }
        }
      }
    },
