          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The approval could not be discarded cleanly, so the wallet was locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aprobación no se pudo descartar limpiamente, por lo que se cerró la billetera."
          }
