        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुल्यकालन प्रगति पर है. समाप्त होने पर अनलॉक भेजना।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronisasi sedang berlangsung. Pengiriman akan terbuka setelah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione è in corso. L'invio si sblocca al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期が進行中です。送信が完了するとロックが解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화가 진행 중입니다. 전송이 완료되면 잠금이 해제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
