            "value": "کیف پول HNS آماده است. برای تأیید موجودی فعلی آن و فعال کردن ارسال، همگام سازی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portefeuille HNS est prêt. Synchronisez-vous pour vérifier son solde actuel et activer l'envoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הארנק HNS מוכן. סנכרן כדי לאמת את היתרה הנוכחית שלו ולאפשר שליחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS वॉलेट तैयार है। इसके वर्तमान शेष को सत्यापित करने और भेजने को सक्षम करने के लिए सिंक्रनाइज़ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet HNS sudah siap. Sinkronkan untuk memverifikasi saldo saat ini dan mengaktifkan pengiriman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il portafoglio HNS è pronto. Sincronizza per verificare il saldo attuale e abilitare l'invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS ウォレットの準備ができました。同期して現在の残高を確認し、送信を有効にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 지갑이 준비되었습니다. 동기화하여 현재 잔액을 확인하고 전송을 활성화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De HNS portemonnee is klaar. Synchroniseer om het huidige saldo te verifiëren en verzending mogelijk te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfel HNS jest gotowy. Zsynchronizuj, aby sprawdzić aktualne saldo i umożliwić wysyłanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira HNS está pronta. Sincronize para verificar seu saldo atual e ativar o envio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелек HNS готов. Синхронизируйте, чтобы проверить текущий баланс и включить отправку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS cüzdanı hazır. Mevcut bakiyeyi doğrulamak ve göndermeyi etkinleştirmek için senkronize edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманець HNS готовий. Синхронізуйте, щоб перевірити його поточний баланс і дозволити надсилання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví HNS đã sẵn sàng. Đồng bộ hóa để xác minh số dư hiện tại và cho phép gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
