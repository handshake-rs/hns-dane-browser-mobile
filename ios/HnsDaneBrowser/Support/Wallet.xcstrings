            "state": "translated",
            "value": "Abra y desbloquee una billetera local confirmada para inspeccionar las lecturas sincronizadas de HNS."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک کیف پول محلی تایید شده را باز کنید و قفل آن را باز کنید تا خواندن های همگام HNS را بررسی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez et déverrouillez un portefeuille local confirmé pour inspecter les lectures synchronisées HNS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח ופתח את הנעילה של ארנק מקומי מאושר כדי לבדוק קריאות HNS מסונכרנות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक्रनाइज़ HNS रीड्स का निरीक्षण करने के लिए एक पुष्टिकृत स्थानीय वॉलेट खोलें और अनलॉक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka dan buka kunci dompet lokal yang dikonfirmasi untuk memeriksa pembacaan HNS yang disinkronkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri e sblocca un portafoglio locale confermato per ispezionare le letture HNS sincronizzate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認済みのローカルウォレットを開いてロックを解除し、同期された HNS 読み取りを検査します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화된 HNS 읽기를 검사하려면 확인된 로컬 지갑을 열고 잠금을 해제하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open en ontgrendel een bevestigde lokale portemonnee om gesynchroniseerde HNS-lezingen te inspecteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz i odblokuj potwierdzony portfel lokalny, aby sprawdzić zsynchronizowane odczyty HNS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra e desbloqueie uma carteira local confirmada para inspecionar leituras HNS sincronizadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте и разблокируйте подтвержденный локальный кошелек, чтобы проверить синхронизированные чтения HNS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkronize edilmiş HNS okumalarını incelemek için onaylanmış bir yerel cüzdanı açın ve kilidini açın."
