    "wallet_name_import_invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص ليس اسم Unicode أو اسم ASCII Handshake صالح. لم يتم استيراد أي شيء وتبقى المحفظة قابلة للاستخدام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Text ist kein gültiger Unicode- oder kanonischer ASCII Handshake-Name. Es wurde nichts importiert und das Wallet bleibt nutzbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The text is not one valid Unicode or canonical ASCII Handshake name. Nothing was imported and the wallet remains usable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto no es un nombre Unicode válido o canónico ASCII Handshake. No se importó nada y la billetera sigue siendo utilizable."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "متن یک نام معتبر Unicode یا متعارف ASCII Handshake نیست. هیچ چیزی وارد نشده است و کیف پول قابل استفاده باقی می ماند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte n’est pas un nom Unicode valide ou un nom canonique ASCII Handshake. Rien n'a été importé et le portefeuille reste utilisable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטקסט אינו שם Unicode חוקי אחד או ASCII Handshake קנוני. שום דבר לא יובא והארנק נשאר שמיש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पाठ एक वैध Unicode या विहित ASCII Handshake नाम नहीं है। कुछ भी आयात नहीं किया गया और बटुआ उपयोग योग्य बना हुआ है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks tersebut bukan satu nama Unicode atau ASCII Handshake yang valid. Tidak ada yang diimpor dan dompet tetap dapat digunakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo non è un nome Unicode valido o ASCII Handshake canonico. Non è stato importato nulla e il portafoglio rimane utilizzabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストは有効な Unicode または正規の ASCII Handshake 名ではありません。何もインポートされず、ウォレットは引き続き使用可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트가 유효한 Unicode 또는 정식 ASCII Handshake 이름이 아닙니다. 가져온 것이 없으며 지갑을 계속 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De tekst is niet één geldige Unicode- of canonieke ASCII Handshake-naam. Er is niets geïmporteerd en de portemonnee blijft bruikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst nie jest prawidłową nazwą Unicode ani kanoniczną nazwą ASCII Handshake. Nic nie zostało zaimportowane, a portfel nadal nadaje się do użytku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto não é um nome Unicode válido ou canônico ASCII Handshake. Nada foi importado e a carteira continua utilizável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст не является допустимым именем Unicode или каноническим именем ASCII Handshake. Ничего не было импортировано, и кошелек остается пригодным для использования."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin geçerli bir Unicode veya standart ASCII Handshake adı değil. Hiçbir şey içe aktarılmadı ve cüzdan kullanılabilir durumda kaldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст не є однією дійсною назвою Unicode або канонічної ASCII Handshake. Нічого не було імпортовано, і гаманець залишається придатним для використання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản không phải là một tên Unicode hợp lệ hoặc tên ASCII Handshake hợp lệ. Không có gì được nhập và ví vẫn có thể sử dụng được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文本不是有效的 Unicode 或规范的 ASCII Handshake 名称。没有导入任何内容，钱包仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該文本不是有效的 Unicode 或規範的 ASCII Handshake 名稱。沒有導入任何內容，錢包仍然可用。"
          }
        }
      }
    },
