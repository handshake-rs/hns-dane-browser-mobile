    "wallet_send_recovery_unconfirmed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتأكيد النسخ الاحتياطي للاسترداد قبل تثبيت سلطة القيمة HNS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie die Wiederherstellungssicherung, bevor die Wertberechtigung HNS installiert werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the recovery backup before HNS value authority can be installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme la copia de seguridad de recuperación antes de que se pueda instalar la autoridad de valor HNS."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل از نصب مرجع ارزش HNS، نسخه پشتیبان بازیابی را تأیید کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez la sauvegarde de récupération avant que l'autorité de valeur HNS puisse être installée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשר את גיבוי השחזור לפני שניתן יהיה להתקין את רשות הערך HNS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS मान प्राधिकरण स्थापित होने से पहले पुनर्प्राप्ति बैकअप की पुष्टि करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmasikan cadangan pemulihan sebelum otoritas nilai HNS dapat diinstal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confermare il backup di ripristino prima di poter installare l'autorità del valore HNS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 値権限をインストールする前に、回復バックアップを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 값 권한을 설치하기 전에 복구 백업을 확인하십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig de herstelback-up voordat de waardeautoriteit HNS kan worden geïnstalleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdź kopię zapasową odzyskiwania, zanim będzie można zainstalować uprawnienia wartości HNS."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme o backup de recuperação antes que a autoridade de valor HNS possa ser instalada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите резервную копию для восстановления, прежде чем можно будет установить центр управления значением HNS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS değer yetkisi kurulmadan önce kurtarma yedeklemesini onaylayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтвердьте резервну копію для відновлення, перш ніж можна буде інсталювати авторизацію значення HNS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận bản sao lưu khôi phục trước khi có thể cài đặt quyền giá trị HNS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认恢复备份后才能安装HNS值权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認恢復備份後才能安裝HNS值權限。"
          }
        }
      }
