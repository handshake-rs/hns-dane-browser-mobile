    "wallet_swap_hns_approval_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بقفل %1$@ HNS لـ %2$d بالضبط. يتضمن المبلغ المقفل الحد الأقصى لاحتياطي رسوم التسوية %3$@ HNS. إجمالي HNS مقفل: %4$@ HNS. نشر اللافتات والمشاركات ذات الشروط الثابتة؛ فهو لا يمول المبادلة الذرية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperren Sie %1$@ HNS für genau %2$d sats. Der gesperrte Betrag beinhaltet eine maximale Rückstellung für Abwicklungsgebühren %3$@ HNS. Insgesamt HNS gesperrt: %4$@ HNS. Der Verlag unterzeichnet und teilt die festgelegten Bedingungen mit; Der Atomaustausch wird dadurch nicht finanziert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lock %1$@ HNS for exactly %2$d sats. The locked amount includes a maximum %3$@ HNS settlement-fee reserve. Total HNS locked: %4$@ HNS. Publishing signs and shares the fixed terms; it does not fund the atomic swap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquee %1$@ HNS exactamente para %2$d sats. El monto bloqueado incluye una reserva máxima de tarifa de liquidación %3$@ HNS. Total HNS bloqueado: %4$@ HNS. La editorial firma y comparte los términos fijados; no financia el intercambio atómico."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قفل %1$@ HNS دقیقا برای %2$d sats. مبلغ قفل شده شامل حداکثر ذخیره هزینه تسویه حساب %3$@ HNS است. مجموع HNS قفل شده: %4$@ HNS. انتشار شرایط ثابت را امضا و به اشتراک می گذارد. سوآپ اتمی را تامین مالی نمی کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrouillez %1$@ HNS pour exactement %2$d sats. Le montant bloqué comprend une réserve maximale pour frais de règlement %3$@ HNS. Total HNS verrouillé : %4$@ HNS. L'édition signe et partage les termes fixés ; il ne finance pas l’échange atomique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נעל %1$@ HNS בדיוק עבור %2$d sats. הסכום הנעול כולל רזרבה מרבית של %3$@ HNS. סך ה-HNS נעול: %4$@ HNS. פרסום חותם ומשתף את התנאים הקבועים; זה לא מממן את ההחלפה האטומית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्कुल %2$d sats के लिए %1$@ HNS को लॉक करें। लॉक की गई राशि में अधिकतम %3$@ HNS निपटान-शुल्क आरक्षित शामिल है। कुल HNS लॉक: %4$@ HNS। संकेत प्रकाशित करना और निश्चित शर्तों को साझा करना; यह परमाणु अदला-बदली को वित्त पोषित नहीं करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci %1$@ HNS tepat untuk %2$d sats. Jumlah yang dikunci mencakup cadangan biaya penyelesaian maksimum %3$@ HNS. Total HNS terkunci: %4$@ HNS. Menerbitkan tanda dan membagikan syarat-syarat yang tetap; itu tidak mendanai pertukaran atom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocca %1$@ HNS esattamente per %2$d sats. L'importo bloccato include una riserva massima per la commissione di liquidazione %3$@ HNS. Totale HNS bloccato: %4$@ HNS. La pubblicazione firma e condivide i termini fissati; non finanzia lo scambio atomico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ HNS を正確に %2$d sats にロックします。ロックされた金額には、最大 %3$@ HNS 決済手数料準備金が含まれます。ロックされた合計 HNS: %4$@ HNS。出版者は固定条件に署名し、共有します。アトミック・スワップに資金を提供するわけではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확히 %2$d sats에 대해 %1$@ HNS를 잠급니다. 잠긴 금액에는 최대 %3$@ HNS 결제 수수료 적립금이 포함됩니다. 잠긴 총 HNS: %4$@ HNS. 고정된 조건을 게시하고 공유합니다. 아토믹 스왑에 자금을 지원하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergrendel %1$@ HNS voor precies %2$d sats.Het vergrendelde bedrag omvat een reserve van maximaal %3$@ HNS-afwikkelingskosten.Totaal HNS vergrendeld: %4$@ HNS .Uitgeverij tekent en deelt de vaste voorwaarden;het financiert de atomaire swap niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokuj %1$@ HNS dokładnie dla %2$d sats. Zablokowana kwota uwzględnia maksymalną rezerwę na opłatę rozliczeniową %3$@ HNS. Razem HNS zablokowane: %4$@ HNS. Wydawnictwo podpisuje i udostępnia stałe warunki; nie finansuje wymiany atomowej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueie %1$@ HNS exatamente para %2$d sats. O valor bloqueado inclui uma reserva máxima de taxa de liquidação %3$@ HNS. Total HNS bloqueado: %4$@ HNS. A Editora assina e partilha os termos fixos; não financia a troca atômica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокируйте %1$@ HNS именно для %2$d sats. Заблокированная сумма включает максимальный резерв расчетной комиссии %3$@ HNS. Всего HNS заблокировано: %4$@ HNS. Издательство подписывает и разделяет установленные условия; он не финансирует атомный своп."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam olarak %2$d sats için %1$@ HNS'yi kilitleyin. Kilitli tutar, maksimum %3$@ HNS uzlaşma ücreti rezervini içerir. Toplam HNS kilitli: %4$@ HNS. Yayıncılık sabit şartları imzalar ve paylaşır; atom takasını finanse etmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокуйте %1$@ HNS саме для %2$d sats. Заблокована сума включає максимальний резерв %3$@ HNS комісії за розрахунки. Усього заблоковано HNS: %4$@ HNS. Видавництво підписує та акції фіксовані терміни; він не фінансує атомний обмін."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa %1$@ HNS cho chính xác %2$d sats. Số tiền bị khóa bao gồm khoản dự trữ phí thanh toán %3$@ HNS tối đa. Tổng số HNS bị khóa: %4$@ HNS. Đăng ký và chia sẻ các điều khoản cố định; nó không tài trợ cho việc hoán đổi nguyên tử."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定 %1$@ HNS 为 %2$d sats。锁定金额包含最高结算费用准备金%3$@ HNS。 HNS 锁定总数：%4$@ HNS。发布标志和共享固定条款；它不资助原子交换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鎖定 %1$@ HNS 為 %2$d sats。鎖定金額包含最高結算費用準備金%3$@ HNS。 HNS 鎖定總數：%4$@ HNS。發布標誌和共享固定條款；它不資助原子交換。"
          }
        }
      }
    },
