    "wallet_value_actions_catchup": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مراجعة الإجراء HNS في انتظار متابعة فحص المحفظة (%1$d من %2$d). استمر في المزامنة قبل مراجعة الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Überprüfung der HNS-Aktion wartet auf den Wallet-Scan (%1$d von %2$d). Setzen Sie die Synchronisierung fort, bevor Sie die Aktion überprüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS action review is waiting for wallet scan catch-up (%1$d of %2$d). Continue synchronization before reviewing the action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisión de la acción HNS está esperando que se ponga al día el escaneo de la billetera (%1$d de %2$d). Continúe la sincronización antes de revisar la acción."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بررسی اقدام HNS منتظر اسکن کیف پول است (%1$d از %2$d). قبل از بررسی عملکرد، همگام سازی را ادامه دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'examen des actions HNS est en attente de rattrapage de l'analyse du portefeuille (%1$d ou %2$d). Poursuivez la synchronisation avant de revoir l'action."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סקירת הפעולה של HNS ממתינה להתקפת סריקת ארנק (%1$d או %2$d). המשך בסנכרון לפני סקירת הפעולה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS एक्शन समीक्षा वॉलेट स्कैन कैच-अप (%2$d का %1$d) की प्रतीक्षा कर रही है। कार्रवाई की समीक्षा करने से पहले सिंक्रनाइज़ेशन जारी रखें."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinjauan tindakan HNS sedang menunggu pemindaian dompet (%1$d dari %2$d). Lanjutkan sinkronisasi sebelum meninjau tindakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisione dell'azione HNS è in attesa del recupero della scansione del portafoglio (%1$d di %2$d). Continua la sincronizzazione prima di rivedere l'azione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS アクション レビューは、ウォレット スキャンのキャッチアップ (%2$d の %1$d) を待っています。アクションを確認する前に同期を続行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 작업 검토가 지갑 스캔 캐치업을 기다리고 있습니다(%1$d of %2$d). 작업을 검토하기 전에 동기화를 계속하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS-actiebeoordeling wacht op inhaalactie van portemonneescan (%1$d van %2$d). Ga door met de synchronisatie voordat u de actie bekijkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przegląd akcji HNS oczekuje na nadrobienie skanu portfela (%1$d z %2$d). Kontynuuj synchronizację przed przejrzeniem działania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A revisão da ação HNS está aguardando atualização da verificação da carteira (%1$d de %2$d). Continue a sincronização antes de revisar a ação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обзор действий HNS ожидает сканирования кошелька (%1$d из %2$d). Продолжите синхронизацию, прежде чем просматривать действие."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS eylem incelemesi, cüzdan taramasının yakalanmasını bekliyor (%1$d ve %2$d). Eylemi incelemeden önce senkronizasyona devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Огляд дії HNS очікує на сканування гаманця (%1$d з %2$d). Продовжте синхронізацію перед переглядом дії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đánh giá hành động HNS đang chờ bắt kịp quá trình quét ví (%1$d của %2$d). Tiếp tục đồng bộ hóa trước khi xem lại hành động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 行动审核正在等待钱包扫描赶上（%2$d 的 %1$d）。在检查操作之前继续同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 行動審核正在等待錢包掃描趕上（%2$d 的 %1$d）。在檢查操作之前繼續同步。"
          }
        }
      }
    },
