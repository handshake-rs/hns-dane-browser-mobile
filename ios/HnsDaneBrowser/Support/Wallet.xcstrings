    "wallet_name_multiple_import_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل من 1 إلى 10000 اسم فريد من أسماء Handshake مفصولة بمسافات. لا تستخدم الفواصل أو علامات التبويب أو فواصل الأسطر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie 1–10.000 eindeutige Handshake-Namen ein, getrennt durch Leerzeichen. Verwenden Sie keine Kommas, Tabulatoren oder Zeilenumbrüche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter 1–10,000 unique Handshake names separated by spaces. Do not use commas, tabs, or line breaks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzca entre 1 y 10 000 nombres Handshake únicos separados por espacios. No utilice comas, tabulaciones ni saltos de línea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "1-10000 نام منحصربه‌فرد Handshake را که با فاصله از هم جدا شده‌اند وارد کنید. از کاما، برگه یا شکست خط استفاده نکنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez entre 1 et 10 000 noms Handshake uniques séparés par des espaces. N'utilisez pas de virgules, de tabulations ou de sauts de ligne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן 1-10,000 שמות Handshake ייחודיים מופרדים ברווחים. אל תשתמש בפסיקים, בטאבים או במעברי שורה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिक्त स्थान से अलग किए गए 1-10,000 अद्वितीय Handshake नाम दर्ज करें। अल्पविराम, टैब या लाइन ब्रेक का उपयोग न करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan 1–10.000 nama unik Handshake dengan dipisahkan spasi. Jangan gunakan koma, tab, atau jeda baris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci da 1 a 10.000 nomi Handshake univoci separati da spazi. Non utilizzare virgole, tabulazioni o interruzioni di riga."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 ～ 10,000 個の一意の Handshake 名をスペースで区切って入力します。カンマ、タブ、改行は使用しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1~10,000개의 고유한 Handshake 이름을 공백으로 구분하여 입력하세요. 쉼표, 탭 또는 줄 바꿈을 사용하지 마십시오."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer 1–10.000 unieke Handshake-namen in, gescheiden door spaties. Gebruik geen komma's, tabs of regeleinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź 1–10 000 unikalnych nazw Handshake oddzielonych spacjami. Nie używaj przecinków, tabulatorów ani podziałów wierszy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira de 1 a 10.000 nomes Handshake exclusivos separados por espaços. Não use vírgulas, tabulações ou quebras de linha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите от 1 до 10 000 уникальных имен Handshake, разделенных пробелами. Не используйте запятые, символы табуляции и разрывы строк."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boşluklarla ayırarak 1–10.000 benzersiz Handshake adı girin. Virgül, sekme veya satır sonu kullanmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть 1–10 000 унікальних імен Handshake, розділених пробілами. Не використовуйте коми, табуляції чи розриви рядків."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập 1–10.000 tên Handshake duy nhất được phân tách bằng dấu cách. Không sử dụng dấu phẩy, tab hoặc ngắt dòng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 1–10,000 个唯一的 Handshake 名称，以空格分隔。请勿使用逗号、制表符或换行符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入 1–10,000 個唯一的 Handshake 名稱，以空格分隔。請勿使用逗號、製表符或換行符號。"
          }
        }
      }
    },
