          "stringUnit": {
            "state": "translated",
            "value": "지갑을 새로 고치기 전에 %1$d 정확한 이름을 인증하고 원자적으로 가져오는 중…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De exacte namen van %1$d verifiëren en atomair importeren voordat de portemonnee wordt vernieuwd..."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwierzytelnianie i atomowe importowanie dokładnych nazw %1$d przed odświeżeniem jednego portfela…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticando e importando atomicamente os nomes exatos de %1$d antes de uma atualização da carteira…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аутентификация и атомарный импорт точных имен %1$d перед обновлением одного кошелька…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir cüzdan yenilemesinden önce %1$d adlarının doğrulanması ve atomik olarak içe aktarılması…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автентифікація та атомарне імпортування точних імен %1$d перед одним оновленням гаманця…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác thực và nhập nguyên tử tên chính xác của %1$d trước khi làm mới một ví…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在一次钱包刷新之前验证并自动导入 %1$d 确切名称......"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在一次錢包刷新之前驗證並自動導入 %1$d 確切名稱..."
          }
        }
      }
    },
    "wallet_name_bulk_import_refresh_pending": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسماء %1$d المستوردة ذريًا. إسقاط اسم جديد معلق؛ يبقى الرصيد الذي تم التحقق منه مسبقًا متاحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importierte %1$d-Namen atomar. Eine neue Namensprojektion steht noch aus; das zuvor verifizierte Guthaben bleibt verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported %1$d names atomically. A fresh name projection is pending; the previously verified balance remains available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombres %1$d importados atómicamente. Está pendiente una nueva proyección de nombre; el saldo previamente verificado permanece disponible."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام های %1$d به صورت اتمی وارد شده است. یک طرح نام جدید در انتظار است. موجودی قبلاً تأیید شده در دسترس است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noms %1$d importés de manière atomique. Une nouvelle projection de nom est en attente ; le solde préalablement vérifié reste disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Imported %1$d names atomically. A fresh name projection is pending; היתרה שאומתה בעבר נשארת זמינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परमाणु रूप से आयातित %1$d नाम। एक नये नाम का प्रक्षेपण लंबित है; पहले से सत्यापित शेष उपलब्ध रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama %1$d yang diimpor secara atom. Proyeksi nama baru sedang menunggu keputusan; saldo yang diverifikasi sebelumnya tetap tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomi %1$d importati atomicamente. È in sospeso una nuova proiezione del nome; resta disponibile il saldo precedentemente verificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d 名をアトミックにインポートしました。新しい名前の予測は保留中です。以前に確認された残高は引き続き利用可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d 이름을 원자적으로 가져왔습니다. 새로운 이름 예측이 보류 중입니다. 이전에 확인된 잔액은 계속 사용 가능합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d-namen atomair geïmporteerd. Een nieuwe naamprojectie is in behandeling; het eerder geverifieerde saldo blijft beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportowane nazwy %1$d niepodzielnie. Oczekuje na projekcję nowej nazwy; wcześniej zweryfikowane saldo pozostaje dostępne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomes %1$d importados atomicamente. Uma nova projeção de nome está pendente; o saldo previamente verificado permanece disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имена %1$d импортированы атомарно. Ожидается новый прогноз имени; ранее проверенный баланс остается доступным."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$d adları atomik olarak içe aktarıldı. Yeni bir isim projeksiyonu beklemede; önceden doğrulanan bakiye mevcut kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортовані назви %1$d атомарно. Очікується нова проекція назви; Раніше перевірений баланс залишається доступним."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã nhập tên %1$d nguyên tử. Việc chiếu tên mới đang chờ xử lý; số dư đã được xác minh trước đó vẫn có sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以原子方式导入 %1$d 名称。新名称正在等待确定；之前验证的余额仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以原子方式導入 %1$d 名稱。新名稱正在等待確定；先前驗證的餘額仍然可用。"
          }
        }
      }
    },
