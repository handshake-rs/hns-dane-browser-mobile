    "wallet_name_import_ready": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل اسم Handshake واحدًا في Unicode أو ASCII. غير مسموح بالمسافات والنقاط الزائدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie einen Handshake-Namen in Unicode oder ASCII ein. Leerzeichen und nachgestellte Punkte sind nicht zulässig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter one Handshake name in Unicode or ASCII. Spaces and trailing dots are not allowed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese un nombre Handshake en Unicode o ASCII. No se permiten espacios ni puntos finales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک نام Handshake را در Unicode یا ASCII وارد کنید. فضاها و نقاط انتهایی مجاز نیستند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez un nom Handshake dans Unicode ou ASCII. Les espaces et les points de fin ne sont pas autorisés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן שם אחד של Handshake ב-Unicode או ASCII. רווחים ונקודות נגררות אסורים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Unicode या ASCII में एक Handshake नाम दर्ज करें। रिक्त स्थान और अनुगामी बिंदुओं की अनुमति नहीं है."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan satu nama Handshake di Unicode atau ASCII. Spasi dan titik tambahan tidak diperbolehkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un nome Handshake in Unicode o ASCII. Non sono ammessi spazi e punti finali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Unicode または ASCII に Handshake 名を 1 つ入力します。スペースや末尾のドットは使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Unicode 또는 ASCII에 하나의 Handshake 이름을 입력하세요. 공백과 후행 점은 허용되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer één Handshake-naam in Unicode of ASCII in. Spaties en volgpunten zijn niet toegestaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź jedną nazwę Handshake w Unicode lub ASCII. Spacje i kropki na końcu są niedozwolone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira um nome Handshake em Unicode ou ASCII. Espaços e pontos finais não são permitidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите одно имя Handshake в Unicode или ASCII. Пробелы и конечные точки не допускаются."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Unicode veya ASCII alanına bir Handshake adı girin. Boşluklara ve sondaki noktalara izin verilmez."
          }
        },
        "uk": {
