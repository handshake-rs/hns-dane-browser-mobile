    "row_wallet_create_offer_summary": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بقفل الاسم المتعقب ونشر قائمة موثقة على لوحة المبادلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperren Sie einen verfolgten Namen und veröffentlichen Sie einen authentifizierten Eintrag im Swap Board."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
