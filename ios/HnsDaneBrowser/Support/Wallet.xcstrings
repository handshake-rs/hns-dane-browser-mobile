    "wallet_create_waiting_for_initial_sync": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التحقق من شبكة Handshake. أبقِ المحفظة مفتوحة؛ سيستمر الإنشاء تلقائيًا. يمكنك الاستعادة الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake-Netzwerk wird geprüft. Lass die Wallet geöffnet; die Erstellung wird automatisch fortgesetzt. Eine Wiederherstellung ist jetzt möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the Handshake network. Keep Wallet open; creation will continue automatically. You can restore now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobando la red Handshake. Mantén abierta la cartera; la creación continuará automáticamente. También puedes restaurar ahora."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حال بررسی شبکه Handshake. کیف پول را باز نگه دارید؛ ایجاد خودکار ادامه می‌یابد. اکنون می‌توانید بازیابی هم انجام دهید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification du réseau Handshake. Gardez le portefeuille ouvert ; la création continuera automatiquement. Vous pouvez aussi restaurer maintenant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בודק את רשת Handshake. השאירו את הארנק פתוח; היצירה תימשך אוטומטית. אפשר לשחזר כעת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake नेटवर्क जाँचा जा रहा है। वॉलेट खुला रखें; निर्माण अपने आप जारी रहेगा। आप अभी पुनर्स्थापित भी कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memeriksa jaringan Handshake. Biarkan Dompet terbuka; pembuatan akan dilanjutkan otomatis. Anda dapat memulihkan sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controllo della rete Handshake. Mantieni aperto il portafoglio; la creazione continuerà automaticamente. Puoi anche ripristinare ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshakeネットワークを確認中です。ウォレットを開いたままにしてください。作成は自動的に続行されます。今すぐ復元することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake 네트워크 확인 중입니다. 지갑을 열어 두세요. 생성이 자동으로 계속됩니다. 지금 복원할 수도 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake-netwerk controleren. Houd Wallet open; het maken gaat automatisch verder. Je kunt nu ook herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzanie sieci Handshake. Pozostaw portfel otwarty; tworzenie będzie kontynuowane automatycznie. Możesz też teraz przywrócić portfel."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A verificar a rede Handshake. Mantenha a carteira aberta; a criação continuará automaticamente. Também pode restaurar agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка сети Handshake. Оставьте кошелёк открытым; создание продолжится автоматически. Сейчас также можно восстановить кошелёк."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Handshake ağı kontrol ediliyor. Cüzdanı açık tutun; oluşturma otomatik sürecek. Şimdi geri yükleme de yapabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірка мережі Handshake. Залиште гаманець відкритим; створення продовжиться автоматично. Зараз також можна відновити гаманець."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang kiểm tra mạng Handshake. Hãy để Ví mở; quá trình tạo sẽ tự động tiếp tục. Bạn cũng có thể khôi phục ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查 Handshake 网络。请保持钱包打开；创建将自动继续。你也可以立即恢复钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在檢查 Handshake 網路。請保持錢包開啟；建立將自動繼續。你也可以立即復原錢包。"
          }
        }
      }
    },
