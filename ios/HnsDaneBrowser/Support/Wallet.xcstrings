    "wallet_recovery_quiz_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط كل كلمة بالترتيب. تظهر النتيجة بعد الاختيارات الـ24 كلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe jedes Wort der Reihe nach an. Das Ergebnis erscheint nach allen 24 Auswahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap each word in order. Results appear after all 24 choices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cada palabra en orden. El resultado aparece tras las 24 selecciones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر کلمه را به‌ترتیب بزنید. نتیجه پس از هر ۲۴ انتخاب نمایش داده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez chaque mot dans l’ordre. Le résultat apparaît après les 24 choix."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקישו על כל מילה לפי הסדר. התוצאה תוצג אחרי כל 24 הבחירות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर शब्द को क्रम से टैप करें। सभी 24 चयन के बाद परिणाम दिखाई देगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk setiap kata secara berurutan. Hasil muncul setelah semua 24 pilihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca ogni parola in ordine. Il risultato appare dopo tutte le 24 scelte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各単語を順番にタップしてください。24個すべてを選ぶと結果が表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 단어를 순서대로 누르세요. 24개를 모두 선택하면 결과가 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik elk woord in volgorde aan. Het resultaat verschijnt na alle 24 keuzes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij każdego słowa po kolei. Wynik pojawi się po wszystkich 24 wyborach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em cada palavra por ordem. O resultado aparece após as 24 escolhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажимайте каждое слово по порядку. Результат появится после всех 24 вариантов."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her kelimeye sırayla dokunun. Sonuç 24 seçimin tamamından sonra görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкайтеся кожного слова по черзі. Результат з’явиться після всіх 24 виборів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào từng từ theo thứ tự. Kết quả xuất hiện sau đủ 24 lựa chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按顺序点选每个单词。完成全部 24 次选择后显示结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依序點選每個單字。完成全部 24 次選擇後顯示結果。"
          }
        }
      }
