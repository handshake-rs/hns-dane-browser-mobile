    "wallet_reads_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة HNS غير متاحة حتى تصبح وحدة التحكم النظير التي تم التحقق منها والمملوكة للمحفظة جاهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die HNS-Synchronisierung ist erst verfügbar, wenn der verifizierte Peer-Controller im Besitz der Brieftasche bereit ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS synchronization is unavailable until the wallet-owned verified peer controller is ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización HNS no está disponible hasta que el controlador par verificado propiedad de la billetera esté listo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همگام سازی HNS تا زمانی که کنترلر همتای تأیید شده متعلق به کیف پول آماده نباشد، در دسترس نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation HNS n'est pas disponible tant que le contrôleur homologue vérifié appartenant au portefeuille n'est pas prêt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סנכרון HNS אינו זמין עד שבקר העמית המאומת בבעלות הארנק יהיה מוכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट-स्वामित्व वाले सत्यापित सहकर्मी नियंत्रक तैयार होने तक HNS सिंक्रनाइज़ेशन अनुपलब्ध है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronisasi HNS tidak tersedia hingga pengontrol rekan terverifikasi milik dompet siap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione HNS non è disponibile finché il controller peer verificato di proprietà del portafoglio non è pronto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS 同期は、ウォレットが所有する検証済みピア コントローラーの準備ができるまで利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑 소유의 검증된 피어 컨트롤러가 준비될 때까지 HNS 동기화를 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS-synchronisatie is niet beschikbaar totdat de geverifieerde peer-controller die eigendom is van de portemonnee gereed is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja HNS jest niedostępna, dopóki zweryfikowany kontroler równorzędny należący do portfela nie będzie gotowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização HNS não estará disponível até que o controlador de peer verificado de propriedade da carteira esteja pronto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация HNS недоступна до тех пор, пока не будет готов проверенный одноранговый контроллер, принадлежащий кошельку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HNS senkronizasyonu, cüzdanın sahibi olduğu doğrulanmış eş denetleyici hazır olana kadar kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронізація HNS недоступна, доки перевірений одноранговий контролер гаманця не буде готовий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đồng bộ hóa HNS không khả dụng cho đến khi bộ điều khiển ngang hàng được xác minh thuộc sở hữu của ví sẵn sàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在钱包拥有的已验证对等控制器准备就绪之前，HNS 同步不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在錢包擁有的已驗證對等控制器準備就緒之前，HNS 同步不可用。"
          }
        }
      }
    },
    "wallet_reads_waiting_for_wallet": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح وافتح محفظة محلية مؤكدة لفحص قراءات HNS المتزامنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen und entsperren Sie eine bestätigte lokale Wallet, um synchronisierte HNS-Lesevorgänge zu überprüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open and unlock a confirmed local wallet to inspect synchronized HNS reads."
          }
        },
        "es": {
