            "state": "translated",
            "value": "Введіть висоту цілого блоку від 1 до 2147483647."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập chiều cao toàn bộ khối từ 1 đến 2147483647."
