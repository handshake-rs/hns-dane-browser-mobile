            "state": "translated",
            "value": "1부터 2147483647까지의 전체 블록 높이를 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een hele blokhoogte in, van 1 tot en met 2147483647."
          }
        },
        "pl": {
