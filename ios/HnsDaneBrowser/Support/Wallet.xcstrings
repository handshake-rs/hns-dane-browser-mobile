          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận mật khẩu, mã PIN hoặc mẫu thiết bị của bạn trước khi chuẩn bị phê duyệt giao dịch này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
