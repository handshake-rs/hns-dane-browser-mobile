          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở khóa ví để lưu trữ hoặc ghép nối một trao đổi ngang hàng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
