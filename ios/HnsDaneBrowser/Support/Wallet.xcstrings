    "wallet_swap_prepare_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم إعداد القائمة. يجب أن يغطي BTC المؤكد القوائم النشطة وهذا المبلغ المقفل بالكامل، والذي يتضمن احتياطي الرسوم الخاص به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auflistung wurde nicht erstellt. Der bestätigte BTC muss aktive Einträge und diesen gesamten gesperrten Betrag einschließlich der Gebührenreserve abdecken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The listing was not prepared. Confirmed BTC must cover active listings and this complete locked amount, which includes its fee reserve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El listado no fue preparado. El BTC confirmado debe cubrir los listados activos y este monto bloqueado completo, que incluye su reserva de tarifas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فهرست آماده نشده بود. BTC تایید شده باید لیست های فعال و این مبلغ قفل شده کامل را پوشش دهد که شامل ذخیره هزینه آن می شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le listing n'a pas été préparé. Le BTC confirmé doit couvrir les annonces actives et ce montant bloqué complet, qui comprend sa réserve de frais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הרישום לא הוכן. המאושר BTC חייב לכסות את הרישומים הפעילים ואת הסכום הנעול המלא הזה, הכולל את עתודת העמלות שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सूची तैयार नहीं की गई थी। पुष्टि किए गए BTC में सक्रिय लिस्टिंग और यह पूर्ण लॉक की गई राशि शामिल होनी चाहिए, जिसमें इसका शुल्क आरक्षित भी शामिल है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftarnya belum disiapkan. BTC yang dikonfirmasi harus mencakup listing aktif dan jumlah terkunci lengkap ini, termasuk cadangan biayanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco non è stato preparato. BTC confermato deve coprire le inserzioni attive e l'intero importo bloccato, che include la riserva di commissione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストは準備されていませんでした。確認済みの BTC は、アクティブなリストと、その手数料準備金を含むこの完全なロックされた金額をカバーする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록이 준비되지 않았습니다. 확인된 BTC는 활성 목록과 수수료 예비금을 포함하여 전체 잠긴 금액을 포함해야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lijst is niet opgesteld. Bevestigd dat BTC actieve vermeldingen en dit volledige vergrendelde bedrag moet dekken, inclusief de kostenreservering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista nie została przygotowana. Potwierdzony BTC musi obejmować aktywne aukcje i całą zablokowaną kwotę, która obejmuje rezerwę na opłaty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A listagem não foi preparada. O BTC confirmado deve cobrir as listagens ativas e todo esse valor bloqueado, que inclui sua reserva de taxa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Листинг не был подготовлен. Подтвержденный BTC должен покрывать активные листинги и всю заблокированную сумму, включая резерв комиссии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste hazırlanmadı. Onaylandı BTC, aktif listelemeleri ve ücret rezervi de dahil olmak üzere bu kilitli tutarın tamamını kapsamalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Список не був підготовлений. Підтверджений BTC має покривати активні списки та цю повну заблоковану суму, яка включає резерв комісії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh sách đã không được chuẩn bị. BTC đã được xác nhận phải bao gồm các danh sách đang hoạt động và toàn bộ số tiền bị khóa này, bao gồm cả dự trữ phí của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清单尚未准备好。已确认的 BTC 必须涵盖活跃列表和完整的锁定金额，其中包括其费用储备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清單尚未準備好。已確認的 BTC 必須涵蓋活躍清單和完整的鎖定金額，其中包括其費用儲備。"
          }
        }
      }
    },
