    "wallet_bitcoin_send_fee_cap_too_low": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسوم النظير المباشر الحالية أعلى من الحد الأقصى للرسوم. قم بزيادة سقف الرسوم ومراجعة المعاملة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Direct-Peer-Gebühr liegt über Ihrer Höchstgebühr. Erhöhen Sie die Gebührenobergrenze und überprüfen Sie die Transaktion erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current direct-peer fee is above your maximum fee. Increase the fee cap and review the transaction again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La tarifa actual de pares directos está por encima de su tarifa máxima. Aumente el límite de la tarifa y revise la transacción nuevamente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کارمزد همتا مستقیم فعلی بالاتر از حداکثر کارمزد شما است. سقف کارمزد را افزایش دهید و دوباره تراکنش را بررسی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les frais actuels de peering direct sont supérieurs à vos frais maximum. Augmentez le plafond des frais et réexaminez la transaction."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עמלת העמיתים הישירה הנוכחית היא מעל העמלה המקסימלית שלך. הגדל את תקרת העמלה ובדוק שוב את העסקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान डायरेक्ट-पीयर शुल्क आपके अधिकतम शुल्क से अधिक है। शुल्क सीमा बढ़ाएँ और लेन-देन की दोबारा समीक्षा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biaya rekan langsung saat ini berada di atas biaya maksimum Anda. Tingkatkan batas biaya dan tinjau kembali transaksi tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'attuale tariffa del peer diretto è superiore alla tariffa massima. Aumenta il limite tariffario e rivedi nuovamente la transazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のダイレクトピア料金は最大料金を超えています。手数料上限を引き上げて、トランザクションを再度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 직접 피어 수수료가 최대 수수료보다 높습니다. 수수료 한도를 높이고 거래를 다시 검토하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De huidige directe peer-vergoeding ligt boven uw maximale vergoeding. Verhoog de vergoedingslimiet en controleer de transactie opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obecna opłata za bezpośrednie połączenie jest wyższa niż Twoja opłata maksymalna. Zwiększ górny limit opłat i ponownie przejrzyj transakcję."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A taxa atual de peer direto está acima da taxa máxima. Aumente o limite da taxa e revise a transação novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая плата за прямую одноранговую связь превышает максимальную плату. Увеличьте максимальный размер комиссии и еще раз проверьте транзакцию."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut doğrudan eş ücreti maksimum ücretinizin üzerindedir. Ücret tavanını artırın ve işlemi tekrar inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поточна плата за прямий одноранговий зв’язок перевищує вашу максимальну плату. Збільште ліміт комісії та перегляньте транзакцію ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phí ngang hàng trực tiếp hiện tại cao hơn mức phí tối đa của bạn. Tăng giới hạn phí và xem lại giao dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前的直接同行费用高于您的最高费用。提高费用上限并再次审核交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前的直接同業費用高於您的最高費用。提高費用上限並再次審核交易。"
          }
        }
      }
    },
