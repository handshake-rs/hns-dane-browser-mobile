    "wallet_send_broadcast_ambiguous": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نتيجة البث غير معروفة وتم قفل المحفظة. المزامنة قبل إعادة المحاولة؛ قد تكون الصفقة قد تم نشرها بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Übertragungsergebnis ist unbekannt und die Brieftasche wurde gesperrt. Vor dem erneuten Versuch synchronisieren; Möglicherweise ist die Transaktion bereits veröffentlicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The broadcast result is unknown and the wallet was locked. Synchronize before retrying; the transaction may already be published."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se desconoce el resultado de la transmisión y la billetera fue bloqueada. Sincronice antes de volver a intentarlo; Es posible que la transacción ya esté publicada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نتیجه پخش مشخص نیست و کیف پول قفل شده است. قبل از تلاش مجدد، همگام سازی کنید. ممکن است تراکنش قبلاً منتشر شده باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la diffusion est inconnu et le portefeuille était verrouillé. Synchronisez avant de réessayer ; la transaction peut déjà être publiée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוצאת השידור אינה ידועה והארנק היה נעול. סנכרן לפני ניסיון חוזר; ייתכן שהעסקה כבר פורסמה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रसारण परिणाम अज्ञात है और वॉलेट लॉक कर दिया गया था। पुनः प्रयास करने से पहले सिंक्रनाइज़ करें; लेन-देन पहले ही प्रकाशित हो सकता है."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil siaran tidak diketahui dan dompet terkunci. Sinkronkan sebelum mencoba lagi; transaksi mungkin sudah dipublikasikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risultato della trasmissione è sconosciuto e il portafoglio era bloccato. Sincronizza prima di riprovare; la transazione potrebbe essere già pubblicata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロードキャスト結果は不明で、ウォレットはロックされていました。再試行する前に同期してください。トランザクションはすでに公開されている可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방송 결과는 알 수 없으며 지갑이 잠겨 있습니다. 다시 시도하기 전에 동기화하십시오. 거래가 이미 게시되었을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het uitzendresultaat is onbekend en de portemonnee is vergrendeld. Synchroniseer voordat u het opnieuw probeert; de transactie is mogelijk al gepubliceerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik transmisji jest nieznany, a portfel został zablokowany. Zsynchronizuj przed ponowną próbą; transakcja może być już opublikowana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado da transmissão é desconhecido e a carteira foi bloqueada. Sincronize antes de tentar novamente; a transação já pode estar publicada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат трансляции неизвестен, а кошелек заблокирован. Синхронизируйте перед повторной попыткой; транзакция может быть уже опубликована."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın sonucu bilinmiyor ve cüzdan kilitlendi. Yeniden denemeden önce senkronize edin; işlem zaten yayınlanmış olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат трансляції невідомий, а гаманець заблоковано. Синхронізувати перед повторною спробою; трансакція може бути вже опублікована."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả phát sóng không xác định và ví đã bị khóa. Đồng bộ hóa trước khi thử lại; giao dịch có thể đã được công bố."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广播结果未知，钱包被锁定。重试前同步；该交易可能已经发布。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "廣播結果未知，錢包被鎖定。重試前同步；該交易可能已經發布。"
          }
        }
      }
    },
    "wallet_send_broadcasting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بث المعاملة المعتمدة بالضبط من خلال مجموعة النظراء المملوكة للمحفظة..."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragen der genauen genehmigten Transaktion über das Wallet-eigene Peer-Set …"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broadcasting the exact approved transaction through the wallet-owned peer set…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmitir la transacción aprobada exacta a través del conjunto de pares propiedad de la billetera..."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پخش تراکنش تایید شده دقیق از طریق مجموعه همتا متعلق به کیف پول…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diffusion de la transaction approuvée exacte via l'ensemble de pairs appartenant au portefeuille…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משדר את העסקה שאושרה במדויק דרך ערכת העמיתים שבבעלות הארנק..."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट-स्वामित्व वाले सहकर्मी सेट के माध्यम से सटीक स्वीकृत लेनदेन का प्रसारण…"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyiarkan transaksi yang disetujui secara tepat melalui kumpulan rekan milik dompet…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasmissione dell'esatta transazione approvata attraverso il peer set di proprietà del portafoglio..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットが所有するピアセットを通じて、正確に承認されたトランザクションをブロードキャストします…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑 소유 피어셋을 통해 승인된 정확한 거래를 브로드캐스팅…"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het uitzenden van de exact goedgekeurde transactie via de peer-set die eigendom is van de portemonnee..."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozgłaszanie dokładnie zatwierdzonej transakcji za pośrednictwem zestawu równorzędnego należącego do portfela…"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmitindo a transação exata aprovada através do conjunto de pares de propriedade da carteira…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансляция точной одобренной транзакции через набор узлов, принадлежащих кошельку…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylanan işlemin tam olarak cüzdanın sahip olduğu eş kümesi aracılığıyla yayınlanması…"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Трансляція точної схваленої транзакції через набір однорангових пристроїв гаманця…"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truyền phát giao dịch được phê duyệt chính xác thông qua nhóm ngang hàng thuộc sở hữu của ví…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过钱包拥有的对等集广播确切批准的交易......"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過錢包擁有的對等集廣播確切批准的交易..."
          }
        }
      }
    },
    "wallet_send_catchup_before_review": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسح المحفظة: كتلة %1$d من %2$d. قم بإنهاء المزامنة قبل مراجعة هذا الإرسال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet-Scan: %1$d von %2$d blockieren. Schließen Sie die Synchronisierung ab, bevor Sie diesen Versand überprüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet scan: block %1$d of %2$d. Finish synchronization before reviewing this send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escaneo de billetera: bloque %1$d de %2$d. Finalice la sincronización antes de revisar este envío."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اسکن کیف پول: بلوک %1$d از %2$d. قبل از بررسی این ارسال، همگام سازی را تمام کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse du portefeuille : bloquez %1$d ou %2$d. Terminez la synchronisation avant de consulter cet envoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סריקת ארנק: חסום %1$d של %2$d. סיים את הסנכרון לפני בדיקת השליחה הזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट स्कैन: %2$d में से %1$d को ब्लॉक करें। इस प्रेषण की समीक्षा करने से पहले सिंक्रनाइज़ेशन समाप्त करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemindaian dompet: blokir %1$d dari %2$d. Selesaikan sinkronisasi sebelum meninjau pengiriman ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansione portafoglio: blocca %1$d di %2$d. Termina la sincronizzazione prima di rivedere questo invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレット スキャン: %1$d または %2$d をブロックします。この送信を確認する前に、同期を終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑 스캔: %2$d의 %1$d를 차단합니다. 이 전송을 검토하기 전에 동기화를 완료하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portemonneescan: blokkeer %1$d van %2$d. Voltooi de synchronisatie voordat u deze verzending bekijkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skan portfela: blok %1$d z %2$d. Zakończ synchronizację przed przejrzeniem tej wysyłki."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificação de carteira: bloquear %1$d de %2$d. Conclua a sincronização antes de revisar este envio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирование кошелька: заблокируйте %1$d %2$d. Завершите синхронизацию, прежде чем просматривать эту отправку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdan taraması: %2$d'nin %1$d'sini engelleyin. Bu gönderimi incelemeden önce senkronizasyonu tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканування гаманця: блок %1$d з %2$d. Завершіть синхронізацію перед переглядом цього відправлення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét ví: chặn %1$d của %2$d. Hoàn tất đồng bộ hóa trước khi xem lại lần gửi này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱包扫描：区块%2$d的%1$d。在查看此发送之前完成同步。"
          }
        },
        "zh-Hant": {
