          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja jest w toku. Wysyłanie odblokowuje się po zakończeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização está em andamento. Envio de desbloqueios quando terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация идет. Отправка разблокируется после завершения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senkronizasyon sürüyor. Gönderme işlemi bittiğinde kilit açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Триває синхронізація. Надсилання розблоковується після завершення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá trình đồng bộ hóa đang được tiến hành. Gửi mở khóa khi nó kết thúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步正在进行中。发送完成后解锁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步正在進行中。發送完成後解鎖。"
          }
