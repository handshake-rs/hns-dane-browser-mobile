            "value": "لا يمكن إعداد قبول العرض. تحقق من النظير المتصل والرصيد المتزامن واحتياطي الرسوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Angebotsannahme konnte nicht vorbereitet werden. Überprüfen Sie den verbundenen Peer, den synchronisierten Kontostand und die Gebührenreserve."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The offer acceptance could not be prepared. Check the connected peer, synchronized balance, and fee reserve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo preparar la aceptación de la oferta. Verifique el par conectado, el saldo sincronizado y la reserva de tarifas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پذیرش پیشنهاد آماده نشد. همتا متصل، موجودی همگام، و ذخیره هزینه را بررسی کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'acceptation de l'offre n'a pas pu être préparée. Vérifiez le pair connecté, le solde synchronisé et la réserve de frais."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להכין את קבלת ההצעה. בדוק את העמית המחוברת, היתרה המסונכרנת ועתודות העמלות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रस्ताव स्वीकृति तैयार नहीं हो सकी। कनेक्टेड पीयर, सिंक्रोनाइज्ड बैलेंस और शुल्क रिजर्व की जांच करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penerimaan tawaran tidak dapat disiapkan. Periksa rekan yang terhubung, saldo tersinkronisasi, dan cadangan biaya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile preparare l'accettazione dell'offerta. Controlla il peer connesso, il saldo sincronizzato e la riserva tariffaria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オファー承諾を準備できませんでした。接続相手、同期残高、料金リザーブを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안 수락을 준비할 수 없습니다. 연결된 Peer, 동기화 잔액, 수수료 보유량을 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De aanvaarding van het bod kon niet worden voorbereid. Controleer de verbonden peer, het gesynchroniseerde saldo en de kostenreservering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można było przygotować akceptacji oferty. Sprawdź podłączonego partnera, zsynchronizowane saldo i rezerwę opłat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A aceitação da oferta não pôde ser preparada. Verifique o peer conectado, o saldo sincronizado e a reserva de taxas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Акцепт оферты подготовить не удалось. Проверьте подключенного узла, синхронизированный баланс и резерв комиссии."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teklif kabulü hazırlanamadı. Bağlı eşleri, senkronize bakiyeyi ve ücret rezervini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося підготувати акцепт пропозиції. Перевірте підключений вузол, синхронізований баланс і резерв комісії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc chấp nhận lời đề nghị không thể được chuẩn bị. Kiểm tra ngang hàng được kết nối, số dư được đồng bộ hóa và dự trữ phí."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备要约接受。检查连接的对等点、同步余额和费用储备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法準備要約接受。檢查連接的對等點、同步餘額和費用儲備。"
          }
        }
      }
    },
