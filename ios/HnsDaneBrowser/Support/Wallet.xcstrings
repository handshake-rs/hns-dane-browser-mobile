        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kandidat titik akhir publik dan layanan NETWORK terverifikasi sudah siap; menghubungkan kembali rekan-rekan saham HSD untuk publikasi ADDR. Kandidat penemuan %1$d."
