        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजें अस्वीकृत. कोई लेन-देन प्रसारित नहीं किया गया."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
